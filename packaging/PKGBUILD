# Maintainer: Ayaz Rashid <rashid.ayaz@gmail.com>
#
# Calliope — local-first voice dictation server for SillyTavern.
#
# Repo layout (post-extract):
#   repo-root/
#     LICENSE
#     README.md
#     PRIVACY.md
#     THIRD_PARTY_NOTICES.md
#     server/calliope-server          (executable wrapper / composition root)
#     server/calliope_server/         (the importable runtime package)
#     server/voice_catalog.json       (TTS voice suggestion catalog)
#     scripts/learn-vocab, scripts/kokoro-server.py
#     systemd/*.service, systemd/*.timer
#     docs/*.md
#
# Installed layout. The wrapper resolves its package "alongside itself"
# (server/calliope-server bootstrap, search order step 1) after resolving
# symlinks, and tts.py reads voice_catalog.json one level above the package:
#   /usr/lib/calliope/calliope-server
#   /usr/lib/calliope/calliope_server/
#   /usr/lib/calliope/voice_catalog.json
#   /usr/lib/calliope/learn-vocab
#   /usr/lib/calliope/units/           (what `dictation-server --setup` copies)
#   /usr/lib/systemd/user/             (same units, usable without --setup)
#   /usr/share/calliope/kokoro-server.py
# The whisper unit expects /usr/bin/whisper-server (whisper.cpp package); the
# Kokoro unit still runs the user-created venv from docs/tts-install.md.
#
# Backward-compat: pkgname renamed to calliope-git. The old `dictation-server`
# namespace is kept via provides/conflicts so existing AUR users on the old
# name get a clean upgrade path.
#
# TODO: confirm GitHub username/org before publishing the AUR submission.

pkgname=calliope-git
_pkgname=calliope
pkgver=0.1.0.r0.g0000000  # placeholder; pkgver() regenerates from git
pkgrel=1
pkgdesc="Local-first voice dictation server for SillyTavern (Calliope)"
arch=('any')
url="https://github.com/ar221/calliope"  # TODO: confirm GitHub username/org
license=('MIT')
depends=(
  'python>=3.10'
  'whisper.cpp'
  'ffmpeg'
  'pipewire'
  'wtype'
  'wl-clipboard'
)
optdepends=(
  'rocm-hip-runtime: GPU acceleration on AMD'
  'cuda: GPU acceleration on NVIDIA'
  'qrencode: phone pairing QR code in --setup wizard'
  'tailscale: zero-friction LAN HTTPS via tailscale-cert'
  'mkcert: local-CA cert path'
  'python-yaml: YAML config support'
  'python-wordfreq: improved vocab fuzzy collision detection'
)
makedepends=('git')
provides=("${_pkgname}" "dictation-server")
conflicts=("${_pkgname}" "dictation-server")
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  printf "%s.r%s.g%s" \
    "$(git describe --tags --abbrev=0 2>/dev/null || echo 0.1.0)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

package() {
  cd "$srcdir/$_pkgname"

  local lib="$pkgdir/usr/lib/calliope"
  install -Dm755 "server/calliope-server" "$lib/calliope-server"
  install -dm755 "$lib/calliope_server"
  local mod
  for mod in server/calliope_server/*.py; do
    install -Dm644 "$mod" "$lib/calliope_server/$(basename "$mod")"
  done
  install -Dm644 "server/voice_catalog.json" "$lib/voice_catalog.json"
  install -Dm755 "scripts/learn-vocab" "$lib/learn-vocab"
  install -Dm644 "scripts/kokoro-server.py" "$pkgdir/usr/share/calliope/kokoro-server.py"
  install -dm755 "$pkgdir/usr/bin"
  ln -s ../lib/calliope/calliope-server "$pkgdir/usr/bin/calliope-server"
  ln -s ../lib/calliope/calliope-server "$pkgdir/usr/bin/dictation-server"

  # systemd user units. Names retained (dictation-server / whisper-server) for
  # backward compat with existing user installs. Rewrite the user-local paths
  # the repo units use to the packaged locations, then install the same files
  # as the --setup source (units/) and in the systemd user search path.
  local units="$srcdir/units"
  rm -rf "$units"
  install -dm755 "$units"
  cp systemd/*.service systemd/*.timer "$units/"
  sed -i 's#^ExecStart=.*#ExecStart=/usr/bin/calliope-server#' \
    "$units/dictation-server.service"
  sed -i 's#%h/\.local/bin/whisper-server#/usr/bin/whisper-server#' \
    "$units/whisper-server.service"
  sed -i 's# %h/\.local/share/calliope-tts/kokoro-server\.py# /usr/share/calliope/kokoro-server.py#' \
    "$units/kokoro-server.service"
  sed -i \
    -e 's#^Documentation=.*#Documentation=https://github.com/ar221/calliope#' \
    -e 's#^WorkingDirectory=.*#WorkingDirectory=%h#' \
    -e 's#^ExecStart=.*#ExecStart=/usr/lib/calliope/learn-vocab --min-freq 10 --cap 8 --apply --merge-characters --quiet#' \
    -e 's#%h/Github/calliope#/usr/lib/calliope#g' \
    "$units/learn-vocab-nightly.service"
  local unit
  for unit in "$units"/*; do
    install -Dm644 "$unit" "$lib/units/$(basename "$unit")"
    install -Dm644 "$unit" "$pkgdir/usr/lib/systemd/user/$(basename "$unit")"
  done

  # Licensing.
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"

  # Top-level docs.
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "PRIVACY.md" "$pkgdir/usr/share/doc/$pkgname/PRIVACY.md"

  # Doc bundle. nullglob so an empty docs/ directory doesn't expand to the
  # literal pattern and break the build.
  shopt -s nullglob
  for doc in docs/*.md; do
    install -Dm644 "$doc" "$pkgdir/usr/share/doc/$pkgname/$(basename "$doc")"
  done
  shopt -u nullglob
}
