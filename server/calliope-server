class _TLSThreadingHTTPServer(http.server.ThreadingHTTPServer):
    """ThreadingHTTPServer that wraps each accepted socket in TLS *without*
    handshaking on the accept thread.

    `ssl_context.wrap_socket(listening_socket)` makes `accept()` perform the
    handshake inline, so one client that connects and sends nothing blocks
    every other connection. Here the accepted socket is wrapped with
    `do_handshake_on_connect=False`; the handler finishes the handshake in
    its own thread under a socket timeout (`DictationHandler.setup`).

    Admission (SEC-03): at most `config.MAX_HANDLER_THREADS` handler threads
    run at once. An SSE stream hands its slot back once subscribed (SSE has
    its own cap, `config.MAX_SSE_SUBSCRIBERS`). Over the cap the connection
    is refused on the accept thread without spawning a handler: plain HTTP
    gets a best-effort 503, TLS is closed (no handshake is spent on it).
    """
    ssl_context: "ssl.SSLContext | None" = None
    daemon_threads = True

    def __init__(self, *args, **kwargs):
        self._slots = threading.BoundedSemaphore(max(1, config.MAX_HANDLER_THREADS))
        self._held: set[int] = set()
        self._held_lock = threading.Lock()
        super().__init__(*args, **kwargs)

    def get_request(self):
        sock, addr = self.socket.accept()
        if self.ssl_context is not None:
            sock = self.ssl_context.wrap_socket(
                sock, server_side=True, do_handshake_on_connect=False,
            )
        return sock, addr

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            log.warning("Connection cap (%d) reached; refusing %s",
                        config.MAX_HANDLER_THREADS, client_address[0])
            if not isinstance(request, ssl.SSLSocket):
                try:
                    request.settimeout(0)
                    request.send(b"HTTP/1.1 503 Service Unavailable\r\n"
                                 b"Content-Length: 0\r\nConnection: close\r\n"
                                 b"Retry-After: 1\r\n\r\n")
                except OSError:
                    pass
            self.shutdown_request(request)
            return
        with self._held_lock:
            self._held.add(id(request))
        try:
            super().process_request(request, client_address)
        except Exception:
            self.release_slot(request)
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self.release_slot(request)

    def release_slot(self, request) -> None:
        """Return `request`'s handler slot (idempotent)."""
        with self._held_lock:
            if id(request) not in self._held:
                return
            self._held.discard(id(request))
        self._slots.release()


class DictationHandler(http.server.BaseHTTPRequestHandler):
    # Per-connection socket timeout. Bounds the TLS handshake, request-line
    # and header reads, and each body/response chunk; SSE keepalives and
    # audio uploads complete well inside it.
    timeout = CONNECTION_TIMEOUT_SECONDS

    def setup(self):
        super().setup()  # applies `timeout` to the connection
        self._tls_failed = False
        if isinstance(self.request, ssl.SSLSocket):
            try:
                self.request.do_handshake()
            except (ssl.SSLError, OSError) as e:
                # Port scanners, plain-HTTP probes and browsers that gave up
                # all land here; not worth more than a debug line.
                log.debug("TLS handshake failed from %s: %s", self.client_address, e)
                self._tls_failed = True

    def handle(self):
        if self._tls_failed:
            return
        super().handle()

    def log_message(self, fmt, *args):
        log.info(_redact_sensitive_url_params(fmt % args))

    def log_error(self, fmt, *args):
        # Idle keep-alive sockets hit the connection timeout routinely and
        # 404s from probes are noise; neither belongs in the INFO journal.
        log.debug(_redact_sensitive_url_params(fmt % args))

    def handle_one_request(self):
        """Override to demote the benign mobile-browser TLS EOF spam.

        Mobile browsers (Samsung Internet, Chrome Android) close TCP
        sockets without sending a TLS close_notify when the tab
        backgrounds or the screen locks during /events SSE. RFC 8446
        §6.1 makes close_notify optional, but Python's _ssl.c raises
        UNEXPECTED_EOF_WHILE_READING regardless. Agent 5 §6 / ADR-18.
        """
        try:
            super().handle_one_request()
        except ssl.SSLError as e:
            if "UNEXPECTED_EOF_WHILE_READING" in str(e):
                log.debug(
                    "Client closed without TLS close_notify (benign): %s",
                    self.client_address,
                )
                return
            raise
        except (BrokenPipeError, ConnectionResetError) as e:
            log.debug(
                "Client disconnected before response completed (benign): %s (%s)",
                self.client_address,
                e.__class__.__name__,
            )
            return

    def _client_addr(self) -> str:
        try:
            return self.client_address[0]
        except Exception:
            return ""

    def request_context(self) -> str:
        """Client-supplied chat context from the `X-Dictation-Context` header.

        Percent-encoded UTF-8 so arbitrary chat text survives the header
        charset. Header, not query string: request lines are journaled and
        must never carry private chat text.
        """
        raw = self.headers.get("X-Dictation-Context", "")
        if not raw:
            return ""
        return clamp_request_context(urllib.parse.unquote(raw))

    def _set_cors_origin(self) -> None:
        """Echo the request Origin if it's in the allowlist; otherwise no header."""
        origin = self.headers.get("Origin", "")
        if CORS_ALLOW_WILDCARD:
            self.send_header("Access-Control-Allow-Origin", "*")
            return
        if _origin_allowed(origin):
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Vary", "Origin")

    def _loopback_trusted(self) -> bool:
        """Loopback bypass, denied to browser requests from foreign origins.

        A page on any site open in the desktop browser can reach 127.0.0.1
        too, and the browser attaches its `Origin`. Local tools (curl, the
        wizard) send no Origin. So: loopback without Origin, or with an
        allowlisted one, is trusted; loopback with a non-allowlisted Origin
        (including `null`) must authenticate like a remote client.
        """
        if not _is_loopback_address(self._client_addr()):
            return False
        origin = self.headers.get("Origin", "")
        if origin and not _origin_allowed(origin):
            return False
        return True

    def _request_is_privileged(self) -> bool:
        """Loopback client OR request carrying a valid bearer/query token.

        Used to gate the *content* of the auth-exempt endpoints (`/`,
        `/health`): they stay reachable for the pairing bootstrap, but
        non-loopback callers without the token only get minimal responses.
        """
        if self._loopback_trusted():
            return True
        tok = get_token()
        auth = self.headers.get("Authorization", "")
        if auth.startswith("Bearer "):
            presented = auth[len("Bearer "):].strip()
            if _token_matches(presented, tok):
                return True
        parsed = urllib.parse.urlparse(self.path)
        qtok = urllib.parse.parse_qs(parsed.query).get("token", [""])[0]
        if _token_matches(qtok, tok):
            return True
        return False

    def _request_bearer_token(self) -> str:
        """Return the durable bearer only when explicitly header-authenticated."""
        auth = self.headers.get("Authorization", "")
        if not auth.startswith("Bearer "):
            return ""
        presented = auth[len("Bearer "):].strip()
        token = get_token()
        return token if _token_matches(presented, token) else ""

    def require_auth(self) -> bool:
        """Gate every request unless loopback or exempt endpoint.

        Returns True if the request may proceed; on False the handler must
        stop (response already sent).
        """
        # Loopback bypass (refused for browser requests from foreign origins)
        if self._loopback_trusted():
            return True
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        # Exempt endpoints
        if path in _AUTH_EXEMPT_PATHS or _is_icon_path(path):
            return True
        # OPTIONS preflight handled separately (no auth needed for CORS probes)
        if self.command == "OPTIONS":
            return True
        # SSE (/events) accepts ?token=<token> because browser EventSource
        # cannot set headers. Phone bootstrap URLs use a separate short-lived
        # code and never carry this durable bearer.
        if path == "/events":
            qs = urllib.parse.parse_qs(parsed.query)
            qtok = qs.get("token", [""])[0]
            if _token_matches(qtok, get_token()):
                return True
            self._send_unauthorized("token required (query param)")
            return False
        # Bearer header
        auth = self.headers.get("Authorization", "")
        if auth.startswith("Bearer "):
            presented = auth[len("Bearer "):].strip()
            if _token_matches(presented, get_token()):
                return True
        self._send_unauthorized("bearer token required")
        return False

    def _send_unauthorized(self, reason: str) -> None:
        body = json.dumps({"error": reason, "code": "unauthorized"}).encode()
        self.send_response(401)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("WWW-Authenticate", "Bearer")
        self._set_cors_origin()
        self.end_headers()
        try:
            self.wfile.write(body)
        except Exception:
            pass

    def send_response(self, code, message=None):
        self._response_started = True
        super().send_response(code, message)

    def _guarded(self, dispatch) -> None:
        """Run a route dispatcher; an unexpected exception becomes a JSON 500.

        If the failure happens after the response began, the connection is
        closed instead of appending a second response.
        """
        self._response_started = False
        try:
            dispatch()
        except (BrokenPipeError, ConnectionResetError, ssl.SSLError):
            raise
        except Exception as e:
            log.exception("Unhandled error on %s %s", self.command,
                          urllib.parse.urlparse(self.path).path)
            if getattr(self, "_response_started", False):
                self.close_connection = True
                return
            self.send_error_json(f"Server error: {e.__class__.__name__}",
                                 code="server_error", status=500, retry_ok=True)

    def send_json(self, data: dict, status: int = 200):
        body = json.dumps(data).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        # API payloads (tokens, pairing codes, transcripts) are never cacheable.
        self.send_header("Cache-Control", "no-store")
        self._set_cors_origin()
        self.end_headers()
        self.wfile.write(body)

    def _emit_dictation_state(self, request_id: str, state: str,
                              **details) -> None:
        """MVP-16 — best-effort `dictation-state` SSE broadcast. No-op when
        request_id is empty (e.g. caller ran the pipeline without correlation).
        """
        if not request_id:
            return
        payload = {"requestId": request_id, "state": state, "ts": time.time()}
        if details:
            payload["details"] = details
        try:
            broadcast_event("dictation-state", payload)
        except Exception:
            pass

    def _emit_dictation_transcript(self, request_id: str, phase: str, text: str,
                                   **details) -> None:
        """Best-effort transcript-progress SSE event.

        Whisper Flow's useful pattern is the partial/final event contract, not
        its model loop. For POL-17 privacy, this event deliberately omits raw
        ASR text and only reports that a transcript phase exists; the HTTP
        response remains the phone-local review surface.
        """
        if not request_id or not text:
            return
        payload = {
            "requestId": request_id,
            "phase": phase,
            "has_text": True,
            "source": "whisper",
            "ts": time.time(),
        }
        if details:
            payload.update(details)
        try:
            broadcast_event("dictation-transcript", payload)
        except Exception:
            pass

    def _send_ui_security_headers(self) -> None:
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy", _frame_ancestors_csp())

    def send_html(self, html: str, *, static: bool = False):
        """Serve an HTML document with the UI security headers.

        `static=True` marks the unmodified phone shell: it is revalidated by
        ETag (304 on match) and gzipped when accepted, both precomputed once
        per process. Everything else (pairing/bootstrap, per-request embed
        config) is `no-store` and sent uncompressed.
        """
        if not static:
            body = html.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self._send_ui_security_headers()
            self.end_headers()
            self.wfile.write(body)
            return
        raw, gz, etag = _static_html_variant(html)
        inm = self.headers.get("If-None-Match", "") or ""
        if etag in [t.strip().removeprefix("W/") for t in inm.split(",")]:
            self.send_response(304)
            self.send_header("ETag", etag)
            self.send_header("Cache-Control", "private, no-cache")
            self.send_header("Vary", "Accept-Encoding")
            self.end_headers()
            return
        use_gzip = _accepts_gzip(self.headers.get("Accept-Encoding", ""))
        body = gz if use_gzip else raw
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        if use_gzip:
            self.send_header("Content-Encoding", "gzip")
        self.send_header("ETag", etag)
        self.send_header("Cache-Control", "private, no-cache")
        self.send_header("Vary", "Accept-Encoding")
        self._send_ui_security_headers()
        self.end_headers()
        self.wfile.write(body)

    # Seconds between `event: ping` frames on an SSE stream (contract: 15 s).
    sse_ping_interval = 15.0

    def _handle_sse_stream(self):
        """Phase 2 — SSE stream at GET /events.

        Writes event-stream headers, then blocks reading from our dedicated
        subscriber queue. Every `sse_ping_interval` seconds a comment
        heartbeat plus a named `event: ping` ({"ts": epoch}) frame is sent so
        clients can detect a dead stream. Exits cleanly on any socket error.
        Over the subscriber cap the request gets a 503 JSON error.
        """
        sub = subscribe_events()
        if sub is None:
            self.send_error_json("Too many event-stream subscribers",
                                 code="sse_capacity", status=503, retry_ok=True)
            return
        # SSE is long-lived and counted by its own cap; hand the handler slot back.
        release = getattr(self.server, "release_slot", None)
        if release is not None:
            release(self.request)
        try:
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache, no-transform")
            self.send_header("Connection", "keep-alive")
            self.send_header("X-Accel-Buffering", "no")  # hint for any reverse proxy
            self._set_cors_origin()
            self.end_headers()
            # Opening event so clients can confirm the pipe is live.
            self.wfile.write(b"event: ready\ndata: {}\n\n")
            self.wfile.flush()

            next_ping = time.monotonic() + self.sse_ping_interval
            while True:
                wait = next_ping - time.monotonic()
                evt = None
                if wait > 0:
                    try:
                        evt = sub.get(timeout=wait)
                    except queue.Empty:
                        pass
                if evt is None:
                    ping = json.dumps({"ts": time.time()})
                    self.wfile.write(f": heartbeat\n\nevent: ping\ndata: {ping}\n\n".encode())
                    self.wfile.flush()
                    next_ping = time.monotonic() + self.sse_ping_interval
                    continue

                event_type, payload = evt
                try:
                    data = json.dumps(payload, ensure_ascii=False)
                except Exception as e:
                    log.warning("SSE payload not JSON-serializable: %s", e)
                    continue
                self.wfile.write(f"event: {event_type}\ndata: {data}\n\n".encode("utf-8"))
                self.wfile.flush()
        except OSError:
            pass  # client disconnected
        finally:
            unsubscribe_events(sub)

    def _handle_audit_network(self, query: dict) -> None:
        """MVP-22 — outbound-call ring-buffer endpoint.

        Returns:
          {
            "generated_at": <unix ts>,
            "totals_60s": {"loopback": N, "non_loopback": M, "error": K},
            "recent": [<entry>, ...],
            "warning": "External destination detected: <host>"  // optional
          }

        Default `recent` is the last 60s of activity. `?all=1` returns
        the full ring buffer (up to 200 entries). Both views are filtered
        out of the ring buffer in-process; nothing leaves the box on the
        read path either.
        """
        all_flag = query.get("all", ["0"])[0] == "1"
        now = time.time()
        cutoff = now - 60.0
        with _audit_lock:
            snap = list(_audit_log)
        recent = snap if all_flag else [e for e in snap if e["ts"] >= cutoff]
        # totals_60s is always windowed even when ?all=1 — privacy badge
        # cares about the recent window, not historical trend.
        windowed = [e for e in snap if e["ts"] >= cutoff]
        totals = {
            "loopback": sum(1 for e in windowed if e["is_loopback"]),
            "non_loopback": sum(
                1 for e in windowed if not e["is_loopback"]
            ),
            "error": sum(1 for e in windowed if e.get("error")),
        }
        payload: dict = {
            "generated_at": now,
            "totals_60s": totals,
            "recent": recent,
        }
        # Privacy red-flag: any non-loopback hit in the last 60s flips the
        # phone-UI banner to red. Use the most recent such entry as the
        # exemplar host so the modal can quote it directly.
        external = [e for e in windowed if not e["is_loopback"]]
        if external:
            payload["warning"] = (
                f"External destination detected: "
                f"{external[-1]['host']}:{external[-1]['port']}"
            )
        self.send_json(payload)

    def _handle_transcript_export(self):
        """GET /transcript/export.md — render the current session as markdown."""
        now = datetime.now()
        with transcript_lock:
            entries = [dict(e) for e in session_transcript]
        header_date = now.strftime("%Y-%m-%d %H:%M")
        filename = f"dictation-session-{now.strftime('%Y-%m-%d-%H%M')}.md"
        exported_iso = now.isoformat()

        starred_entries = [e for e in entries if e.get("starred")]
        all_entries = entries  # chronological full log

        def _render_entry(e: dict, out: list[str]) -> None:
            role = e.get("role", "user")
            label = "Partner" if role == "context" else "You"
            ts = e.get("timestamp", "")
            text = e.get("text", "")
            out.append(f"## [{label}] {ts}")
            out.append("")
            if role == "context":
                for chunk in text.splitlines() or [""]:
                    out.append(f"> {chunk}")
            else:
                out.append(text)
            out.append("")
            out.append("---")
            out.append("")

        lines: list[str] = []
        lines.append(f"# Dictation Session — {header_date}")
        lines.append("")
        lines.append(f"_Exported at {exported_iso}. Entry count: {len(entries)}. Starred: {len(starred_entries)}._")
        lines.append("")

        if starred_entries:
            lines.append("## ⭐ Saved takes")
            lines.append("")
            for e in starred_entries:
                _render_entry(e, lines)

        lines.append("## Session log")
        lines.append("")
        for e in all_entries:
            _render_entry(e, lines)

        body = ("\n".join(lines) + "\n").encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/markdown; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header(
            "Content-Disposition", f'attachment; filename="{filename}"'
        )
        self._set_cors_origin()
        self.end_headers()
        self.wfile.write(body)

    def _reject_oversized_body(self, limit: int) -> bool:
        """413/400 gate on Content-Length BEFORE any body byte is read.

        Returns True when a response has been sent and the caller must stop:
        malformed or negative Content-Length → 400, over `limit` → 413.
        A missing header passes (handlers treat it as an empty body).
        """
        raw = self.headers.get("Content-Length")
        if raw is None:
            return False
        try:
            length = int(raw)
        except (TypeError, ValueError):
            self.send_error_json("Malformed Content-Length header",
                                 code="bad_content_length", status=400)
            return True
        if length < 0:
            self.send_error_json("Malformed Content-Length header",
                                 code="bad_content_length", status=400)
            return True
        if length > limit:
            self.send_error_json(
                f"Request body too large (limit {limit} bytes)",
                code="payload_too_large", status=413,
                details={"limit_bytes": limit},
            )
            return True
        return False

    def read_json_body(self) -> dict:
        # Defense in depth: do_POST already 413s oversized bodies up front,
        # but every caller wraps this in try/except → 400, so raising here
        # keeps malformed/oversized input from ever being read.
        try:
            content_length = int(self.headers.get("Content-Length", 0) or 0)
        except (TypeError, ValueError):
            raise ValueError("malformed Content-Length")
        if content_length < 0:
            raise ValueError("negative Content-Length")
        if content_length == 0:
            return {}
        if content_length > MAX_JSON_BODY_BYTES:
            raise ValueError("JSON body exceeds MAX_JSON_BODY_BYTES")
        # A browser may send `text/plain` cross-site without a CORS preflight;
        # insisting on application/json makes every JSON write a preflighted
        # request that the Origin allowlist can refuse.
        ctype = (self.headers.get("Content-Type", "") or "").split(";", 1)[0].strip().lower()
        if ctype != "application/json":
            raise ValueError("Content-Type must be application/json")
        parsed = json.loads(self.rfile.read(content_length))
        # Every handler indexes the body as a mapping; a list/scalar used to
        # escape as an uncaught AttributeError (connection dropped, traceback).
        if not isinstance(parsed, dict):
            raise ValueError("JSON body must be an object")
        return parsed

    def send_error_json(self, error: str, code: str = "error", status: int = 400,
                        retry_ok: bool = False, details: dict | None = None):
        """Structured error response: {error, code, retry_ok, details?}."""
        payload: dict = {"error": error, "code": code, "retry_ok": retry_ok}
        if details:
            payload["details"] = details
        self.send_json(payload, status)

    def _render_html_with_embed(self, query: dict) -> str:
        """Inject embed config into the HTML response.

        If `embed=1` or any of the pre-population params are present, insert a
        <meta name="dictation-embed"> tag plus a <script> window-global so the
        frontend can pick up chat/persona/character IDs.
        """
        embed = query.get("embed", [""])[0] == "1"
        chat = query.get("chat", [""])[0]
        persona = query.get("persona", [""])[0]
        character = query.get("character", [""])[0]
        mode = query.get("mode", [""])[0]
        formatter_model = query.get("formatter_model", [""])[0]
        language = query.get("language", ["auto"])[0] or "auto"


        if not embed and not (chat or persona or character or mode or formatter_model or language != "auto"):
            return WEB_UI

        cfg = {
            "embed": True,
            "chat": chat or None,
            "persona": persona or None,
            "character": character or None,
            "mode": mode or None,
            "formatter_model": formatter_model or None,
            "language": language,
            # Parent frames the embedded page may exchange messages with:
            # `scheme://host` (any port), or ["*"] under wildcard CORS.
            "allowedOrigins": _allowed_origin_list(),
        }
        # Values are user-supplied query params: escape "<" so a crafted
        # ?chat=</script><script>… link can't break out of the script tag.
        cfg_json = json.dumps(cfg, ensure_ascii=True).replace("<", "\\u003c")
        meta = '\n<meta name="dictation-embed" content="1">'
        script = f'\n<script>window.DICTATION_EMBED_CONFIG = {cfg_json};</script>'
        injection = meta + script + "\n</head>"
        # </head> is deterministic and unique in WEB_UI
        return WEB_UI.replace("</head>", injection, 1)

    def _serve_root(self, query: dict) -> None:
        """Serve `/`: full UI for privileged/valid-bootstrap callers, else pairing page.

        A one-time code may load the UI but is consumed only by the phone page's
        POST /pair/exchange. Tokenless LAN reloads use sessionStorage from the
        pairing page to fetch the full UI without putting the bearer in a URL.
        """
        pairing_code = query.get("pair", [""])[0]
        if self._request_is_privileged() or pairing_code_is_valid(pairing_code):
            html = self._render_html_with_embed(query)
            # Only the unmodified shell at a bare `/` is cacheable; any query
            # (pairing code, legacy token, embed config) stays no-store.
            self.send_html(html, static=(html is WEB_UI and not query))
        else:
            self.send_html(PAIRING_BOOTSTRAP_HTML)

    def _health_payload(self, privileged: bool) -> dict:
        """Full health payload for loopback/tokened callers, bare otherwise."""
        if not privileged:
            # 2026-07 audit: no model list, mode count, or cert expiry for
            # unauthenticated non-loopback probes.
            return {"status": "ok"}
        days = cert_days_remaining()
        payload = {
            "status": "ok",
            "formatter_provider": "omniroute",
            "formatter_models": selectable_models(),
            "mode_count": len(load_modes()),
            "revision": INSTALL_REVISION or "checkout",
        }
        if days is not None:
            payload["cert_expires_days"] = days
        return payload

    @staticmethod
    def _state_chat(state_snap: dict, last_n: int) -> "tuple[list[dict], bool] | None":
        """Exact chat named by a FRESH ST state snapshot, else None (F5)."""
        if not state_snap.get("fresh") or not state_snap.get("chatId"):
            return None
        return ChatReader.read_state_chat(state_snap, last_n)

    def _read_chat_source(self, chat_type: str, chat_name: str,
                          last_n: int) -> tuple[list[dict], bool]:
        """Messages for a `type:name` chat source.

        When the source is the chat a fresh ST state names (`chatId`), the
        exact file is resolved from that state; otherwise — or when it cannot
        be resolved — the name-based lookup is used.
        """
        chat_type = chat_type if chat_type in ("solo", "individual", "group") else "individual"
        snap = snapshot_state()
        if chat_name and str(snap.get("chatId") or "") == chat_name:
            state_type = str(snap.get("chatType") or "individual")
            if (state_type == "group") == (chat_type == "group"):
                resolved = self._state_chat(snap, last_n)
                if resolved is not None:
                    return resolved
        legacy_type = "group" if chat_type == "group" else "individual"
        return ChatReader.read_chat_messages(chat_name, legacy_type, last_n=last_n), legacy_type == "group"

    def _send_active_chat(self, name: str, chat_type: str, messages: list[dict],
                          group_id: str = "") -> None:
        is_group = chat_type == "group"
        context_text = ContextBuilder.format_messages(messages, is_group=is_group)
        # POL-6 — chatType normalised to solo/group + optional group payload
        # (members + last speaker). `type` stays `individual`/`group` for
        # legacy consumers; the normalised value lives on `chatType`.
        payload: dict = {
            "name": name,
            "type": chat_type,
            "chatType": "group" if is_group else "solo",
            "messages": messages,
            "context_text": context_text,
        }
        if is_group:
            if not group_id:
                for g in ChatReader._load_group_defs():
                    if g.get("name", "") == name:
                        group_id = str(g.get("id", "") or "")
                        break
            if group_id:
                payload["groupId"] = group_id
                payload["groupMembers"] = ChatReader.group_member_objects(group_id)
                payload["lastSpeaker"] = ChatReader.get_group_last_speaker(group_id)
        self.send_json(payload)

    def do_GET(self):
        if not self.require_auth():
            return
        self._guarded(self._dispatch_get)

    def _dispatch_get(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)
        if path == "/":
            self._serve_root(query)
        elif path == "/manifest.json":
            body = PWA_MANIFEST.encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/manifest+json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif path == "/health":
            self.send_json(self._health_payload(self._request_is_privileged()))
        elif path == "/transcript":
            # Optional ?chat=<id> filter scopes the session log to a single chat.
            # Empty filter returns everything (legacy behavior).
            chat_filter = query.get("chat", [""])[0]
            # Snapshot under the lock, write after releasing it: a slow client
            # must not stall every transcribe/reformat append.
            with transcript_lock:
                total = len(session_transcript)
                if chat_filter:
                    entries = [
                        dict(e) for e in session_transcript
                        if e.get("chat_id", "") == chat_filter
                    ]
                else:
                    entries = [dict(e) for e in session_transcript]
            if chat_filter:
                self.send_json({"transcript": entries, "total": total, "chat": chat_filter})
            else:
                self.send_json({"transcript": entries})
        elif path == "/transcript/export.md":
            self._handle_transcript_export()
        elif path == "/personas":
            self.send_json({"personas": discover_personas()})
        elif path == "/formatter-models":
            self.send_json({
                "provider": "omniroute",
                "models": selectable_models(),
            })
        elif path == "/characters":
            # POL-6 — `?group=<groupId>` filters to that group's members.
            group_id = query.get("group", [""])[0].strip()
            if group_id:
                members = discover_group_characters(group_id)
                last_speaker = ChatReader.get_group_last_speaker(group_id)
                self.send_json({
                    "characters": members,
                    "groupId": group_id,
                    "lastSpeaker": last_speaker,
                })
            else:
                self.send_json({"characters": discover_characters()})
        elif path == "/recent-chats":
            chats = ChatReader.get_recent_chats(limit=20)
            # Strip internal 'file' field from response
            safe_chats = [
                {k: v for k, v in c.items() if k != "file"}
                for c in chats
            ]
            self.send_json({"chats": safe_chats})
        elif path == "/active-chat":
            # `?use_state=1`: the chat the fresh ST state names, not the
            # newest-mtime guess (same resolution as /transcribe use_state=1).
            if query.get("use_state", ["0"])[0] == "1":
                snap = snapshot_state()
                resolved = self._state_chat(snap, CHAT_CONTEXT_WINDOW)
                if resolved is not None:
                    messages, is_group = resolved
                    group_id = str(snap.get("groupId") or "") if is_group else ""
                    name = str(snap.get("characterName") or snap.get("chatId") or "")
                    if is_group:
                        name = next((str(g.get("name", "")) for g in ChatReader._load_group_defs()
                                     if str(g.get("id", "")) == group_id), "") or name
                    self._send_active_chat(name, "group" if is_group else "individual",
                                           messages, group_id)
                    return
            active = ChatReader.get_active_chat()
            if not active:
                self.send_json({"error": "No active chats found"})
            else:
                messages = ChatReader.read_chat_messages(
                    active["name"], active["type"], last_n=CHAT_CONTEXT_WINDOW
                )
                self._send_active_chat(active["name"], active["type"], messages)
        elif path == "/chat-context":
            qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            chat_name = qs.get("name", [""])[0]
            chat_type = qs.get("type", ["individual"])[0]
            try:
                last_n = int(qs.get("last", [str(CHAT_CONTEXT_WINDOW)])[0])
            except (TypeError, ValueError):
                self.send_error_json("'last' must be an integer", code="bad_input", status=400)
                return
            # Bounded: a huge value reads the whole chat file into the
            # response; a negative one slices from the wrong end.
            last_n = min(max(last_n, 1), 200)
            if not chat_name:
                self.send_error_json("Missing 'name' parameter", code="missing_param", status=400)
            else:
                messages, is_group = self._read_chat_source(chat_type, chat_name, last_n)
                context_text = ContextBuilder.format_messages(messages, is_group=is_group)
                self.send_json({
                    "name": chat_name,
                    "type": chat_type,
                    "messages": messages,
                    "context_text": context_text,
                })
        elif path == "/modes":
            modes = load_modes()
            self.send_json({"modes": [mode_public_view(m) for m in modes]})
        elif path == "/vocab":
            self.send_json({"vocab": load_vocab()})
        elif path == "/events":
            # Phase 2 — SSE stream. Long-lived; we block on the subscriber queue
            # until the client disconnects. ThreadingHTTPServer gives us a
            # dedicated thread so other requests proceed.
            self._handle_sse_stream()
            return
        elif path == "/state":
            # Phase 3 — current ST state snapshot with freshness.
            self.send_json(snapshot_state())
        elif path == "/state/mode-memory":
            # GET /state/mode-memory            -> full {char_id: mode_id} map
            # GET /state/mode-memory?character= -> { character, mode } for one char
            char = canonical_character_key(query.get("character", [""])[0])
            if char:
                self.send_json({
                    "character": char,
                    "mode": get_char_mode(char),
                })
            else:
                self.send_json({"modes": load_char_modes()})
        elif path == "/audit/network":
            self._handle_audit_network(query)
        elif path == "/tts/voices":
            self._handle_tts_voices()
        elif path == "/tts/voices/catalog":
            self._handle_tts_voices_catalog()
        elif _is_icon_path(path):
            # POL-5 / Agent 4 §8.3 — manifest references /icon-192.png and
            # /icon-512.png. Asset binaries are deploy-time; until they
            # exist this stub returns 404 with the correct MIME hint so
            # the PWA install flow doesn't error noisily.
            self.send_response(404)
            self.send_header("Content-Type", "image/png")
            self.send_header("Content-Length", "0")
            self.end_headers()
        else:
            self.send_response(404)
            self.end_headers()

    def do_DELETE(self):
        if not self.require_auth():
            return
        self._guarded(self._dispatch_delete)

    def _dispatch_delete(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)
        if path == "/transcript":
            wipe_all = query.get("all", ["0"])[0] == "1"
            chat_filter = query.get("chat", [""])[0]
            with transcript_lock:
                if chat_filter:
                    # Scoped clear: only entries tagged with this chat_id.
                    # Respects starred unless wipe_all=1.
                    before = len(session_transcript)
                    if wipe_all:
                        keep = [e for e in session_transcript if e.get("chat_id", "") != chat_filter]
                    else:
                        keep = [
                            e for e in session_transcript
                            if e.get("chat_id", "") != chat_filter or e.get("starred")
                        ]
                    cleared = before - len(keep)
                    # Starred entries of this chat that survived the clear.
                    kept = len([e for e in keep
                                if e.get("chat_id", "") == chat_filter and e.get("starred")])
                    session_transcript[:] = keep
                elif wipe_all:
                    cleared = len(session_transcript)
                    kept = 0
                    session_transcript.clear()
                else:
                    before = len(session_transcript)
                    to_keep = [e for e in session_transcript if e.get("starred")]
                    cleared = before - len(to_keep)
                    kept = len(to_keep)
                    session_transcript[:] = to_keep
            log.info("Session transcript cleared (wipe_all=%s, chat=%s, cleared=%d, kept_starred=%d)",
                     wipe_all, chat_filter or "*", cleared, kept)
            self.send_json({"cleared": cleared, "kept_starred": kept, "chat": chat_filter})
        elif path.startswith("/transcript/"):
            entry_id = urllib.parse.unquote(path[len("/transcript/"):]).strip()
            if not entry_id:
                self.send_error_json("Missing entry id in path",
                                     code="missing_param", status=400)
                return
            with transcript_lock:
                removed = False
                for i, e in enumerate(session_transcript):
                    if e.get("id") == entry_id:
                        session_transcript.pop(i)
                        removed = True
                        break
                transcript_count = len(session_transcript)
            if not removed:
                self.send_error_json(f"No transcript entry with id '{entry_id}'",
                                     code="entry_not_found", status=404,
                                     retry_ok=False)
                return
            self.send_json({"status": "deleted", "transcript_count": transcript_count})
        elif path.startswith("/vocab/"):
            target = urllib.parse.unquote(path[len("/vocab/"):]).strip()
            if not target:
                self.send_error_json("Missing vocab 'correct' value in path",
                                     code="missing_param", status=400)
                return
            removed = {"hit": False}

            def _drop(entries):
                remaining = [e for e in entries if e.get("correct") != target]
                removed["hit"] = len(remaining) != len(entries)
                return remaining

            try:
                vocab = update_vocab(_drop)
            except Exception as e:
                log.exception("Failed to write vocab")
                self.send_error_json(f"Failed to persist vocab: {e}",
                                     code="write_failed", status=500, retry_ok=True)
                return
            if not removed["hit"]:
                self.send_error_json(f"No vocab entry found for '{target}'",
                                     code="not_found", status=404)
                return
            self.send_json({"vocab": vocab, "removed": target})
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        if not self.require_auth():
            return
        self._guarded(self._dispatch_post)

    def _dispatch_post(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        # Body-size gate BEFORE any handler reads the body (2026-07 audit).
        # /transcribe carries audio; everything else is JSON.
        body_limit = MAX_AUDIO_BODY_BYTES if path == "/transcribe" else MAX_JSON_BODY_BYTES
        if self._reject_oversized_body(body_limit):
            return

        if path == "/warm":
            # Fire-and-forget from clients the moment capture starts: boot
            # whisper-server in the background so it is warm by upload time.
            status = prewarm_whisper()
            self.send_json({"status": status}, status=200 if status == "ready" else 202)
        elif path == "/pair/bootstrap":
            # Loopback normally bypasses auth, but minting a transferable phone
            # credential always requires the valid durable bearer in the header.
            token = self._request_bearer_token()
            expected_token = get_token()
            if not token or not expected_token or not secrets.compare_digest(token, expected_token):
                self._send_unauthorized("valid bearer token required")
                return
            code, expires_in = create_pairing_code(expected_token)
            self.send_json({"code": code, "expires_in": expires_in}, status=201)
        elif path == "/pair/exchange":
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            code = str((body or {}).get("code", "")).strip() if isinstance(body, dict) else ""
            token, state = consume_pairing_code(code)
            if state == "expired":
                self.send_error_json("Pairing code expired", code="pairing_code_expired",
                                     status=410, retry_ok=False)
                return
            if state != "ok":
                self.send_error_json("Pairing code invalid or already used",
                                     code="pairing_code_invalid", status=404,
                                     retry_ok=False)
                return
            self.send_json({"token": token})
        elif path == "/transcribe":
            self._handle_transcribe(params)
        elif path == "/reformat":
            self._handle_reformat(params)
        elif path == "/vocab":
            self._handle_vocab_add()
        elif path == "/word-alternatives":
            # POL-3 — "did you mean?" alternative generator (v1: vocab tier).
            # Body: {word: str, context?: str, character_id?: str}.
            # Subject to require_auth (gated above).
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            if not isinstance(body, dict):
                self.send_error_json("Expected a JSON object",
                                     code="bad_input", status=400)
                return
            word = str(body.get("word", "")).strip()
            if not word:
                self.send_error_json("Missing 'word'",
                                     code="missing_param", status=400)
                return
            ctx = str(body.get("context", "") or "")
            char = canonical_character_key(body.get("character_id", "") or body.get("character", "") or "")
            try:
                alts = word_alternatives(word, context=ctx, character_id=char)
            except Exception as e:
                log.exception("word_alternatives failed (word_len=%d)", len(word))
                self.send_error_json(f"Server error: {e}",
                                     code="server_error", status=500)
                return
            self.send_json({
                "word": word,
                "alternatives": alts,
            })
        elif path == "/state":
            # Phase 3 — ST extension (or any client) pushes current state.
            # Expected body: partial or full state payload; missing fields are preserved.
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            if not isinstance(body, dict):
                self.send_error_json("Expected a JSON object", code="bad_input", status=400)
                return
            snap = update_state(body)
            self.send_json(snap)
        elif path == "/send-to-st":
            # Phase 2 — phone (or any client) pushes text to ST via SSE fan-out.
            # Body: {text: str, raw?: str, cleaned?: str, mode?: str,
            #        formatting_skipped?: bool, formatting_reason?: str,
            #        auto_send?: bool}
            # The ST extension subscribed to /events receives a 'dictation-result'
            # event and writes to the chat textarea (and optionally auto-sends).
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            if not isinstance(body, dict):
                self.send_error_json("Expected a JSON object", code="bad_input", status=400)
                return
            text = str(body.get("text", "")).strip()
            if not text:
                self.send_error_json("Missing 'text'", code="missing_param", status=400)
                return
            payload = {
                "requestId": secrets.token_urlsafe(8),
                "text": text,
                "raw": str(body.get("raw", "")),
                "cleaned": str(body.get("cleaned", "")),
                "mode": str(body.get("mode", "")),
                "formatting_skipped": bool(body.get("formatting_skipped", False)),
                "formatting_reason": str(body.get("formatting_reason", "")),
                "model": str(body.get("model", "")),
                "model_fallback": bool(body.get("model_fallback", False)),
                "model_tier": _coerce_int(body.get("model_tier"), 0, lo=0, hi=99),
                "is_ooc": bool(body.get("is_ooc", False)),
                "mode_override": "ooc" if body.get("is_ooc") else "",
                "auto_send": bool(body.get("auto_send", False)),
                "ts": time.time(),
            }
            delivered = broadcast_event("dictation-result", payload)
            self.send_json({
                "status": "queued",
                "subscribers": delivered,
            })
        elif path == "/state/mode-memory":
            # Phase 3 — persist per-character mode selection.
            # Body: {character: <id>, mode: <mode_id>}
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            char = canonical_character_key((body or {}).get("character", ""))
            mode_id = str((body or {}).get("mode", "")).strip()
            if not char:
                self.send_error_json("Missing 'character'",
                                     code="missing_param", status=400)
                return
            if mode_id and get_mode(mode_id) is None:
                self.send_error_json(f"Unknown mode '{mode_id}'",
                                     code="unknown_mode", status=400)
                return
            updated = save_char_mode(char, mode_id)
            persisted_mode = str(updated.get(char, ""))
            self.send_json({
                "character": char,
                "mode": persisted_mode,
                "modes": updated,
            })
        elif path == "/modes/formatter":
            # Per-mode LLM assignment. Body: {mode: <mode_id>, model: <model|"">}
            # Empty model clears the pin and the mode reverts to the OmniRoute
            # fallback chain. A legacy `provider` key is ignored.
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            body = body or {}
            try:
                updated = save_mode_formatter(
                    str(body.get("mode", "")).strip(),
                    str(body.get("model", "")).strip(),
                )
            except ValueError as e:
                self.send_error_json(str(e), code="bad_mode_formatter", status=400)
                return
            self.send_json({"mode": updated})
        elif path.startswith("/transcript/") and path.endswith("/star"):
            # POST /transcript/<entry_id>/star — toggle starred on one entry
            mid = path[len("/transcript/"):-len("/star")]
            entry_id = urllib.parse.unquote(mid).strip()
            if not entry_id:
                self.send_error_json("Missing entry id in path",
                                     code="missing_param", status=400)
                return
            toggled = None
            with transcript_lock:
                for e in session_transcript:
                    if e.get("id") == entry_id:
                        e["starred"] = not bool(e.get("starred", False))
                        toggled = e["starred"]
                        break
            if toggled is None:
                self.send_error_json(f"No transcript entry with id '{entry_id}'",
                                     code="entry_not_found", status=404, retry_ok=False)
                return
            self.send_json({"entry_id": entry_id, "starred": toggled})
        elif path == "/tts":
            self._handle_tts()
        elif path == "/tts/audiobook":
            self._handle_tts_audiobook()
        elif path == "/tts/voices/suggest":
            self._handle_tts_voices_suggest()
        elif path == "/tts/voices/autocast":
            self._handle_tts_voices_autocast()
        else:
            self.send_response(404)
            self.end_headers()

    # ─── TTS handlers (Kokoro-82M proxy) ──────────────────
    def _handle_tts(self) -> None:
        """POST /tts — synthesize text via kokoro-server, stream WAV back.

        Body: {text: str, voice?: str, speed?: float}. Auth-gated by the
        do_POST `require_auth` check upstream.
        """
        try:
            body = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        text, voice, speed, err = _validate_tts_request(body)
        if err is not None:
            log.warning(
                "/tts validation failed: code=%s status=%s text_len=%s",
                err.get("code"), err.get("status"), len(str(body.get("text", "") or "")) if isinstance(body, dict) else 0,
            )
            self.send_error_json(err["error"], code=err["code"], status=err["status"])
            return
        if not _ensure_kokoro_alive():
            self.send_error_json(
                "kokoro-server unreachable",
                code="tts_unavailable", status=503, retry_ok=True,
            )
            return
        try:
            audio_bytes, ctype = _synthesize_via_kokoro(text, voice, speed=speed)
        except RuntimeError as e:
            log.warning("TTS synthesize failed: %s", e)
            self.send_error_json(
                f"TTS synthesis failed: {e}",
                code="tts_failed", status=502, retry_ok=True,
            )
            return
        _mark_tts_activity()
        # Stream raw audio. Don't go through send_json — Content-Type matters.
        self.send_response(200)
        self.send_header("Content-Type", ctype or "audio/wav")
        self.send_header("Content-Length", str(len(audio_bytes)))
        self._set_cors_origin()
        self.end_headers()
        try:
            self.wfile.write(audio_bytes)
        except Exception:
            # Client disconnected mid-stream — not actionable.
            pass

    def _handle_tts_voices(self) -> None:
        """GET /tts/voices — proxy kokoro-server's voices list with a 60s TTL cache."""
        try:
            payload = _list_kokoro_voices()
        except RuntimeError as e:
            log.warning("/tts/voices upstream failed: %s", e)
            self.send_error_json(
                f"Voice list unavailable: {e}",
                code="tts_failed", status=502, retry_ok=True,
            )
            return
        if payload is None:
            self.send_error_json(
                "kokoro-server unreachable",
                code="tts_unavailable", status=503, retry_ok=True,
            )
            return
        self.send_json(payload)

    def _handle_tts_audiobook(self) -> None:
        """POST /tts/audiobook — synthesize a chat transcript into one WAV.

        Body: {title?, narratorVoice?, voiceMap?, messages:[{name?, text, voice?}]}.
        Each message is synthesized independently (messages over the per-call
        cap become several segments), then PCM-compatible WAV segments are
        joined with short silence between them.
        """
        try:
            body = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        messages, narrator_voice, voice_map, title, err = _validate_audiobook_request(body)
        if err is not None:
            self.send_error_json(err["error"], code=err["code"], status=err["status"])
            return
        if not _ensure_kokoro_alive():
            self.send_error_json(
                "kokoro-server unreachable",
                code="tts_unavailable", status=503, retry_ok=True,
            )
            return

        # K7: reject unknown voice IDs before synthesizing anything, instead
        # of failing on message N after N-1 segments of wasted synthesis.
        wanted = {_voice_for_audiobook_message(m, narrator_voice, voice_map) for m in messages}
        missing = validate_voices(wanted)
        if missing:
            self.send_error_json(
                f"Unknown voice(s): {', '.join(missing)}",
                code="bad_voice", status=400,
                details={"unknown_voices": missing},
            )
            return

        segments: list[bytes] = []
        try:
            for message in messages:
                voice = _voice_for_audiobook_message(message, narrator_voice, voice_map)
                audio_bytes, ctype = _synthesize_via_kokoro(message["text"], voice, speed=1.0)
                if "wav" not in (ctype or "audio/wav").lower():
                    raise RuntimeError(f"kokoro-server returned non-WAV audio: {ctype}")
                segments.append(audio_bytes)
            audiobook = _combine_wav_segments(segments)
        except Exception as e:
            log.warning("Audiobook export failed: %s", e)
            self.send_error_json(
                f"Audiobook export failed: {e}",
                code="audiobook_failed", status=502, retry_ok=True,
            )
            return

        _mark_tts_activity()
        filename = f"{_safe_download_stem(title)}.wav"
        self.send_response(200)
        self.send_header("Content-Type", "audio/wav")
        self.send_header("Content-Length", str(len(audiobook)))
        self.send_header("Content-Disposition", f'attachment; filename="{filename}"')
        self._set_cors_origin()
        self.end_headers()
        try:
            self.wfile.write(audiobook)
        except Exception:
            pass

    def _handle_tts_voices_catalog(self) -> None:
        """GET /tts/voices/catalog — serve the local voice metadata catalog."""
        self.send_json({"catalog": _load_voice_catalog()})

    def _handle_tts_voices_suggest(self) -> None:
        """POST /tts/voices/suggest — heuristic voice suggestions for a character.

        Body: {name, description?, personality?, recent_messages?, existing_voices?, narrator?, n?}
        Returns: {suggestions: [{voice, score, reason}]}
        """
        try:
            body = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        if not isinstance(body, dict):
            self.send_error_json("Body must be an object", code="bad_json", status=400)
            return
        name = str(body.get("name") or "")
        description = str(body.get("description") or "")
        personality = str(body.get("personality") or "")
        recent = body.get("recent_messages")
        recent = [str(m) for m in (recent if isinstance(recent, list) else [])]
        existing = body.get("existing_voices")
        existing = existing if isinstance(existing, dict) else {}
        narrator = str(body.get("narrator") or "")
        n = _coerce_int(body.get("n"), 3, lo=1, hi=10)
        suggestions = _suggest_voices(name, description, personality, recent, existing, narrator, n)
        self.send_json({"suggestions": suggestions})

    def _handle_tts_voices_autocast(self) -> None:
        """POST /tts/voices/autocast — assign distinct voices to a whole cast.

        Body: {members: [{name, description?, personality?, recent_messages?}],
               existing_voices?, narrator?, overwrite?}
        Returns: {assignments: {name: voice}, assigned, skipped, reused}
        The client owns persistence: it merges `assignments` into its stored
        name->voice profile map. This endpoint is stateless.
        """
        try:
            body = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        if not isinstance(body, dict):
            self.send_error_json("Body must be an object", code="bad_json", status=400)
            return
        raw_members = body.get("members")
        if not isinstance(raw_members, list) or not raw_members:
            self.send_error_json("Missing 'members' list", code="missing_param", status=400)
            return
        members: list[dict] = []
        for m in raw_members[:64]:  # bound cast size defensively
            if isinstance(m, dict) and str(m.get("name") or "").strip():
                members.append(m)
        if not members:
            self.send_error_json("No named members provided", code="missing_param", status=400)
            return
        existing = body.get("existing_voices")
        existing = existing if isinstance(existing, dict) else {}
        narrator = str(body.get("narrator") or "")
        overwrite = bool(body.get("overwrite"))
        result = _autocast_voices(members, existing, narrator, overwrite=overwrite)
        self.send_json(result)

    def _handle_vocab_add(self):
        """POST /vocab — append a vocab entry, persist atomically, return full list."""
        try:
            data = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        if not isinstance(data, dict):
            self.send_error_json("Expected a JSON object", code="bad_input", status=400)
            return
        norm = _normalize_vocab_entry(data)
        if not norm:
            self.send_error_json("Missing or empty 'correct' field",
                                 code="missing_param", status=400)
            return

        try:
            vocab = update_vocab(
                lambda entries: [e for e in entries if e.get("correct") != norm["correct"]] + [norm]
            )
        except Exception as e:
            log.exception("Failed to write vocab")
            self.send_error_json(f"Failed to persist vocab: {e}",
                                 code="write_failed", status=500, retry_ok=True)
            return
        self.send_json({"vocab": vocab, "added": norm})

    def _build_chat_context(self, chat_source: str) -> str:
        """Build context string from ST chat history.

        `auto` uses the exact chat a fresh ST state names and falls back to
        the newest-mtime chat; `type:name` sources go through
        `_read_chat_source` (state-exact when `name` is the state's chat).
        """
        if chat_source == "auto":
            resolved = self._state_chat(snapshot_state(), CHAT_CONTEXT_WINDOW)
            if resolved is not None:
                messages, is_group = resolved
            else:
                active = ChatReader.get_active_chat()
                if not active:
                    return ""
                messages = ChatReader.read_chat_messages(
                    active["name"], active["type"], last_n=CHAT_CONTEXT_WINDOW
                )
                is_group = active["type"] == "group"
        else:
            # Format: "type:name"
            parts = chat_source.split(":", 1)
            if len(parts) != 2:
                return ""
            chat_type, chat_name = parts
            messages, is_group = self._read_chat_source(
                chat_type, chat_name, CHAT_CONTEXT_WINDOW)

        if not messages:
            return ""
        return ContextBuilder.format_messages(messages, is_group=is_group)

    def _handle_reformat(self, params: dict | None = None):
        """Re-run pipeline on previously transcribed text.

        Supports both legacy `rp=0|1|2` and new `mode=<id>`. `mode` wins.
        Runs the pipeline with `reformat=True` (no hallucination filter or
        voice-command dispatch) scoped to the request's chat.
        """
        params = params or {}
        try:
            data = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return

        try:
            text = _json_str(data, "text")
            mode_id = (_json_str(data, "mode") or params.get("mode", [""])[0] or "").strip()
            formatter_model = _json_str(data, "formatter_model").strip()
            context = clamp_request_context(_json_str(data, "context"))
            chat_source = _json_str(data, "chat_source").strip()
            persona_id = _json_str(data, "persona").strip()
            character_id = canonical_character_key(_json_str(data, "character"))
            scene_continuity = _json_str(data, "sceneContinuity")[:2000]
            entry_id = _json_str(data, "entry_id").strip() or None
            request_chat_id = _json_str(data, "chat_id").strip()
        except ValueError as e:
            self.send_error_json(str(e), code="bad_input", status=400)
            return
        persist_transcript = data.get("persist_transcript", True) is not False
        rp_raw = data.get("rp")
        if rp_raw is None:
            rp_raw = params.get("rp", [None])[0]
        try:
            rp_int = int(rp_raw) if rp_raw is not None else 2
        except (TypeError, ValueError):
            rp_int = 2
        mode = resolve_mode(rp=rp_int, mode_id=mode_id)
        # Clients may still send a legacy `provider` field; OmniRoute is the
        # only formatter route, so it is ignored.
        if formatter_model and formatter_model not in selectable_models():
            self.send_error_json(
                f"Model '{formatter_model}' is not selectable on OmniRoute",
                code="bad_formatter_model", status=400,
            )
            return
        use_rules = bool(data.get("rules", False))
        prose_format = bool(data.get("prose", False))

        # One snapshot for the whole request (never read under transcript_lock).
        # Its scene continuity and chat id apply only when this reformat is
        # for the state's chat; an explicit other chat is never mixed in.
        state_snap = snapshot_state()
        state_fresh = bool(state_snap.get("fresh"))
        state_chat_id = str(state_snap.get("chatId") or "") if state_fresh else ""
        on_state_chat = (
            _source_is_state_chat(chat_source, state_chat_id, state_usable=state_fresh)
            and request_chat_id in ("", state_chat_id)
        )
        if not scene_continuity and on_state_chat:
            scene_continuity = str(state_snap.get("sceneContinuity") or "")[:2000]
        chat_id = request_chat_id or (state_chat_id if on_state_chat else "")

        # Build chat context if source is not manual
        chat_context = ""
        if chat_source and chat_source != "manual":
            chat_context = self._build_chat_context(chat_source)

        if not text.strip():
            self.send_error_json("No text to reformat", code="missing_param", status=400)
            return

        # A mode with no LLM rewrite step cannot reformat. Returning the input
        # unchanged with formatting_skipped=False made the client report a
        # successful reformat that never touched a model — including when an
        # unknown mode id silently resolved to 'plain'.
        if not mode_has_formatter_step(mode):
            self.send_json({
                "text": text,
                "raw": text,
                "cleaned": "",
                "mode": mode.get("id"),
                "formatting_skipped": True,
                "formatting_reason": (
                    f"mode '{mode.get('id')}' has no formatter step — nothing to reformat"
                ),
                "model": "",
                "model_fallback": False,
                "model_tier": 0,
                "entry_id": None,
                "chat_id": "",
            })
            return

        pipeline_steps = mode.get("pipeline", [])
        is_enhancement = any(s in pipeline_steps for s in ("rp_enhance", "persona_pov"))
        will_persist = persist_transcript and is_enhancement

        # Resolve the target entry BEFORE the LLM call (SC-04). A targeted
        # request must name an existing user entry; a legacy no-ID
        # regeneration targets the newest user entry *now*, so a take that
        # lands while the formatter runs is never the one replaced.
        append_new = False
        if persist_transcript and entry_id is not None:
            with transcript_lock:
                target_ok = any(
                    e.get("id") == entry_id and e.get("role") == "user"
                    for e in session_transcript
                )
            if not target_ok:
                self.send_error_json(
                    "Entry not found or not a user entry",
                    code="entry_not_found", status=404, retry_ok=False,
                )
                return
        elif will_persist:
            with transcript_lock:
                newest = next((e for e in reversed(session_transcript)
                               if e.get("role") == "user"), None)
                entry_id = newest.get("id") if newest is not None else None
            append_new = entry_id is None

        # Run pipeline (I/O; don't hold the lock).
        formatted, formatting_skipped, formatting_reason, cleaned_text = run_pipeline(
            text, mode,
            context=context,
            persona_id=persona_id,
            character_id=character_id,
            chat_context=chat_context,
            scene_continuity=scene_continuity,
            use_rules=use_rules,
            prose_format=prose_format,
            formatter_model=formatter_model,
            chat_id=chat_id,
            reformat=True,
        )

        # Only append / replace in transcript for enhancement-style modes that succeeded.
        result_entry_id: str | None = None
        chat_id_tag = ""
        with transcript_lock:
            if will_persist and not formatting_skipped:
                # Re-resolve by id: the lock was released for the LLM call and
                # a concurrent delete/append may have shifted indices since.
                existing = None
                if entry_id is not None:
                    existing = next(
                        (e for e in session_transcript
                         if e.get("id") == entry_id and e.get("role") == "user"),
                        None,
                    )
                if existing is not None:
                    # In-place replacement keeps id, starred and chat tag.
                    existing["text"] = formatted
                    existing["timestamp"] = datetime.now().isoformat()
                    result_entry_id = existing.get("id")
                    chat_id_tag = str(existing.get("chat_id", "") or "")
                elif append_new:
                    new_entry = {
                        "id": _new_entry_id(),
                        "role": "user",
                        "text": formatted,
                        "timestamp": datetime.now().isoformat(),
                        "starred": False,
                        "chat_id": chat_id,
                    }
                    session_transcript.append(new_entry)
                    result_entry_id = new_entry["id"]
                    chat_id_tag = chat_id
                else:
                    # The target was deleted while the formatter ran. Persist
                    # nothing rather than overwrite an unrelated entry; the
                    # caller still gets the formatted text.
                    log.info("reformat: entry %s vanished during formatting; not persisted", entry_id)
            transcript_count = len(session_transcript)

        repair_trace = build_repair_trace(text, cleaned_text, formatted)
        attribution = get_model_attribution()
        self.send_json({
            "text": formatted,
            "raw": text,
            "cleaned": cleaned_text,
            "repair_trace": repair_trace,
            "mode": mode.get("id"),
            "transcript_count": transcript_count,
            "formatting_skipped": formatting_skipped,
            "formatting_reason": formatting_reason,
            "model": attribution["model"],
            "model_fallback": attribution["fallback"],
            "model_tier": attribution["tier"],
            "entry_id": result_entry_id,
            "chat_id": chat_id_tag,
        })

    def _handle_transcribe(self, params):
        """Transcribe audio and run the selected pipeline."""
        # POL-16 — per-stage timing trace. Stamps relative to `recv` are
        # rendered into a single JSON log line at the end. Greppable from
        # journalctl with: `journalctl --user -u dictation-server | grep "^timing "`.
        timing: dict[str, float] = {"recv": time.monotonic()}

        # Phase 3: `use_state=1` resolves persona/character/mode/chat_source from
        # the live ST state broadcast. Explicit query params still win if both
        # are provided (manual override on the phone UI).
        use_state = params.get("use_state", ["0"])[0] == "1"
        state_snap = snapshot_state() if use_state else {}
        state_fresh = state_snap.get("fresh", False)

        # Resolve mode: explicit param > state.mode > remembered per-char > legacy rp.
        mode_id = params.get("mode", [""])[0]
        if not mode_id and state_fresh:
            mode_id = state_snap.get("mode", "") or state_snap.get("rememberedMode", "")
        try:
            rp_int = int(params.get("rp", ["0"])[0])
        except ValueError:
            rp_int = 0
        mode = resolve_mode(rp=rp_int, mode_id=mode_id)
        # A legacy `provider` query param is ignored: OmniRoute is the only route.
        formatter_model = params.get("formatter_model", [""])[0].strip()
        if formatter_model and formatter_model not in selectable_models():
            self.send_error_json(
                f"Model '{formatter_model}' is not selectable on OmniRoute",
                code="bad_formatter_model", status=400,
            )
            return

        # Model: explicit query param overrides mode default.
        model = params.get("model", [mode.get("whisper_model", DEFAULT_MODEL)])[0]

        # MVP-10 / ADR-2 — drop hardcoded language. Default to 'en' for the
        # dominant case but accept any ISO-639-1 code; 'auto' lets whisper
        # detect (useful for full-Swahili utterances). Whitelist defensively:
        # whisper-server treats unknown values as 'auto' which is harmless,
        # but stripping characters keeps the form-field POST tidy.
        language = params.get("language", ["en"])[0].strip().lower() or "en"
        if not re.fullmatch(r"[a-z]{2,4}|auto", language):
            language = "en"

        context = self.request_context()
        chat_source = params.get("chat_source", [""])[0]
        persona_id = params.get("persona", [""])[0]
        character_id = params.get("character", [""])[0]
        use_rules = params.get("rules", ["0"])[0] == "1"
        prose_format = params.get("prose", ["0"])[0] == "1"
        scene_continuity = ""

        # Phase 3: fill in blanks from state when `use_state=1` and state is fresh.
        # Explicit params always take precedence over state (manual override wins).
        # Cast (persona/character, and mode above) may come from state for any
        # source; the chat's own data (last AI message, scene continuity, chat
        # tag) only when the effective source IS the state's chat — otherwise
        # an explicit other chat would be mixed with the ST tab's chat.
        state_chat_id = str(state_snap.get("chatId") or "") if (use_state and state_fresh) else ""
        if use_state and state_fresh:
            if not persona_id:
                persona_id = state_snap.get("personaId", "")
            if not character_id:
                character_id = state_snap.get("characterId", "")
            if not chat_source and state_chat_id:
                ctype = state_snap.get("chatType", "individual") or "individual"
                chat_source = f"{ctype}:{state_chat_id}"
        character_id = canonical_character_key(character_id)
        on_state_chat = _source_is_state_chat(chat_source, state_chat_id,
                                              state_usable=use_state and state_fresh)
        if on_state_chat:
            if not context and state_snap.get("lastAiMessage"):
                context = state_snap["lastAiMessage"]
            scene_continuity = str(state_snap.get("sceneContinuity") or "")[:2000]

        # chat_id tag for per-chat transcript filtering (Phase 3): the chat
        # this take belongs to, never the state's chat for an explicit other one.
        chat_id_for_entry = _chat_id_for_source(chat_source, state_chat_id)

        # Build chat context if source is not manual
        chat_context = ""
        if chat_source and chat_source != "manual":
            chat_context = self._build_chat_context(chat_source)
        timing["context"] = time.monotonic()

        # Read audio body (do_POST has already 400/413'd malformed or
        # oversized Content-Length; re-check defensively).
        try:
            content_length = int(self.headers.get("Content-Length", 0) or 0)
        except (TypeError, ValueError):
            content_length = 0
        if content_length <= 0:
            self.send_error_json("No audio data", code="missing_audio", status=400)
            return
        if content_length > MAX_AUDIO_BODY_BYTES:
            self.send_error_json(
                f"Audio body too large (limit {MAX_AUDIO_BODY_BYTES} bytes)",
                code="payload_too_large", status=413,
            )
            return
        content_type = self.headers.get("Content-Type", "")
        container = audio_container(content_type)
        if container is None:
            # The body stays unread: drop the connection after replying.
            self.close_connection = True
            self.send_error_json(
                "Unsupported audio type (send audio/webm, audio/mp4, audio/ogg or audio/wav)",
                code="unsupported_media_type", status=415,
            )
            return

        audio_data = self.rfile.read(content_length)
        timing["upload"] = time.monotonic()

        tmp_input = None
        tmp_wav = None
        audio_s = 0.0
        try:
            # Every accepted container (WAV included) is normalized by ffmpeg
            # to 16 kHz mono PCM; the upload file is removed right after.
            tmp_input = tempfile.NamedTemporaryFile(
                prefix="dictation-", suffix=f".{container}", dir="/tmp", delete=False
            )
            tmp_input.write(audio_data)
            tmp_input.close()
            del audio_data
            tmp_wav = tempfile.NamedTemporaryFile(
                prefix="dictation-", suffix=".wav", dir="/tmp", delete=False
            )
            tmp_wav.close()
            wav_path = Path(tmp_wav.name)
            try:
                audio_s = normalize_audio(Path(tmp_input.name), wav_path, container)
            finally:
                Path(tmp_input.name).unlink(missing_ok=True)

            timing["ffmpeg"] = time.monotonic()

            # Pre-whisper vocab bias (if mode's pipeline includes vocab_correct)
            whisper_prompt = ""
            if "vocab_correct" in mode.get("pipeline", []):
                whisper_prompt = build_whisper_prompt(character_id)

            # MVP-13: per-request id correlates streamed `dictation-token`
            # events with the final `dictation-result`. Generated server-side
            # and echoed in the JSON response so the ST extension can match
            # streamed deltas to the canonical final text.
            # MVP-16 also keys `dictation-state` events on this id so the
            # extension's state-machine bar can track which request is active.
            # A well-formed `client_request_id` lets the client own the id
            # before the response arrives (cross-tab streaming ownership).
            request_id = _request_id_from(params.get("client_request_id", [""])[0])

            # MVP-16 — handed off to whisper. Phone-side owns `listening`; we
            # never forge it from the server.
            self._emit_dictation_state(request_id, "transcribing")

            # Transcribe (MVP-9: per-word confidences from whisper-server
            # verbose JSON; empty list on subprocess fallback. MVP-10:
            # language flows from ?language=; default 'en'.) A boot of
            # whisper-server stamps `whisper_boot` into `timing`.
            try:
                raw_text, word_confidences = transcribe_with_confidence(
                    wav_path, model=model, prompt=whisper_prompt, language=language,
                    timing=timing,
                )
            finally:
                wav_path.unlink(missing_ok=True)

            timing["whisper"] = time.monotonic()

            if not raw_text:
                # Terminal state first: `transcribing` was already broadcast
                # and the extension's state bar otherwise sticks there.
                self._emit_dictation_state(request_id, "done", no_speech=True)
                self.send_error_json("No speech detected", code="no_speech",
                                     status=200, retry_ok=True)
                return

            # POL-1 — backwards-compat ST `OOC:` convention. Resolved here,
            # BEFORE the pipeline runs. No `dictation-command` event is
            # emitted — OOC is a content marker, not a UI action. Agent 3 §3.
            raw_text, mode, is_ooc = resolve_ooc_override(raw_text, mode)
            if is_ooc:
                if not raw_text:
                    self._emit_dictation_state(request_id, "done", no_speech=True)
                    self.send_error_json("No speech detected", code="no_speech",
                                         status=200, retry_ok=True)
                    return
                log.info("OOC prefix detected — mode override -> grammar_clean")

            self._emit_dictation_transcript(
                request_id,
                "final",
                raw_text,
                mode=mode.get("id", ""),
                language=language,
                latency_ms=round((timing["whisper"] - timing["recv"]) * 1000),
            )

            pipeline_steps = mode.get("pipeline", [])
            is_enhancement = any(s in pipeline_steps for s in ("rp_enhance", "persona_pov"))

            # Add context to transcript if provided (enhancement modes only)
            if is_enhancement and context.strip():
                with transcript_lock:
                    if not session_transcript or session_transcript[-1].get("text") != context.strip():
                        session_transcript.append({
                            "id": _new_entry_id(),
                            "role": "context",
                            "text": context.strip(),
                            "timestamp": datetime.now().isoformat(),
                            "starred": False,
                            "chat_id": chat_id_for_entry,
                        })

            # Run pipeline.
            # POL-16: pass `timing` so each step stamps wall-clock entries.
            # MVP-16: request_id always flows now — it's the SSE state-event
            # correlation key. Streaming gating still happens *inside*
            # `format_rp`, which only forwards request_id to the proxy on
            # streaming-eligible steps (rp_enhance / persona_pov).
            output_text, formatting_skipped, formatting_reason, cleaned_text = run_pipeline(
                raw_text, mode,
                context=context,
                persona_id=persona_id,
                character_id=character_id,
                chat_context=chat_context,
                scene_continuity=scene_continuity,
                use_rules=use_rules,
                prose_format=prose_format,
                formatter_model=formatter_model,
                request_id=request_id,
                timing=timing,
                chat_id=chat_id_for_entry,
            )

            # Log to session transcript only for enhancement modes with success
            entry_id = ""
            if is_enhancement and not formatting_skipped:
                entry_id = _new_entry_id()
                with transcript_lock:
                    session_transcript.append({
                        "id": entry_id,
                        "role": "user",
                        "text": output_text,
                        "timestamp": datetime.now().isoformat(),
                        "starred": False,
                        "chat_id": chat_id_for_entry,
                    })

            with transcript_lock:
                transcript_count = len(session_transcript)

            repair_trace = build_repair_trace(raw_text, cleaned_text, output_text)
            attribution = get_model_attribution()

            # MVP-13: emit canonical `dictation-result` after streaming. The
            # ST extension overwrites whatever it accumulated from
            # `dictation-token` deltas with this — guarantees no drift between
            # streamed bytes (which can include filtered thinking-tag fragments
            # or be cut off mid-stream) and the final source-of-truth text.
            if is_enhancement:
                broadcast_event("dictation-result", {
                    "requestId": request_id,
                    "text": output_text,
                    "has_repair_trace": repair_trace.get("has_changes", False),
                    "mode": mode.get("id", ""),
                    "formatting_skipped": formatting_skipped,
                    "formatting_reason": formatting_reason,
                    "model": attribution["model"],
                    "model_fallback": attribution["fallback"],
                    "model_tier": attribution["tier"],
                    "is_ooc": is_ooc,
                    "mode_override": "ooc" if is_ooc else "",
                    "auto_send": False,
                    "ts": time.time(),
                })

            # POL-3 — low-confidence spans for the "did you mean?" overlay.
            # We anchor offsets into the post-pipeline `output_text` when one
            # exists (so the phone chips line up with what the user sees);
            # for pure-pipeline modes that emit empty text (voice command
            # short-circuit), spans are skipped entirely.
            anchor_text = output_text or raw_text
            low_confidence_spans: list[dict] = []
            if anchor_text:
                try:
                    low_confidence_spans = compute_low_confidence_spans(
                        anchor_text, word_confidences,
                        character_id=character_id,
                    )
                except Exception as _e:  # pragma: no cover — best-effort overlay
                    log.debug("compute_low_confidence_spans failed: %s", _e)
                    low_confidence_spans = []

            timing["respond"] = time.monotonic()

            # POL-16 — single-line JSON timing trace; cumulative ms from `recv`.
            # `audio_s` is decoded duration (metadata only); `whisper_cold`
            # marks a request that had to boot whisper-server.
            try:
                stages_ms = {
                    k: round((v - timing["recv"]) * 1000)
                    for k, v in timing.items() if k != "recv"
                }
                log.info("timing %s", json.dumps({
                    "req": request_id,
                    "mode": mode.get("id", ""),
                    "audio_s": round(audio_s, 1),
                    "whisper_cold": "whisper_boot" in timing,
                    "stages_ms": stages_ms,
                }))
            except Exception as _e:
                log.debug("timing log emit failed: %s", _e)

            # MVP-16 — pipeline finished. Tells the state-machine bar to
            # collapse; ST extension can now overwrite #send_textarea with
            # the canonical text from the JSON response below (or from the
            # `dictation-result` SSE event).
            self._emit_dictation_state(request_id, "done")

            self.send_json({
                "text": output_text,
                "raw": raw_text,
                "cleaned": cleaned_text,
                "repair_trace": repair_trace,
                "mode": mode.get("id"),
                "transcript_count": transcript_count,
                "formatting_skipped": formatting_skipped,
                "formatting_reason": formatting_reason,
                "model": attribution["model"],
                "model_fallback": attribution["fallback"],
                "model_tier": attribution["tier"],
                "chat_id": chat_id_for_entry or "",
                # Transcript entry written for this take ("" when none);
                # clients pass it back to /reformat to target this take.
                "entry_id": entry_id,
                # POL-1: tells the extension to re-prefix `OOC: ` so the aside
                # is not pasted as an in-character line.
                "is_ooc": is_ooc,
                "mode_override": "ooc" if is_ooc else "",
                # MVP-9: per-word confidences from whisper-server JSON output.
                # Empty when subprocess fallback ran or response carried no
                # token-level data.
                "word_confidences": word_confidences,
                # POL-3: words flagged as low-confidence + vocab alternatives.
                # Empty list when whisper didn't emit token-level data, when
                # all words clear the threshold, or when the pipeline emitted
                # no canonical text (voice-command short-circuit).
                "low_confidence_spans": low_confidence_spans,
                # MVP-13: client correlates streamed deltas to canonical text.
                "request_id": request_id,
            })

        except FfmpegMissingError as e:
            self.send_error_json(str(e), code="ffmpeg_missing", status=503, retry_ok=False)
        except AudioTooLongError as e:
            self.send_error_json(str(e), code="audio_too_long", status=413,
                                 details={"max_seconds": config.MAX_AUDIO_SECONDS})
        except AudioConversionError as e:
            self.send_error_json(str(e), code="ffmpeg_failed", status=400)
        except FileNotFoundError as e:
            self._emit_dictation_state(locals().get("request_id", ""), "error",
                                       cls=e.__class__.__name__)
            self.send_error_json(str(e), code="model_missing", status=400)
        except RuntimeError as e:
            # transcribe() raises this for timeouts + whisper-cli failures
            self._emit_dictation_state(locals().get("request_id", ""), "error",
                                       cls=e.__class__.__name__)
            self.send_error_json(str(e), code="whisper_failed", status=500, retry_ok=True)
        except (BrokenPipeError, ConnectionResetError):
            raise
        except Exception as e:
            self._emit_dictation_state(locals().get("request_id", ""), "error",
                                       cls=e.__class__.__name__)
            log.exception("Transcription error")
            if getattr(self, "_response_started", False):
                # The response already began; a second one would corrupt it.
                self.close_connection = True
            else:
                self.send_error_json(f"Server error: {e.__class__.__name__}",
                                     code="server_error", status=500)
        finally:
            if tmp_input:
                Path(tmp_input.name).unlink(missing_ok=True)
            if tmp_wav:
                Path(tmp_wav.name).unlink(missing_ok=True)

    def do_OPTIONS(self):
        """Handle CORS preflight."""
        self.send_response(204)
        self._set_cors_origin()
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization, X-Dictation-Context")
        self.end_headers()


