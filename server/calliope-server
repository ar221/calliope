def _verify_install_manifest(data_dir: Path, wrapper: Path) -> str:
    """Check an installed copy against scripts/install-server's manifest.

    Returns the installed revision. Wrapper and package are deployed together;
    a hand-copied wrapper or a half-synced package is a mixed-revision install,
    which is worse than a hard stop.
    """
    import hashlib

    manifest = data_dir / "INSTALL_MANIFEST"
    problems: list[str] = []
    revision = ""
    listed: set[str] = set()
    try:
        lines = manifest.read_text(encoding="utf-8").splitlines()
    except OSError:
        lines = []
        problems.append(f"{manifest} is missing")
    for line in lines:
        if line.startswith("revision "):
            revision = line.split(" ", 1)[1].strip()
            continue
        digest, _, name = line.partition("  ")
        if not name:
            continue
        listed.add(name)
        target = wrapper if name == "wrapper" else data_dir / name
        try:
            actual = hashlib.sha256(target.read_bytes()).hexdigest()
        except OSError:
            problems.append(f"{name} is missing")
            continue
        if actual != digest:
            problems.append(f"{name} differs from the installed revision")
    if lines:
        if "wrapper" not in listed:
            problems.append("manifest does not cover the executable")
        for extra in sorted((data_dir / "calliope_server").glob("*.py")):
            if f"calliope_server/{extra.name}" not in listed:
                problems.append(f"calliope_server/{extra.name} is not part of the installed revision")
    if problems:
        sys.stderr.write(
            "error: mixed or unverified calliope install:\n"
            + "".join(f"  {p}\n" for p in problems)
            + "Re-run scripts/install-server from the calliope checkout.\n"
        )
        sys.exit(1)
    return revision


# "" when running from a checkout/wheel, where package and wrapper are one tree.
INSTALL_REVISION = ""
if _PKG_DIR is not None:
    if _PKG_DIR.parent == _PKG_PARENT:
        # Repo/wheel layout: package sits next to this file (code-controlled
        # directory) — normal sys.path import.
        if str(_PKG_PARENT) not in sys.path:
            sys.path.insert(0, str(_PKG_PARENT))
    else:
        INSTALL_REVISION = _verify_install_manifest(_DATA_PARENT, Path(__file__).resolve())
        # Installed layout: load via explicit spec instead of putting the
        # user-writable data dir on sys.path, where a stray *.py would
        # shadow stdlib/site-packages for the whole process.
        import importlib.util as _ilu

        _spec = _ilu.spec_from_file_location(
            "calliope_server",
            _PKG_DIR / "__init__.py",
            submodule_search_locations=[str(_PKG_DIR)],
        )
        assert _spec is not None and _spec.loader is not None
        _pkg_mod = _ilu.module_from_spec(_spec)
        sys.modules["calliope_server"] = _pkg_mod
        _spec.loader.exec_module(_pkg_mod)

