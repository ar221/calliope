    payload = {
        "url": base_url,
        "token": token,
        "fingerprint": fingerprint or "",
    }
    pair_url = (f"{base_url}/pair?token={urllib.parse.quote(token)}"
                f"&fingerprint={urllib.parse.quote(fingerprint or '')}")
