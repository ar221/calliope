# ─── MVP-22 — outbound network audit ──────────────────────
# Ring buffer of every `urllib.request.urlopen` call this process makes.
# The privacy story claims "your audio never leaves the box" — this is
# how it stays auditable. The phone UI fetches /audit/network and renders
# a privacy badge + tappable log; if any non-loopback host appears, the
# badge turns red. Per Agent 7 §2 #7 + Agent 4 §10.
#
# Each entry: {ts, host, port, method, path, bytes_out, latency_ms,
#              is_loopback, error?}.
# Capacity 200 keeps several minutes of dense pipeline runs in scope.
_audit_log: "collections.deque[dict]" = collections.deque(maxlen=200)
_audit_lock = threading.Lock()


def _is_loopback_host(host: str) -> bool:
    """True iff `host` resolves to a loopback address.

    `host` may be a literal IP (`127.0.0.1`, `::1`), a bracketed IPv6
    literal (`[::1]`), `localhost`, or empty string (same-process call).
    Falls back to a string-match for the documented hostnames when the
    value doesn't parse as an IP.
    """
    if not host or host == "localhost":
        return True
    h = host.strip("[]")
    if h in {"::1", "127.0.0.1"}:
        return True
    try:
        return ipaddress.ip_address(h).is_loopback
    except ValueError:
        return False


_real_urlopen = urllib.request.urlopen


def _audited_urlopen(req, *args, **kwargs):
    """Recording wrapper around urllib.request.urlopen.

    Captures destination + bytes-out + latency for every outbound HTTP
    call this process makes. Preserves the original urlopen semantics
    exactly; failures re-raise unchanged after the ring-buffer push.
    """
    if isinstance(req, urllib.request.Request):
        url = req.full_url
        method = req.get_method()
        # urllib stores body on .data; bytes-or-iterator → estimate length
        try:
            body = req.data
            bytes_out = len(body) if isinstance(body, (bytes, bytearray)) else 0
        except Exception:
            bytes_out = 0
    else:
        url = str(req)
        method = "GET"
        bytes_out = 0

    parsed = urllib.parse.urlparse(url)
    host = parsed.hostname or ""
    port = parsed.port or (443 if parsed.scheme == "https" else 80)
    is_lo = _is_loopback_host(host)
    t0 = time.monotonic()
    err: Exception | None = None
    try:
        return _real_urlopen(req, *args, **kwargs)
    except Exception as e:
        err = e
        raise
    finally:
        entry = {
            "ts": time.time(),
            "host": host,
            "port": port,
            "method": method,
            "path": parsed.path or "/",
            "bytes_out": bytes_out,
            "latency_ms": round((time.monotonic() - t0) * 1000, 2),
            "is_loopback": is_lo,
        }
        if err is not None:
            entry["error"] = err.__class__.__name__
        with _audit_lock:
            _audit_log.append(entry)


# Idempotent monkey-patch — module reload (tests/dev) MUST NOT double-wrap.
# Setting `_audited` on the wrapper itself lets us detect "already patched".
_audited_urlopen._audited = True  # type: ignore[attr-defined]
if not getattr(urllib.request.urlopen, "_audited", False):
    urllib.request.urlopen = _audited_urlopen  # type: ignore[assignment]




def _token_matches(presented: str, expected: str) -> bool:
    """Timing-safe token compare tolerant of non-ASCII input.

    `secrets.compare_digest` raises TypeError on non-ASCII *str* operands;
    comparing UTF-8 bytes never does, so a garbage `?token=%C3%A9` cannot
    crash the handler on the auth-exempt `/` and `/health` surface.
    """
    if not presented or not expected:
        return False
    return secrets.compare_digest(presented.encode("utf-8"), expected.encode("utf-8"))


# ─── SSL cert generation ─────────────────────────────────

# Set at bootstrap to the live SSLContext so the in-run renewal thread can
# hot-reload the cert chain for new TLS handshakes without a full restart.
_ssl_context: "ssl.SSLContext | None" = None
_cert_renew_thread: "threading.Thread | None" = None



def _discover_local_ips() -> list[str]:
    """Best-effort enumeration of interface IPs for cert SAN.

    Always includes 127.0.0.1 and ::1. Adds every address `getaddrinfo`
    returns for the local hostname. Pure stdlib — no `ip` command shellout.
    """
    import socket
    ips: list[str] = ["127.0.0.1", "::1"]
    seen = set(ips)
    try:
        for fam, *_rest, sa in socket.getaddrinfo(socket.gethostname(), None):
            if fam not in (socket.AF_INET, socket.AF_INET6):
                continue
            ip = sa[0]
            # Strip scope id from link-local IPv6 (`fe80::1%eth0`).
            if "%" in ip:
                ip = ip.split("%", 1)[0]
            if ip and ip not in seen:
                ips.append(ip)
                seen.add(ip)
    except Exception as e:
        log.debug(f"_discover_local_ips: getaddrinfo failed: {e}")
    return ips


def _generate_self_signed_cert(sans: list[str] | None = None):
    """Mint a self-signed cert valid for CERT_VALIDITY_DAYS.

    `sans` extends subjectAltName beyond the default loopback set. Each
    entry is auto-classified IP vs DNS. Backward-compatible: caller may
    omit `sans` and the existing default (just CN) ships.
    """
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    log.info("Generating self-signed SSL certificate...")

    # Mint into staging files next to the live pair, then install both with
    # rollback: a failure mid-generation never leaves a mismatched live pair.
    suffix = f".new.{os.getpid()}.{secrets.token_hex(4)}"
    tmp_crt = CERT_FILE.with_suffix(CERT_FILE.suffix + suffix)
    tmp_key = KEY_FILE.with_suffix(KEY_FILE.suffix + suffix)
    cmd = [
        "openssl", "req", "-x509", "-newkey", "rsa:2048",
        "-keyout", str(tmp_key), "-out", str(tmp_crt),
        "-days", str(CERT_VALIDITY_DAYS), "-nodes",
        "-subj", "/CN=dictation-server",
    ]

    if sans:
        san_parts: list[str] = []
        for entry in sans:
            entry = (entry or "").strip()
            if not entry:
                continue
            try:
                ipaddress.ip_address(entry)
                san_parts.append(f"IP:{entry}")
            except ValueError:
                san_parts.append(f"DNS:{entry}")
        if san_parts:
            cmd.extend(["-addext", "subjectAltName=" + ",".join(san_parts)])

    try:
        # Owner-only from creation; openssl truncates and keeps the mode.
        os.close(os.open(tmp_key, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600))
        subprocess.run(cmd, check=True, capture_output=True)
        if not (tmp_crt.is_file() and tmp_key.is_file()
                and tmp_crt.stat().st_size and tmp_key.stat().st_size):
            raise RuntimeError("openssl produced no certificate/key")
        # Enforce file modes per ADR-14 §7: cert 0644, key 0600.
        os.chmod(tmp_crt, 0o644)
        os.chmod(tmp_key, 0o600)
        _install_cert_pair_with_rollback(tmp_crt, tmp_key, backup_tag="pre-renew")
    finally:
        for p in (tmp_crt, tmp_key):
            p.unlink(missing_ok=True)
    log.info(f"Certificate saved to {CERT_FILE} (valid {CERT_VALIDITY_DAYS} days)")


def cert_fingerprint_sha256() -> str | None:
    """Return colon-separated SHA-256 fingerprint of the cert, or None on failure."""
    if not CERT_FILE.exists():
        return None
    try:
        result = subprocess.run(
            ["openssl", "x509", "-fingerprint", "-sha256", "-noout", "-in", str(CERT_FILE)],
            capture_output=True, text=True, timeout=5, check=True,
        )
        # Output: "sha256 Fingerprint=AA:BB:CC:..."
        line = result.stdout.strip()
        if "=" in line:
            return line.split("=", 1)[1].strip()
        return None
    except Exception as e:
        log.warning(f"Failed to compute cert fingerprint: {e}")
        return None


def _persist_cert_fingerprint() -> str | None:
    """Write the live cert's fingerprint to CERT_FINGERPRINT_FILE (0644)."""
    fp = cert_fingerprint_sha256()
    if fp:
        try:
            CERT_FINGERPRINT_FILE.write_text(fp + "\n", encoding="utf-8")
            os.chmod(CERT_FINGERPRINT_FILE, 0o644)
        except Exception as e:
            log.warning(f"Could not persist cert fingerprint: {e}")
    return fp


# O-08: parsed notAfter keyed by the cert file's (mtime_ns, size, inode), so
# privileged /health polls do not spawn openssl until the cert is replaced.
_cert_expiry_cache: dict = {"key": None, "end": None}
_cert_expiry_lock = threading.Lock()


def _cert_not_after():
    from datetime import datetime, timezone
    try:
        st = CERT_FILE.stat()
    except OSError:
        return None
    key = (st.st_mtime_ns, st.st_size, st.st_ino)
    with _cert_expiry_lock:
        if _cert_expiry_cache["key"] == key:
            return _cert_expiry_cache["end"]
    result = subprocess.run(
        ["openssl", "x509", "-enddate", "-noout", "-in", str(CERT_FILE)],
        capture_output=True, text=True, timeout=5, check=True,
    )
    # Output: "notAfter=May  1 12:00:00 2035 GMT"
    end_str = result.stdout.strip().split("=", 1)[1]
    end_dt = datetime.strptime(end_str, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
    with _cert_expiry_lock:
        _cert_expiry_cache["key"] = key
        _cert_expiry_cache["end"] = end_dt
    return end_dt


def cert_days_remaining() -> int | None:
    """Return days until cert expires, or None if cert is missing/unreadable."""
    from datetime import timezone
    if not CERT_FILE.exists():
        return None
    try:
        end_dt = _cert_not_after()
        if end_dt is None:
            return None
        return (end_dt - datetime.now(timezone.utc)).days
    except Exception as e:
        log.warning(f"Failed to read cert expiry: {e}")
        return None


def _cert_is_calliope_self_signed() -> bool:
    """True only when CERT_FILE is a cert *we* minted and may safely regenerate.

    We positively identify our own self-signed cert rather than broadly
    treating every CA-issued cert as external, so a user-installed custom
    cert (self-signed or CA-signed) is never clobbered. Our cert is uniquely:
      - self-signed (subject == issuer), AND
      - subject CN == 'dictation-server' (see _generate_self_signed_cert).

    Returns False on any parse failure or missing cert — fail safe: unknown
    means do-not-clobber.
    """
    if not CERT_FILE.exists():
        return False
    try:
        result = subprocess.run(
            ["openssl", "x509", "-noout", "-subject", "-issuer", "-in", str(CERT_FILE)],
            capture_output=True, text=True, timeout=5, check=True,
        )
    except Exception as e:
        log.warning(f"Could not read cert subject/issuer: {e}")
        return False
    subject = issuer = ""
    for line in result.stdout.splitlines():
        low = line.lower()
        if low.startswith("subject="):
            subject = line.split("=", 1)[1].strip()
        elif low.startswith("issuer="):
            issuer = line.split("=", 1)[1].strip()
    if not subject or subject != issuer:
        return False  # CA-issued (e.g. Let's Encrypt/Tailscale) — never regenerate
    # Self-signed: only ours carries CN=dictation-server.
    return "CN=dictation-server" in subject or "CN = dictation-server" in subject


def ensure_ssl_cert() -> bool:
    """Generate/renew our cert and return whether the live pair changed.

    An externally-managed cert (Tailscale/Let's Encrypt, or a user-installed
    custom cert) is never regenerated — clobbering it is exactly the bug that
    broke phone pairing. For those we warn and leave renewal to the operator
    (`dictation-server --tailscale-cert` or their own tooling).
    """
    sans = _discover_local_ips()
    try:
        import socket as _sock
        host = _sock.gethostname()
        if host and host not in sans:
            sans.append(host)
    except Exception:
        pass

    if not (CERT_FILE.exists() and KEY_FILE.exists()):
        _generate_self_signed_cert(sans=sans)
        return True

    days = cert_days_remaining()
    if days is None:
        log.warning("Could not determine cert expiry — leaving existing cert in place")
        return False

    if not _cert_is_calliope_self_signed():
        # Externally-managed cert: warn near expiry but never overwrite it.
        if days < CERT_RENEW_THRESHOLD_DAYS:
            log.warning(
                f"Externally-managed SSL cert expires in {days} days — NOT auto-regenerating. "
                f"Renew it (e.g. `dictation-server --tailscale-cert`) to avoid an outage."
            )
        elif days < CERT_WARN_THRESHOLD_DAYS:
            log.warning(f"Externally-managed SSL cert expires in {days} days — renew it soon.")
        else:
            log.info(f"Externally-managed SSL cert valid for {days} more days")
        return False

    if days < CERT_RENEW_THRESHOLD_DAYS:
        log.warning(f"SSL cert expires in {days} days — auto-regenerating")
        _generate_self_signed_cert(sans=sans)
        return True

    if days < CERT_WARN_THRESHOLD_DAYS:
        log.warning(f"SSL cert expires in {days} days — consider regenerating soon")
    else:
        log.info(f"SSL cert valid for {days} more days")
    return False


def _reload_ssl_context_cert() -> bool:
    """Hot-reload the cert chain into the live SSLContext.

    ``SSLContext.load_cert_chain`` can be re-called on a running context; new
    TLS handshakes pick up the fresh cert while existing connections keep the
    old one until they close. Returns True on success. No-op (False) when the
    context was never registered (e.g. --no-ssl) or reload fails.
    """
    ctx = _ssl_context
    if ctx is None:
        return False
    try:
        ctx.load_cert_chain(str(CERT_FILE), str(KEY_FILE))
        log.info("Reloaded regenerated cert into live SSLContext (new handshakes only)")
        return True
    except Exception as e:
        log.warning(f"Could not hot-reload cert into live SSLContext: {e}")
        return False


def _check_and_renew_cert() -> bool:
    """One in-run cert renewal check. Returns True if the cert was renewed.

    Regenerates when fewer than CERT_RENEW_THRESHOLD_DAYS remain and hot-reloads
    the live SSLContext so a long-running server does not cross expiry between
    restarts. Separated from the loop so tests can drive it directly.
    """
    days = cert_days_remaining()
    if days is None:
        log.warning("In-run cert check: could not determine cert expiry — skipping")
        return False
    if days >= CERT_RENEW_THRESHOLD_DAYS:
        if days < CERT_WARN_THRESHOLD_DAYS:
            log.info(f"In-run cert check: {days} days remaining")
        return False
    log.warning(f"In-run cert check: cert expires in {days} days — regenerating")
    renewed = ensure_ssl_cert()
    if not renewed:
        log.warning("In-run cert check: near-expiry cert is externally managed — renewal skipped")
        return False
    if _reload_ssl_context_cert():
        _persist_cert_fingerprint()
    else:
        log.warning("Regenerated cert on disk but could not hot-reload it — "
                    "restart the dictation-server to serve the new cert")
    return True


def _cert_renew_loop() -> None:
    """Daemon loop: periodically renew the cert in-run. Never raises out."""
    while True:
        time.sleep(CERT_RENEW_CHECK_INTERVAL_SECONDS)
        try:
            _check_and_renew_cert()
        except Exception as e:  # pragma: no cover - defensive
            log.warning(f"In-run cert renewal loop error: {e}")


def _start_cert_renew_thread() -> None:
    """Start the in-run cert renewal daemon thread once. Idempotent."""
    global _cert_renew_thread
    if _cert_renew_thread is not None and _cert_renew_thread.is_alive():
        return
    t = threading.Thread(
        target=_cert_renew_loop,
        name="cert-inrun-renewal",
        daemon=True,
    )
    t.start()
    _cert_renew_thread = t


# ─── Auth: bearer token + loopback bypass + CORS allowlist ─
_DEFAULT_CORS_ORIGINS = (
    "https://localhost,https://127.0.0.1,https://[::1]"
)
_CORS_RAW = os.environ.get("DICTATION_CORS_ORIGINS", _DEFAULT_CORS_ORIGINS).strip()
CORS_ALLOW_WILDCARD = (_CORS_RAW == "*")
# Normalize allowlist into (scheme, host) pairs; port matched by glob.
# Each entry like "https://localhost" matches any port on that host.
CORS_ALLOWLIST: list[tuple[str, str]] = []
if not CORS_ALLOW_WILDCARD and _CORS_RAW:
    for raw in _CORS_RAW.split(","):
        raw = raw.strip()
        if not raw:
            continue
        try:
            p = urllib.parse.urlparse(raw)
            if p.scheme and p.hostname:
                CORS_ALLOWLIST.append((p.scheme.lower(), p.hostname.lower()))
        except Exception:
            continue

_token_cache: dict = {"value": "", "loaded": False}
# Guards _token_cache mutation under ThreadingHTTPServer (audit fix 6).
_token_lock = threading.Lock()


def _write_token_file(tok: str) -> None:
    """Persist the bearer token with owner-only permissions from creation."""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(tok)
        f.write("\n")
    os.chmod(TOKEN_FILE, 0o600)


def ensure_token(*, log_new_token: bool = True, require_persist: bool = False) -> str:
    """Mint or load the bearer token. First-run: optionally log a redacted hint.

    When the new token cannot be written: raise OSError if `require_persist`
    (CLI rotation must not report success), otherwise serve with a RAM-only
    token and say so.
    """
    with _token_lock:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        if TOKEN_FILE.exists():
            try:
                tok = TOKEN_FILE.read_text(encoding="utf-8").strip()
                if tok:
                    _token_cache["value"] = tok
                    _token_cache["loaded"] = True
                    return tok
            except Exception as e:
                log.warning(f"Could not read existing token file: {e}")
        tok = secrets.token_urlsafe(32)
        try:
            _write_token_file(tok)
            persisted = True
        except Exception as e:
            if require_persist:
                raise OSError(f"could not write {TOKEN_FILE}: {e}") from e
            log.error(f"Failed to persist bearer token: {e} — serving with an in-memory "
                      "token that changes on restart; fix the data dir permissions")
            persisted = False
        if log_new_token:
            # Never log the full secret (journald persists it otherwise).
            log.info(
                f"Bearer token minted: {tok[:8]}… (redacted; run "
                f"`dictation-server --show-token` or read {TOKEN_FILE} for the full value)"
            )
        if persisted:
            log.info(f"Token saved to {TOKEN_FILE} (mode 0600)")
        _token_cache["value"] = tok
        _token_cache["loaded"] = True
        return tok


def get_token() -> str:
    with _token_lock:
        if _token_cache["loaded"]:
            return _token_cache["value"]
    return ensure_token()


PAIRING_CODE_TTL_SECONDS = 120
_pairing_codes: dict[str, dict] = {}
_pairing_codes_lock = threading.Lock()


def create_pairing_code(token: str, *, now: float | None = None) -> tuple[str, int]:
    """Mint a short-lived, one-use phone bootstrap code in process RAM."""
    issued_at = time.monotonic() if now is None else now
    expires_at = issued_at + PAIRING_CODE_TTL_SECONDS
    with _pairing_codes_lock:
        expired = [code for code, entry in _pairing_codes.items()
                   if entry["expires_at"] <= issued_at]
        for code in expired:
            del _pairing_codes[code]
        while True:
            code = secrets.token_urlsafe(24)
            if code not in _pairing_codes:
                break
        _pairing_codes[code] = {"expires_at": expires_at, "token": token}
    return code, PAIRING_CODE_TTL_SECONDS


def pairing_code_is_valid(code: str, *, now: float | None = None) -> bool:
    """Check whether a bootstrap code may load the phone page without consuming it."""
    if not code:
        return False
    checked_at = time.monotonic() if now is None else now
    with _pairing_codes_lock:
        entry = _pairing_codes.get(code)
        return bool(entry and entry["expires_at"] > checked_at)


def consume_pairing_code(code: str, *, now: float | None = None) -> tuple[str, str]:
    """Atomically consume a bootstrap code, returning (token, status)."""
    if not code:
        return "", "invalid"
    consumed_at = time.monotonic() if now is None else now
    with _pairing_codes_lock:
        entry = _pairing_codes.pop(code, None)
    if entry is None:
        return "", "invalid"
    if entry["expires_at"] <= consumed_at:
        return "", "expired"
    return str(entry["token"]), "ok"


def _source_is_state_chat(chat_source: str, state_chat_id: str, *, state_usable: bool) -> bool:
    """True when the effective chat source is the chat a fresh ST state names.

    No source and `auto` follow the ST tab; `type:<id>` only when `<id>` is
    the state's chatId; `manual` and any other chat never are.
    """
    if not state_usable:
        return False
    if chat_source in ("", "auto"):
        return True
    _ctype, sep, name = chat_source.partition(":")
    return bool(sep and state_chat_id and name == state_chat_id)


def _chat_id_for_source(chat_source: str, state_chat_id: str) -> str:
    """Transcript chat tag for a take: the state's chat id when the source is
    that chat (no source, `auto`, or `type:<chatId>`), else ""."""
    if not state_chat_id:
        return ""
    _ctype, sep, name = chat_source.partition(":")
    if sep:
        return state_chat_id if name == state_chat_id else ""
    return state_chat_id if chat_source in ("", "auto") else ""


_CLIENT_REQUEST_ID_RE = re.compile(r"[A-Za-z0-9_-]{16,32}")


def _request_id_from(client_value: str) -> str:
    """Client-chosen request id when well-formed, else a fresh server id."""
    if _CLIENT_REQUEST_ID_RE.fullmatch(client_value or ""):
        return client_value
    return secrets.token_urlsafe(8)


def _json_str(data: dict, key: str) -> str:
    """String field of a JSON body: missing/null → "", non-string → ValueError (400)."""
    value = data.get(key)
    if value is None:
        return ""
    if not isinstance(value, str):
        raise ValueError(f"'{key}' must be a string")
    return value


def _coerce_int(value, default: int, *, lo: int, hi: int) -> int:
    """Client-supplied integer, clamped to [lo, hi]; junk → default."""
    try:
        n = int(value) if value is not None else default
    except (TypeError, ValueError):
        n = default
    return min(max(n, lo), hi)


def clamp_request_context(text: str) -> str:
    """Bound client-supplied chat context, keeping the most recent tail."""
    text = str(text or "")
    if len(text) > REQUEST_CONTEXT_LIMIT:
        return text[-REQUEST_CONTEXT_LIMIT:]
    return text


_SENSITIVE_QUERY_NAMES = frozenset({
    "token", "pair", "access_token", "auth", "authorization", "context",
})
_QUERY_PARAM_RE = re.compile(r"([?&])([^=&\s#]*)=([^\s&#]*)")


def _redact_sensitive_url_params(text: str) -> str:
    """Redact secret- or chat-bearing query parameters before request lines reach the journal."""
    # BaseHTTPRequestHandler log lines include the raw request target, so
    # EventSource/pairing URLs such as /events?token=... otherwise persist the
    # bearer token in journalctl. `context` is covered too: current clients
    # send chat context in a header, but an older client putting it in the
    # URL must not land private chat text in the journal. Names are matched
    # after percent/plus decoding, exactly as parse_qs sees them, so
    # `?%74oken=` cannot slip past.
    def _sub(m: "re.Match[str]") -> str:
        name = urllib.parse.unquote_plus(m.group(2)).strip().lower()
        if name in _SENSITIVE_QUERY_NAMES:
            return f"{m.group(1)}{m.group(2)}=[REDACTED]"
        return m.group(0)

    return _QUERY_PARAM_RE.sub(_sub, text)


def regenerate_token(*, log_new_token: bool = True, require_persist: bool = False) -> str:
    """Rotate the bearer token unconditionally (wizard --force / rotation)."""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    with _token_lock:
        try:
            TOKEN_FILE.unlink(missing_ok=True)
        except Exception as e:
            log.warning(f"Could not remove existing token file: {e}")
        _token_cache["value"] = ""
        _token_cache["loaded"] = False
    return ensure_token(log_new_token=log_new_token, require_persist=require_persist)


def _is_loopback_address(addr: str) -> bool:
    """True for 127.0.0.0/8, ::1, and ::ffff:127.0.0.0/8 (IPv4-mapped)."""
    if not addr:
        return False
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        return False
    if ip.is_loopback:
        return True
    # IPv4-mapped IPv6 addresses (::ffff:127.0.0.1) — Python's is_loopback
    # already handles these for ip_address >= 3.10, but check defensively.
    if isinstance(ip, ipaddress.IPv6Address) and ip.ipv4_mapped is not None:
        return ip.ipv4_mapped.is_loopback
    return False


def _origin_allowed(origin: str) -> bool:
    """True if the request Origin should be echoed back."""
    if not origin:
        return False
    if CORS_ALLOW_WILDCARD:
        return True
    try:
        p = urllib.parse.urlparse(origin)
    except Exception:
        return False
    if not p.scheme or not p.hostname:
        return False
    needle = (p.scheme.lower(), p.hostname.lower())
    return needle in CORS_ALLOWLIST


def _allowed_origin_list() -> list[str]:
    """CORS allowlist as `scheme://host` strings (port-insensitive), or ["*"]."""
    if CORS_ALLOW_WILDCARD:
        return ["*"]
    return [f"{scheme}://[{host}]" if ":" in host else f"{scheme}://{host}"
            for scheme, host in CORS_ALLOWLIST]


def _frame_ancestors_csp() -> str:
    """`frame-ancestors` limited to self plus the CORS allowlist (any port)."""
    if CORS_ALLOW_WILDCARD:
        return "frame-ancestors *"
    sources = ["'self'"] + [f"{o}:*" for o in _allowed_origin_list()]
    return "frame-ancestors " + " ".join(sources)


# Static phone-shell variants, computed once per process per distinct HTML
# string: (raw bytes, gzip bytes, strong ETag).
_static_html_cache: dict[str, tuple[bytes, bytes, str]] = {}
_static_html_lock = threading.Lock()


def _static_html_variant(html: str) -> tuple[bytes, bytes, str]:
    with _static_html_lock:
        hit = _static_html_cache.get(html)
    if hit is not None:
        return hit
    raw = html.encode()
    variant = (raw, gzip.compress(raw, mtime=0),
               '"' + hashlib.sha256(raw).hexdigest()[:32] + '"')
    with _static_html_lock:
        _static_html_cache[html] = variant
    return variant


def _accepts_gzip(header: str) -> bool:
    for part in (header or "").split(","):
        coding, _, params = part.strip().partition(";")
        if coding.strip().lower() in ("gzip", "*"):
            q = params.strip().lower()
            return not (q.startswith("q=") and q[2:].strip() in ("0", "0.0", "0.00", "0.000"))
    return False


