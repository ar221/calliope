        "pipeline": list(mode.get("pipeline", [])),
    }


# ─── Phase 2: Custom vocabulary ──────────────────────────
def _normalize_vocab_entry(entry: dict) -> dict | None:
    correct = (entry.get("correct") or "").strip()
    if not correct:
        return None
    aliases_raw = entry.get("aliases") or []
    if isinstance(aliases_raw, str):
        aliases_raw = [aliases_raw]
    aliases = [str(a).strip() for a in aliases_raw if str(a).strip()]
    characters_raw = entry.get("characters") or []
    if isinstance(characters_raw, str):
        characters_raw = [characters_raw]
    characters = [str(c).strip().lower() for c in characters_raw if str(c).strip()]
    out: dict = {"correct": correct, "aliases": aliases}
    if characters:
        out["characters"] = characters
    return out


def load_vocab() -> list[dict]:
    """Load vocab with mtime-based cache. Returns list of normalized entries."""
    try:
        mtime = VOCAB_FILE.stat().st_mtime
    except FileNotFoundError:
        _ensure_default_vocab()
        try:
            mtime = VOCAB_FILE.stat().st_mtime
        except FileNotFoundError:
            return []

    with vocab_lock:
        if _vocab_cache["data"] and _vocab_cache["mtime"] == mtime:
            return _vocab_cache["data"]
        try:
            raw = VOCAB_FILE.read_bytes()
            parsed = _parse_config(raw)
            entries = []
            for e in parsed:
                if not isinstance(e, dict):
                    continue
                norm = _normalize_vocab_entry(e)
                if norm:
                    entries.append(norm)
        except Exception as e:
            log.warning(f"Failed to parse {VOCAB_FILE}: {e} — using empty list")
            entries = []
        _vocab_cache["data"] = entries
        _vocab_cache["mtime"] = mtime
        return entries


def _invalidate_vocab_cache() -> None:
    with vocab_lock:
        _vocab_cache["data"] = []
        _vocab_cache["mtime"] = 0.0


def _invalidate_modes_cache() -> None:
    with modes_lock:
        _modes_cache["data"] = []
        _modes_cache["mtime"] = 0.0


# ─── Whisper hallucination filter ────────────────────────
# Whisper is trained on YouTube subtitles, which contain end-credits text
# during silent footage. The community-curated stock-phrase list:
# https://huggingface.co/datasets/sachaarbonel/whisper-hallucinations
# Catches the dominant failure mode (silence-driven hallucination)
# without an audio-RMS gate. ADR-12, Agent 3 §4.
WHISPER_HALLUCINATIONS_EN = frozenset({
    "thanks for watching",
    "thank you for watching",
    "thank you for watching please subscribe",
    "thanks for watching please subscribe",
    "please subscribe to my channel",
    "don't forget to subscribe",
    "like and subscribe",
    "transcription by castingwords",
    "[music]", "[applause]", "[typing]", "[silence]",
    "bye", "the", "you",
})

# Single-token outputs that whisper emits on silent frames.
# We only drop these when the WHOLE output is a degenerate repetition.
SINGLE_TOKEN_DEGENERATES = frozenset({
    "bye", "the", "you", "thanks", "thank you",
})


def hallucination_filter(text: str) -> tuple[str, bool, str]:
    """Drop Whisper stock hallucinations. Returns (text, was_dropped, reason).

    On drop, returns empty text — `run_pipeline` short-circuits subsequent
    steps. The frontend treats empty results as a no-op.
    """
    if not text:
        return text, False, ""
    norm = re.sub(r"[^\w\s]", "", text).strip().lower()
    if not norm:
        return text, False, ""
    if norm in WHISPER_HALLUCINATIONS_EN:
        return "", True, f"matched stock hallucination: {norm!r}"
    tokens = norm.split()
    # Repeated-single-token degenerate (e.g. "you you you you")
    if (len(tokens) >= 3
            and len(set(tokens)) == 1
            and tokens[0] in SINGLE_TOKEN_DEGENERATES):
        return "", True, f"degenerate repetition of {tokens[0]!r}"
    # Substring containment for the longer phrases (>=80% tokens of utterance)
    for phrase in WHISPER_HALLUCINATIONS_EN:
        if " " not in phrase:
            continue
        if phrase in norm:
            ratio = len(phrase.split()) / max(1, len(tokens))
            if ratio >= 0.8:
                return "", True, f"contains stock phrase {phrase!r}"
    return text, False, ""


# ─── Phase 5 / POL-1 — Voice command grammar ─────────────
# A regex pre-pass on the raw whisper output (runs in-pipeline AFTER
# `hallucination_filter`, BEFORE `vocab_correct`). Sentinel-prefixed
# utterances (`computer: ...`, `hey computer ...`) match a small set
# of intent verbs and emit a `dictation-command` SSE event.
#
# The frontends (ST extension, phone PWA) translate intents to UI
# actions: `send` → click `#send_but`, `swipe` → click `.mes_swipe_right`,
# etc. The server only classifies + routes; it never fires DOM clicks.
#
# Two sentinels live separately:
#   1. The voice command sentinel ("computer" by default), routed through
#      `command_dispatch` as a pipeline step.
#   2. The legacy `OOC:` / `out of character` ST convention: detected in
#      `_handle_transcribe` BEFORE the pipeline runs (because it forces a
#      mode override to `grammar_clean`). See `OOC_PREFIX_RE` below.
#
# Reference: ADR-11, Agent 3 §3, docs/roadmap.md (POL-1).

# Hardcoded fallback sentinel + intent grammar. User override via
# voice_macros.yaml is hot-reloadable (mtime cache, mirrors load_modes).
DEFAULT_VOICE_SENTINEL = "computer"

# Each entry: {phrase: [aliases], intent: <name>, args: <static dict>,
#              args_after?: <key>}. `args_after`, when set, captures any
# trailing residual after the matched phrase into `args[<key>]` and
# clears the residual (e.g. `computer regen polish for clarity` →
# intent=regenerate, args={hint: "polish for clarity"}, residual="").
DEFAULT_VOICE_INTENTS: list[dict] = [
    {"phrase": ["send"], "intent": "send"},
    {"phrase": ["swipe right", "next swipe", "swipe next"],
     "intent": "swipe", "args": {"direction": "right"}},
    {"phrase": ["swipe left", "previous swipe", "swipe prev",
                "swipe previous"],
     "intent": "swipe", "args": {"direction": "left"}},
    {"phrase": ["swipe"], "intent": "swipe", "args": {"direction": "right"}},
    {"phrase": ["regenerate", "regen"], "intent": "regenerate"},
    {"phrase": ["delete that", "delete last"], "intent": "delete_last"},
    {"phrase": ["scratch that", "undo"], "intent": "undo"},
    {"phrase": ["new paragraph"], "intent": "new_paragraph"},
    {"phrase": ["scene break"], "intent": "scene_break"},
    {"phrase": ["stop", "cancel"], "intent": "stop"},
    {"phrase": ["clear"], "intent": "clear"},
    {"phrase": ["append"], "intent": "append"},
    {"phrase": ["replace"], "intent": "replace"},
]

# Pure-command intents short-circuit the pipeline (residual ignored).
# Mixed intents (`append`, `replace`) keep residual flowing to vocab/format.
PURE_COMMAND_INTENTS = frozenset({
    "send", "swipe", "regenerate", "delete_last", "undo",
    "new_paragraph", "scene_break", "stop", "clear",
})

# Hot-reloadable voice macros cache (mtime-based, mirrors load_vocab).
_voice_macros_cache: dict = {
    "data": {"sentinel": DEFAULT_VOICE_SENTINEL,
             "intents": list(DEFAULT_VOICE_INTENTS),
             "regex": None},
    "mtime": 0.0,
}
voice_macros_lock = threading.Lock()

# Module-level seed regex (the spec's "always-available" grammar). Used
# when no voice_macros.yaml file is present and the user hasn't customised
# the sentinel.
COMMAND_RE = re.compile(
    r"^\s*(?:computer|hey computer)[\s,:.]+"
    r"(send|swipe(?:\s+(?:left|right|next|prev))?|regenerate|"
    r"delete that|delete last|new paragraph|scene break|stop|cancel|"
    r"scratch that|clear|append|replace|undo)\b",
    re.IGNORECASE,
)

# Backwards-compat: SillyTavern's OOC convention. Detected separately in
# `_handle_transcribe` so it can flip the mode override to grammar_clean.
OOC_PREFIX_RE = re.compile(
    r"^\s*(?:OOC|out[\s\-]of[\s\-]character)[\s:.]+",
    re.IGNORECASE,
)


def _build_voice_macros_regex(sentinel: str, intents: list[dict]) -> re.Pattern:
    """Compile a sentinel + alternation regex from intent definitions.

    Returns a regex with two capture groups: (1) the matched phrase
    (lowercase-comparable) and (2) the original (untouched) text after
    the sentinel boundary, used for trailing-residual capture.
    """
    sentinel_alts = [re.escape(sentinel.strip())]
    sentinel_alts.append(re.escape(f"hey {sentinel.strip()}"))
    sentinel_pat = "(?:" + "|".join(sentinel_alts) + ")"

    # Sort longest first so multi-word phrases match before their
    # single-word prefixes (e.g. "swipe right" before "swipe").
    all_phrases: list[str] = []
    for entry in intents:
        for p in entry.get("phrase", []) or []:
            if isinstance(p, str) and p.strip():
                all_phrases.append(p.strip())
    all_phrases.sort(key=lambda p: -len(p))
    if not all_phrases:
        all_phrases = ["send"]
    phrase_alts = "|".join(re.escape(p) for p in all_phrases)

    return re.compile(
        rf"^\s*{sentinel_pat}[\s,:.]+({phrase_alts})\b",
        re.IGNORECASE,
    )


def _ensure_voice_macros_compiled(state: dict) -> dict:
    """Populate state['regex'] in-place if missing. Pure setup helper."""
    if state.get("regex") is None:
        state["regex"] = _build_voice_macros_regex(
            state.get("sentinel", DEFAULT_VOICE_SENTINEL),
            state.get("intents", DEFAULT_VOICE_INTENTS),
        )
    return state


def load_voice_macros() -> dict:
    """Return current voice-macro config: {sentinel, intents, regex}.

    Hot-reloads when VOICE_MACROS_FILE mtime changes. Falls back to
    DEFAULT_VOICE_SENTINEL + DEFAULT_VOICE_INTENTS if file is absent or
    malformed.
    """
    try:
        mtime = VOICE_MACROS_FILE.stat().st_mtime
    except FileNotFoundError:
        with voice_macros_lock:
            if _voice_macros_cache["mtime"] != 0.0 or _voice_macros_cache["data"].get("regex") is None:
                _voice_macros_cache["data"] = {
                    "sentinel": DEFAULT_VOICE_SENTINEL,
                    "intents": list(DEFAULT_VOICE_INTENTS),
                    "regex": None,
                }
                _voice_macros_cache["mtime"] = 0.0
            return _ensure_voice_macros_compiled(_voice_macros_cache["data"])

    with voice_macros_lock:
        if _voice_macros_cache["data"].get("regex") is not None and _voice_macros_cache["mtime"] == mtime:
            return _voice_macros_cache["data"]
        try:
            raw = VOICE_MACROS_FILE.read_bytes()
            if _HAVE_YAML:
                parsed = yaml.safe_load(raw) if raw.strip() else {}
            else:
                parsed = json.loads(raw) if raw.strip() else {}
            if not isinstance(parsed, dict):
                raise ValueError(f"Expected mapping at top of {VOICE_MACROS_FILE}")
            sentinel = str(parsed.get("sentinel") or DEFAULT_VOICE_SENTINEL).strip() \
                or DEFAULT_VOICE_SENTINEL
            raw_intents = parsed.get("intents") or []
            normalized: list[dict] = []
            if isinstance(raw_intents, list):
                for entry in raw_intents:
                    if not isinstance(entry, dict):
                        continue
                    phrases = entry.get("phrase") or []
                    if isinstance(phrases, str):
                        phrases = [phrases]
                    if not phrases:
                        continue
                    intent_name = str(entry.get("intent") or "").strip()
                    if not intent_name:
                        continue
                    norm: dict = {
                        "phrase": [str(p).strip() for p in phrases if str(p).strip()],
                        "intent": intent_name,
                    }
                    if isinstance(entry.get("args"), dict):
                        norm["args"] = dict(entry["args"])
                    if entry.get("args_after"):
                        norm["args_after"] = str(entry["args_after"]).strip()
                    if norm["phrase"]:
                        normalized.append(norm)
            if not normalized:
                normalized = list(DEFAULT_VOICE_INTENTS)
            data = {
                "sentinel": sentinel,
                "intents": normalized,
                "regex": _build_voice_macros_regex(sentinel, normalized),
            }
        except Exception as e:
            log.warning(f"Failed to parse {VOICE_MACROS_FILE}: {e} — falling back to defaults")
            data = {
                "sentinel": DEFAULT_VOICE_SENTINEL,
                "intents": list(DEFAULT_VOICE_INTENTS),
                "regex": _build_voice_macros_regex(
                    DEFAULT_VOICE_SENTINEL, DEFAULT_VOICE_INTENTS,
                ),
            }
        _voice_macros_cache["data"] = data
        _voice_macros_cache["mtime"] = mtime
        return data


def command_dispatch(text: str) -> tuple[str, dict | None]:
    """Pre-pass: detect a sentinel-prefixed voice command in `text`.

    Returns (residual_text, command_dict_or_None).
      - `command_dict` shape: {intent: str, args: dict, source_text: str,
                                phrase: str}. None when no command is found.
      - `residual_text`: text remaining AFTER the matched command phrase.
        Empty string for pure-command utterances. Falls through to the
        rest of the pipeline as content for `append` / `replace` etc.

    Sentinel + grammar are user-customisable via VOICE_MACROS_FILE; the
    module-level `COMMAND_RE` constant remains the seed/fallback when
    no override exists (see Agent 3 §3).
    """
    if not text:
        return text, None
    cfg = load_voice_macros()
    rx: re.Pattern = cfg.get("regex") or COMMAND_RE
    m = rx.match(text)
    if not m:
        return text, None
    matched_phrase = m.group(1).strip().lower()
    residual = text[m.end():].strip()
    # Strip trailing punctuation/whitespace that whisper appends to a
    # short utterance (e.g. "Computer, send.") — leave content intact when
    # there is real text after a sentence break.
    residual = re.sub(r"^[\s,.;:!?]+", "", residual)
    residual = re.sub(r"^[\s,.;:!?]+$", "", residual)

    # Resolve intent + static args by matching against the configured table.
    intents = cfg.get("intents") or DEFAULT_VOICE_INTENTS
    chosen: dict | None = None
    for entry in intents:
        phrases_lc = [p.lower() for p in entry.get("phrase", [])]
        # Compare against the longest matching phrase the regex captured.
        # Regex alternation prefers earlier alternatives; we pre-sorted by
        # length when building the pattern, so an exact lookup suffices.
        if matched_phrase in phrases_lc:
            chosen = entry
            break
    if chosen is None:
        # Fallback: use the matched phrase itself as the intent name.
        chosen = {"intent": matched_phrase.replace(" ", "_"), "args": {}}

    args: dict = dict(chosen.get("args") or {})
    if chosen.get("args_after") and residual:
        args[chosen["args_after"]] = residual
        residual = ""

    cmd = {
        "intent": chosen.get("intent", matched_phrase.replace(" ", "_")),
        "args": args,
        "source_text": text,
        "phrase": matched_phrase,
    }
    return residual, cmd


def _invalidate_voice_macros_cache() -> None:
    with voice_macros_lock:
        _voice_macros_cache["data"] = {
            "sentinel": DEFAULT_VOICE_SENTINEL,
            "intents": list(DEFAULT_VOICE_INTENTS),
            "regex": None,
        }
        _voice_macros_cache["mtime"] = 0.0


def _applies_to_character(entry: dict, character_id: str) -> bool:
    """Vocab entry's optional `characters` scope check (case-insensitive)."""
    chars = entry.get("characters") or []
    if not chars:
        return True
    cid = (character_id or "").lower()
    if not cid:
        return False
    return cid in chars


def vocab_correct(text: str, character_id: str = "") -> str:
    """Apply vocab corrections: exact alias replacement + fuzzy word-level pass.

    Pass 2 fuzzy is gated to prevent silent corruption of common English
    words near short character names (Agent 3 §6, ADR-10):
      - skip tokens shorter than VOCAB_FUZZY_MIN_LEN (4)
      - skip tokens that already match a correct form exactly
      - skip tokens in the top-N English frequency list
      - cap total fuzzy hits at VOCAB_FUZZY_MAX_HITS_PER_UTT (2)
      - require difflib ratio >= VOCAB_FUZZY_CUTOFF (0.84)
    """
    if not text:
        return text
    entries = load_vocab()
    if not entries:
        return text

    applicable = [e for e in entries if _applies_to_character(e, character_id)]
    if not applicable:
        return text

    # Pass 1: exact alias replacement (case-insensitive word-boundary).
    for entry in applicable:
        correct = entry["correct"]
        for alias in entry.get("aliases", []):
            if not alias:
                continue
            pattern = r"\b" + re.escape(alias) + r"\b"
            try:
                text = re.sub(pattern, correct, text, flags=re.IGNORECASE)
            except re.error:
                continue

    # Pass 2: difflib fuzzy per token, with the four-gate cascade.
    correct_forms = [e["correct"] for e in applicable]
    correct_forms_lower = {c.lower() for c in correct_forms}
    candidates = [c for c in correct_forms if " " not in c]
    fuzzy_hits = 0

    def _sub_token(match: re.Match) -> str:
        nonlocal fuzzy_hits
        token = match.group(0)
        if len(token) < VOCAB_FUZZY_MIN_LEN:
            return token
        tl = token.lower()
        if tl in correct_forms_lower:
            return token
        # Never silently rewrite common English words into name lookalikes.
        if tl in COMMON_EN_WORDS:
            return token
        if fuzzy_hits >= VOCAB_FUZZY_MAX_HITS_PER_UTT:
            return token
        if not candidates:
            return token
        matches = difflib.get_close_matches(
            token, candidates, n=1, cutoff=VOCAB_FUZZY_CUTOFF,
        )
        if matches:
            fuzzy_hits += 1
            return matches[0]
        return token

    # Token = contiguous word chars plus apostrophe (so "Kael'thas" stays whole)
    text = re.sub(r"[A-Za-z][A-Za-z'\-]*", _sub_token, text)
    return text


def _vocab_correct_forms(character_id: str = "") -> list[str]:
    """Return the list of `correct` forms applicable to `character_id`.

    Helper shared by `vocab_correct` (for fuzzy candidates) and the POL-3
    "did you mean?" alternatives generator. Single-word forms only —
    multi-word entries can't be drop-in word replacements.
    """
    entries = load_vocab()
    applicable = [e for e in entries if _applies_to_character(e, character_id)]
    return [e["correct"] for e in applicable if " " not in e["correct"]]


def compute_low_confidence_spans(
    text: str,
    word_confidences: list[dict],
    character_id: str = "",
    threshold: float | None = None,
) -> list[dict]:
    """Tag words with logprob below threshold and attach vocab alternatives.

    POL-3 / Agent 6 §3.3 — "Did you mean?" overlay. Threshold defaults to
    `WORD_CONFIDENCE_THRESHOLD` (env-tunable). Returns a list of
    `{word, start_idx, end_idx, confidence, logprob, alternatives}` dicts
    suitable for embedding in the /transcribe JSON response.

    `start_idx`/`end_idx` are character offsets into `text`. Indexes are
    best-effort: whisper word boundaries don't always survive vocab
    rewrites, so we resolve via case-insensitive search starting from the
    last-matched offset. Words we can't locate get `start_idx == -1` and
    a `text_only` flag so the UI can skip the highlight overlay but still
    surface alternatives in a list view.

    Alternatives are pulled from the user vocab (cheap fuzzy match,
    `difflib.get_close_matches(cutoff=0.5, n=3)`). LLM-repair tier is
    future work — see /word-alternatives endpoint for the public surface.
    """
    if not text or not word_confidences:
        return []
    thr = WORD_CONFIDENCE_THRESHOLD if threshold is None else threshold
    vocab_forms = _vocab_correct_forms(character_id)
    spans: list[dict] = []
    cursor = 0
    text_lower = text.lower()
    for entry in word_confidences:
        if len(spans) >= WORD_CONFIDENCE_MAX_SPANS:
            break
        if not isinstance(entry, dict):
            continue
        word = str(entry.get("word", "")).strip()
        if not word:
            continue
        # Strip whisper's leading-space convention before length-gating.
        clean_word = word.strip(" \t\n.,;:!?'\"")
        if len(clean_word) < WORD_CONFIDENCE_MIN_LEN:
            continue
        logprob = entry.get("logprob")
        if logprob is None:
            confidence = float(entry.get("confidence", 0.0) or 0.0)
            if confidence <= 0.0:
                continue
            import math
            logprob = math.log(confidence)
        try:
            logprob = float(logprob)
        except (TypeError, ValueError):
            continue
        if logprob >= thr:
            continue
        # Locate the word in `text` from the running cursor; fall back to
        # absolute search if the cursored attempt misses (vocab rewrites
        # can shift offsets between whisper's output and `text`).
        idx = text_lower.find(clean_word.lower(), cursor)
        if idx < 0:
            idx = text_lower.find(clean_word.lower())
        start_idx = idx
        end_idx = idx + len(clean_word) if idx >= 0 else -1
        if idx >= 0:
            cursor = end_idx
        alternatives = []
        if vocab_forms:
            alternatives = difflib.get_close_matches(
                clean_word, vocab_forms, n=3, cutoff=0.5,
            )
        span: dict = {
            "word": clean_word,
            "start_idx": start_idx,
            "end_idx": end_idx,
            "confidence": float(entry.get("confidence", 0.0) or 0.0),
            "logprob": logprob,
            "alternatives": list(alternatives),
        }
        if start_idx < 0:
            span["text_only"] = True
        spans.append(span)
    return spans


def word_alternatives(
    word: str,
    context: str = "",
    character_id: str = "",
    n: int = 3,
    cutoff: float = 0.5,
) -> list[dict]:
    """Cheap "did you mean?" alternative generator (POL-3 v1).

    v1 implementation: vocab fallback only. Each alternative carries
    `{text, score, source}` where `source` is `"vocab"`. Future tiers
    (re-decode candidates, LLM repair) attach `source: "context"` /
    `source: "llm"` and merge into the same list.
    """
    if not word:
        return []
    vocab_forms = _vocab_correct_forms(character_id)
    if not vocab_forms:
        return []
    matches = difflib.get_close_matches(word, vocab_forms, n=n, cutoff=cutoff)
    out: list[dict] = []
    for m in matches:
        score = difflib.SequenceMatcher(None, word.lower(), m.lower()).ratio()
        out.append({"text": m, "score": round(score, 3), "source": "vocab"})
    return out


def build_whisper_prompt(character_id: str = "") -> str:
    """Build a comma-separated prompt for whisper-cli --prompt from vocab."""
    entries = load_vocab()
    if not entries:
        return ""
    applicable = [e for e in entries if _applies_to_character(e, character_id)]
    if not applicable:
        return ""
    forms: list[str] = []
    for e in applicable:
        forms.append(e["correct"])
    prompt = ", ".join(forms)
    # Truncate to ~WHISPER_PROMPT_TOKEN_CAP words (proxy for tokens).
    words = prompt.split()
    if len(words) > WHISPER_PROMPT_TOKEN_CAP:
        prompt = " ".join(words[:WHISPER_PROMPT_TOKEN_CAP])
    return prompt


# ─── Phase 2: Pipeline runner ────────────────────────────
def _build_persona_pov_prompt(persona: dict, character: dict, chat_context: str,
                              scene_continuity: str = "",
                              scene_contract: dict | None = None) -> tuple[str, str]:
    """Build the (system_prompt, user_content) pair for persona_pov mode."""
    persona_name = persona.get("name", "the persona")
    character_name = character.get("name", "the character")

    sections: list[str] = []
    sections.append(f"You are writing in first-person as {persona_name}.")
    desc = (persona.get("description") or "").strip()
    if desc:
        sections.append(desc)
    sections.append(f"You are addressing {character_name}.")
    char_card = (character.get("card") or "").strip()
    if char_card:
        sections.append(char_card)
    contract_prompt = scene_contract_prompt(scene_contract)
    if contract_prompt:
        sections.append(contract_prompt)
    elif scene_continuity.strip():
        sections.append(
            "Current scene continuity from SillyTavern tracker:\n"
            + scene_continuity.strip()[:2000]
            + "\nRespect these visual/spatial facts. Do not restate them unless relevant."
        )
    if chat_context:
        sections.append("Recent chat log:\n" + chat_context)
    sections.append(
        f"The user dictated the following line. Rewrite it as {persona_name} would say it, "
        f"addressing {character_name}, consistent with the tone of the ongoing chat. "
        f"Do NOT respond as {character_name}. Only polish what was dictated. "
        f"Preserve intent exactly. Output only the rewrite."
        + FORMATTER_OUTPUT_CONTRACT
    )
    sections.append(
        "Voice tuning examples:\n"
        "Input: i missed you so much\n"
        "Output: I missed you so much.\n"
        "Input: come here and kiss me\n"
        "Output: Come here and kiss me.\n"
        "Keep the persona's cadence, but stay close to the dictated words. "
        "Do not add extra actions, reactions, or new scene detail."
    )
    system_prompt = "\n\n".join(sections)
    return system_prompt, ""


def build_repair_trace(raw: str, cleaned: str = "", final: str = "") -> dict:
    """POL-17: expose raw→cleaned→final repair state without persistence.

    The returned object is intentionally safe to ship to transient clients and
    SSE consumers. It is not appended to `session_transcript`, not written to
    vocab, and carries an explicit persistence marker so UI code can distinguish
    in-RAM repair review from user-accepted vocabulary.
    """
    raw = str(raw or "")
    cleaned = str(cleaned or "")
    final = str(final or "")
    stages: list[str] = []
    if raw:
        stages.append("raw")
    if cleaned and cleaned != raw:
        stages.append("cleaned")
    baseline = cleaned or raw
    if final and final != baseline:
        stages.append("final")
    return {
        "raw": raw,
        "cleaned": cleaned,
        "final": final,
        "stages": stages,
        "has_changes": bool((cleaned and cleaned != raw) or (final and final != baseline)),
        "persistence": "in_ram_only",
    }


def run_pipeline(text: str, mode: dict,
                 context: str = "",
                 persona_id: str = "",
                 character_id: str = "",
                 chat_context: str = "",
                 scene_continuity: str = "",
                 scene_contract: dict | None = None,
                 use_rules: bool = False,
                 prose_format: bool = False,
                 provider: str = DEFAULT_FORMATTER_PROVIDER,
                 request_id: str = "",
                 timing: dict | None = None) -> tuple[str, bool, str, str]:
    """Run the pipeline steps of `mode` over `text`.

    Returns (text, skipped, reason, cleaned_text).
    `skipped` signals that the LLM-polish stage did not happen (frontend shows toast);
    vocab_correct and disfluency_clean are pre-processors and do not count as "skipping".
    `cleaned_text` is the post-disfluency-clean intermediate (empty string if cleanup
    was not part of the pipeline, skipped, or passed through unchanged).

    `timing` (POL-16): if provided, after each step we set
    `timing[f"step_{step}"] = time.monotonic()`. Caller post-processes the dict
    into a single JSON log line. Pure side-channel; never affects pipeline output.

    `request_id` (MVP-13 + MVP-16): when non-empty, we additionally broadcast
    `dictation-state` SSE events at every step boundary. The ST extension
    state-machine bar (rendered above #send_textarea) keys off these.
    """
    # MVP-16 — pipeline step → user-visible state name. Several backend steps
    # collapse to one bar segment ("formatting" covers rp_format / rp_enhance
    # / persona_pov; cleaning splits per-step). Phone-side `listening` is
    # owned by the recorder; server emits the rest.
    _STEP_TO_STATE = {
        "hallucination_filter": "hallucination_check",
        "command_dispatch": "command_dispatch",
        "vocab_correct": "vocab_correct",
        "disfluency_clean": "cleaning_disfluency",
        "grammar_clean": "cleaning_grammar",
        "rp_format": "formatting",
        "rp_enhance": "formatting",
        "persona_pov": "formatting",
    }

    def _emit_state(state: str) -> None:
        if not request_id:
            return
        try:
            broadcast_event("dictation-state", {
                "requestId": request_id,
                "state": state,
                "ts": time.time(),
            })
        except Exception as _e:  # pragma: no cover — best-effort SSE
            log.debug("dictation-state emit failed: %s", _e)

    pipeline = [step for step in mode.get("pipeline", []) if step != "whisper"]
    if not pipeline:
        # Plain mode — no pipeline transitions to broadcast.
        return text, False, "", ""

    out = text
    provider = normalize_formatter_provider(provider)
    # Fresh attribution slot for this pipeline run. A formatter/cleanup step
    # records the winning model into it; steps that never call the LLM leave
    # it empty (plain mode, or a pure vocab/hallucination pass).
    reset_model_attribution()
    if scene_contract is None:
        scene_contract = build_scene_contract(
            snapshot_state(),
            persona_id=persona_id,
            character_id=character_id,
            chat_context=chat_context,
            scene_continuity=scene_continuity,
        )
    cleaned_text = ""
    formatting_skipped = False
    formatting_reason = ""

    for step in pipeline:
        _emit_state(_STEP_TO_STATE.get(step, step))
        if step == "hallucination_filter":
            out, was_dropped, reason = hallucination_filter(out)
            if timing is not None:
                timing[f"step_{step}"] = time.monotonic()
            if was_dropped:
                log.info("hallucination_filter: dropped utterance — %s", reason)
                # Short-circuit: empty text signals the frontend to no-op.
                return "", False, f"hallucination filter dropped: {reason}", ""
            continue

        if step == "command_dispatch":
            # POL-1 — sentinel-prefixed voice command pre-pass.
            # On match: broadcast a `dictation-command` SSE event and either
            # short-circuit (pure intents) or keep the residual flowing as
            # content (mixed intents like `append` / `replace`).
            residual, cmd = command_dispatch(out)
            if timing is not None:
                timing[f"step_{step}"] = time.monotonic()
            if cmd is None:
                continue
            try:
                broadcast_event("dictation-command", {
                    "requestId": request_id,
                    "intent": cmd["intent"],
                    "args": cmd.get("args", {}),
                    "source_text": cmd.get("source_text", out),
                    "residual": residual,
                    "ts": time.time(),
                })
            except Exception as _e:  # pragma: no cover — best-effort SSE
                log.debug("dictation-command emit failed: %s", _e)
            log.info("command_dispatch: intent=%s residual=%r",
                     cmd["intent"], residual[:60])
            if cmd["intent"] in PURE_COMMAND_INTENTS:
                # Pure command — drop the text; downstream pipeline is bypassed.
                # Frontends consume the SSE event for the actual UI action.
                return "", False, f"voice command: {cmd['intent']}", ""
            # Mixed intent (append, replace, …) — keep residual as content.
            out = residual
            if not out:
                # No content to flow through; skip remaining steps gracefully.
                return "", False, f"voice command: {cmd['intent']} (empty residual)", ""
            continue

        if step == "vocab_correct":
            out = vocab_correct(out, character_id=character_id)
            if timing is not None:
                timing[f"step_{step}"] = time.monotonic()
            continue

        if step == "disfluency_clean":
            cleaned, was_cleaned, reason = disfluency_clean(out, provider=provider)
            if was_cleaned and cleaned != out:
                cleaned_text = cleaned
                out = cleaned
            if timing is not None:
                timing[f"step_{step}"] = time.monotonic()
            # Non-blocking: failures here never abort the pipeline; just pass through.
            continue

        if step == "grammar_clean":
            system = mode.get("system_prompt") or GRAMMAR_CLEAN_SYSTEM
            user_content = f"Raw dictated speech:\n{out}"
            out, skipped, reason = format_rp(
                out,
                mode=1,
                system_prompt_override=system,
                endpoint_override="/v1/messages",
                skip_persona_character=True,
                user_content_override=user_content,
                temperature=mode.get("temperature"),
                provider=provider,
            )
            if skipped:
                formatting_skipped = True
                formatting_reason = reason
            if timing is not None:
                timing[f"step_{step}"] = time.monotonic()
            continue

        if step == "rp_format":
            system = mode.get("system_prompt") or ""
            out, skipped, reason = format_rp(
                out, mode=1, context=context,
                persona_id=persona_id if mode.get("use_persona") else "",
                use_rules=use_rules,
                prose_format=prose_format,
                character_id=character_id if mode.get("use_character") else "",
                chat_context=chat_context if mode.get("use_chat_context") else "",
                scene_continuity=scene_continuity,
                scene_contract=scene_contract,
                system_prompt_override=system,
                endpoint_override="/v1/messages",
                temperature=mode.get("temperature"),
                provider=provider,
            )
            if skipped:
                formatting_skipped = True
                formatting_reason = reason
            if timing is not None:
                timing[f"step_{step}"] = time.monotonic()
            continue

        if step == "rp_enhance":
            system = mode.get("system_prompt") or ""
            endpoint = "/v1/pyrite/messages" if mode.get("preset") == "pyrite" else "/v1/messages"
            out, skipped, reason = format_rp(
                out, mode=2, context=context,
                persona_id=persona_id if mode.get("use_persona") else "",
                use_rules=use_rules or bool(mode.get("use_rules")),
                prose_format=prose_format,
                character_id=character_id if mode.get("use_character") else "",
                chat_context=chat_context if mode.get("use_chat_context") else "",
                scene_continuity=scene_continuity,
                scene_contract=scene_contract,
                system_prompt_override=system,
                endpoint_override=endpoint,
                temperature=mode.get("temperature"),
                provider=provider,
                request_id=request_id,  # MVP-13 — stream deltas via SSE
            )
            if skipped:
                formatting_skipped = True
                formatting_reason = reason
            if timing is not None:
                timing[f"step_{step}"] = time.monotonic()
            continue

        if step == "persona_pov":
            # Requires both persona + character; otherwise fall back to rp_enhance.
            persona = load_persona_full(persona_id) if persona_id and persona_id != "none" else {}
            char_card_text = build_character_context(character_id) if character_id and character_id != "none" else ""
            card = load_character_card(character_id) if character_id and character_id != "none" else {}
            char_name = card.get("name", character_id) if card else character_id
            if not persona or not char_card_text:
                log.info("persona_pov missing persona or character — falling back to rp_enhance")
                out, skipped, reason = format_rp(
                    out, mode=2, context=context,
                    persona_id=persona_id, use_rules=use_rules,
                    prose_format=prose_format,
                    character_id=character_id,
                    chat_context=chat_context,
                    scene_continuity=scene_continuity,
                    scene_contract=scene_contract,
                    temperature=mode.get("temperature"),
                    provider=provider,
                    request_id=request_id,  # MVP-13
                )
                fb_reason = "persona_pov requires both persona and character; fell back to rp_enhance"
                if skipped:
                    formatting_skipped = True
                    formatting_reason = fb_reason + f"; {reason}"
                else:
                    formatting_skipped = True  # signal the fallback happened
                    formatting_reason = fb_reason
                if timing is not None:
                    timing[f"step_{step}"] = time.monotonic()
                continue

            character = {"name": char_name, "card": char_card_text}
            system_prompt, _unused_user_override = _build_persona_pov_prompt(
                persona, character, chat_context, scene_continuity, scene_contract,
            )
            user_content = f"The dictated line:\n{out}"
            endpoint = "/v1/pyrite/messages" if mode.get("preset") == "pyrite" else "/v1/messages"
            out, skipped, reason = format_rp(
                out, mode=2,
                system_prompt_override=system_prompt,
                endpoint_override=endpoint,
                skip_persona_character=True,
                user_content_override=user_content,
                temperature=mode.get("temperature"),
                provider=provider,
                request_id=request_id,  # MVP-13
            )
            if skipped:
                formatting_skipped = True
                formatting_reason = reason
            if timing is not None:
                timing[f"step_{step}"] = time.monotonic()
            continue

        log.warning(f"Unknown pipeline step '{step}' — skipping")

    return out, formatting_skipped, formatting_reason, cleaned_text



# ─── HTTP Handler ─────────────────────────────────────────
# Endpoints exempt from bearer-token auth (still loopback-bypassed).
# NOTE (2026-07 audit): `/` and `/health` remain reachable without auth so the
# phone pairing bootstrap keeps working, but their *content* is gated inside
# do_GET — non-loopback callers without a valid token get a minimal pairing
# page / minimal health payload (see _serve_root / _health_payload).
_AUTH_EXEMPT_PATHS = frozenset({
    "/",                # Embedded phone UI HTML — bootstrap surface;
                        # JS wraps fetch/EventSource to attach token from
                        # ?token= query or sessionStorage on every API call.
    "/health",
    "/manifest.json",
})



def _is_icon_path(path: str) -> bool:
    """Match `/icon-*.png` PWA icon endpoints (no handler exists yet)."""
    return path.startswith("/icon-") and path.endswith(".png")


class DictationHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        log.info(_redact_sensitive_url_params(fmt % args))

    def handle_one_request(self):
        """Override to demote the benign mobile-browser TLS EOF spam.

        Mobile browsers (Samsung Internet, Chrome Android) close TCP
        sockets without sending a TLS close_notify when the tab
        backgrounds or the screen locks during /events SSE. RFC 8446
        §6.1 makes close_notify optional, but Python's _ssl.c raises
        UNEXPECTED_EOF_WHILE_READING regardless. Agent 5 §6 / ADR-18.
        """
        try:
            super().handle_one_request()
        except ssl.SSLError as e:
            if "UNEXPECTED_EOF_WHILE_READING" in str(e):
                log.debug(
                    "Client closed without TLS close_notify (benign): %s",
                    self.client_address,
                )
                return
            raise
        except (BrokenPipeError, ConnectionResetError) as e:
            log.debug(
                "Client disconnected before response completed (benign): %s (%s)",
                self.client_address,
                e.__class__.__name__,
            )
            return

    def _client_addr(self) -> str:
        try:
            return self.client_address[0]
        except Exception:
            return ""

    def _set_cors_origin(self) -> None:
        """Echo the request Origin if it's in the allowlist; otherwise no header."""
        origin = self.headers.get("Origin", "")
        if CORS_ALLOW_WILDCARD:
            self.send_header("Access-Control-Allow-Origin", "*")
            return
        if _origin_allowed(origin):
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Vary", "Origin")

    def _request_is_privileged(self) -> bool:
        """Loopback client OR request carrying a valid bearer/query token.

        Used to gate the *content* of the auth-exempt endpoints (`/`,
        `/health`): they stay reachable for the pairing bootstrap, but
        non-loopback callers without the token only get minimal responses.
        """
        if _is_loopback_address(self._client_addr()):
            return True
        tok = get_token()
        auth = self.headers.get("Authorization", "")
        if auth.startswith("Bearer "):
            presented = auth[len("Bearer "):].strip()
            if _token_matches(presented, tok):
                return True
        parsed = urllib.parse.urlparse(self.path)
        qtok = urllib.parse.parse_qs(parsed.query).get("token", [""])[0]
        if _token_matches(qtok, tok):
            return True
        return False

    def require_auth(self) -> bool:
        """Gate every request unless loopback or exempt endpoint.

        Returns True if the request may proceed; on False the handler must
        stop (response already sent).
        """
        # Loopback bypass
        if _is_loopback_address(self._client_addr()):
            return True
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        # Exempt endpoints
        if path in _AUTH_EXEMPT_PATHS or _is_icon_path(path):
            return True
        # OPTIONS preflight handled separately (no auth needed for CORS probes)
        if self.command == "OPTIONS":
            return True
        # SSE (/events) and pairing (/pair) accept ?token=<token> via query
        # param: browser EventSource cannot set headers, and the QR pairing
        # flow naturally encodes the token in the URL.
        # TODO: revisit query-param auth once we support a secure cookie flow.
        if path in ("/events", "/pair"):
            qs = urllib.parse.parse_qs(parsed.query)
            qtok = qs.get("token", [""])[0]
            if _token_matches(qtok, get_token()):
                return True
            # Header-bearer fall-through is allowed for /pair (phone may
            # send Authorization: Bearer instead of ?token=).
            if path == "/pair":
                auth = self.headers.get("Authorization", "")
                if auth.startswith("Bearer "):
                    presented = auth[len("Bearer "):].strip()
                    if _token_matches(presented, get_token()):
                        return True
            self._send_unauthorized("token required (query param or Bearer header)")
            return False
        # Bearer header
        auth = self.headers.get("Authorization", "")
        if auth.startswith("Bearer "):
            presented = auth[len("Bearer "):].strip()
            if _token_matches(presented, get_token()):
                return True
        self._send_unauthorized("bearer token required")
        return False

    def _send_unauthorized(self, reason: str) -> None:
        body = json.dumps({"error": reason, "code": "unauthorized"}).encode()
        self.send_response(401)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("WWW-Authenticate", "Bearer")
        self._set_cors_origin()
        self.end_headers()
        try:
            self.wfile.write(body)
        except Exception:
            pass

    def send_json(self, data: dict, status: int = 200):
        body = json.dumps(data).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self._set_cors_origin()
        self.end_headers()
        self.wfile.write(body)

    def _emit_dictation_state(self, request_id: str, state: str,
                              **details) -> None:
        """MVP-16 — best-effort `dictation-state` SSE broadcast. No-op when
        request_id is empty (e.g. caller ran the pipeline without correlation).
        """
        if not request_id:
            return
        payload = {"requestId": request_id, "state": state, "ts": time.time()}
        if details:
            payload["details"] = details
        try:
            broadcast_event("dictation-state", payload)
        except Exception:
            pass

    def _emit_dictation_transcript(self, request_id: str, phase: str, text: str,
                                   **details) -> None:
        """Best-effort transcript-progress SSE event.

        Whisper Flow's useful pattern is the partial/final event contract, not
        its model loop. For POL-17 privacy, this event deliberately omits raw
        ASR text and only reports that a transcript phase exists; the HTTP
        response remains the phone-local review surface.
        """
        if not request_id or not text:
            return
        payload = {
            "requestId": request_id,
            "phase": phase,
            "has_text": True,
            "source": "whisper",
            "ts": time.time(),
        }
        if details:
            payload.update(details)
        try:
            broadcast_event("dictation-transcript", payload)
        except Exception:
            pass

    def send_html(self, html: str):
        body = html.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _handle_sse_stream(self):
        """Phase 2 — SSE stream at GET /events.

        Writes event-stream headers, then blocks reading from our dedicated
        subscriber queue. 15s comment heartbeats keep intermediaries from
        timing out the connection. Exits cleanly on any socket error.
        """
        # Headers
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache, no-transform")
        self.send_header("Connection", "keep-alive")
        self.send_header("X-Accel-Buffering", "no")  # hint for any reverse proxy
        self._set_cors_origin()
        self.end_headers()

        sub = subscribe_events()
        # Opening event so clients can confirm the pipe is live.
        try:
            self.wfile.write(b"event: ready\ndata: {}\n\n")
            self.wfile.flush()
        except Exception:
            unsubscribe_events(sub)
            return

        heartbeat_interval = 15.0
        try:
            while True:
                try:
                    evt = sub.get(timeout=heartbeat_interval)
                except queue.Empty:
                    # Heartbeat — SSE comment lines start with ':'
                    try:
                        self.wfile.write(b": heartbeat\n\n")
                        self.wfile.flush()
                    except Exception:
                        break
                    continue

                event_type, payload = evt
                try:
                    data = json.dumps(payload, ensure_ascii=False)
                except Exception as e:
                    log.warning("SSE payload not JSON-serializable: %s", e)
                    continue
                frame = f"event: {event_type}\ndata: {data}\n\n".encode("utf-8")
                try:
                    self.wfile.write(frame)
                    self.wfile.flush()
                except Exception:
                    # Client disconnected.
                    break
        finally:
            unsubscribe_events(sub)

    def _handle_audit_network(self, query: dict) -> None:
        """MVP-22 — outbound-call ring-buffer endpoint.

        Returns:
          {
            "generated_at": <unix ts>,
            "totals_60s": {"loopback": N, "non_loopback": M, "error": K},
            "recent": [<entry>, ...],
            "warning": "External destination detected: <host>"  // optional
          }

        Default `recent` is the last 60s of activity. `?all=1` returns
        the full ring buffer (up to 200 entries). Both views are filtered
        out of the ring buffer in-process; nothing leaves the box on the
        read path either.
        """
        all_flag = query.get("all", ["0"])[0] == "1"
        now = time.time()
        cutoff = now - 60.0
        with _audit_lock:
            snap = list(_audit_log)
        recent = snap if all_flag else [e for e in snap if e["ts"] >= cutoff]
        # totals_60s is always windowed even when ?all=1 — privacy badge
        # cares about the recent window, not historical trend.
        windowed = [e for e in snap if e["ts"] >= cutoff]
        totals = {
            "loopback": sum(1 for e in windowed if e["is_loopback"]),
            "non_loopback": sum(
                1 for e in windowed if not e["is_loopback"]
            ),
            "error": sum(1 for e in windowed if e.get("error")),
        }
        payload: dict = {
            "generated_at": now,
            "totals_60s": totals,
            "recent": recent,
        }
        # Privacy red-flag: any non-loopback hit in the last 60s flips the
        # phone-UI banner to red. Use the most recent such entry as the
        # exemplar host so the modal can quote it directly.
        external = [e for e in windowed if not e["is_loopback"]]
        if external:
            payload["warning"] = (
                f"External destination detected: "
                f"{external[-1]['host']}:{external[-1]['port']}"
            )
        self.send_json(payload)

    def _handle_transcript_export(self):
        """GET /transcript/export.md — render the current session as markdown."""
        now = datetime.now()
        with transcript_lock:
            entries = [dict(e) for e in session_transcript]
        header_date = now.strftime("%Y-%m-%d %H:%M")
        filename = f"dictation-session-{now.strftime('%Y-%m-%d-%H%M')}.md"
        exported_iso = now.isoformat()

        starred_entries = [e for e in entries if e.get("starred")]
        all_entries = entries  # chronological full log

        def _render_entry(e: dict, out: list[str]) -> None:
            role = e.get("role", "user")
            label = "Partner" if role == "context" else "You"
            ts = e.get("timestamp", "")
            text = e.get("text", "")
            out.append(f"## [{label}] {ts}")
            out.append("")
            if role == "context":
                for chunk in text.splitlines() or [""]:
                    out.append(f"> {chunk}")
            else:
                out.append(text)
            out.append("")
            out.append("---")
            out.append("")

        lines: list[str] = []
        lines.append(f"# Dictation Session — {header_date}")
        lines.append("")
        lines.append(f"_Exported at {exported_iso}. Entry count: {len(entries)}. Starred: {len(starred_entries)}._")
        lines.append("")

        if starred_entries:
            lines.append("## ⭐ Saved takes")
            lines.append("")
            for e in starred_entries:
                _render_entry(e, lines)

        lines.append("## Session log")
        lines.append("")
        for e in all_entries:
            _render_entry(e, lines)

        body = ("\n".join(lines) + "\n").encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/markdown; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header(
            "Content-Disposition", f'attachment; filename="{filename}"'
        )
        self._set_cors_origin()
        self.end_headers()
        self.wfile.write(body)

    def _reject_oversized_body(self, limit: int) -> bool:
        """413/400 gate on Content-Length BEFORE any body byte is read.

        Returns True when a response has been sent and the caller must stop:
        malformed or negative Content-Length → 400, over `limit` → 413.
        A missing header passes (handlers treat it as an empty body).
        """
        raw = self.headers.get("Content-Length")
        if raw is None:
            return False
        try:
            length = int(raw)
        except (TypeError, ValueError):
            self.send_error_json("Malformed Content-Length header",
                                 code="bad_content_length", status=400)
            return True
        if length < 0:
            self.send_error_json("Malformed Content-Length header",
                                 code="bad_content_length", status=400)
            return True
        if length > limit:
            self.send_error_json(
                f"Request body too large (limit {limit} bytes)",
                code="payload_too_large", status=413,
                details={"limit_bytes": limit},
            )
            return True
        return False

    def read_json_body(self) -> dict:
        # Defense in depth: do_POST already 413s oversized bodies up front,
        # but every caller wraps this in try/except → 400, so raising here
        # keeps malformed/oversized input from ever being read.
        try:
            content_length = int(self.headers.get("Content-Length", 0) or 0)
        except (TypeError, ValueError):
            raise ValueError("malformed Content-Length")
        if content_length < 0:
            raise ValueError("negative Content-Length")
        if content_length == 0:
            return {}
        if content_length > MAX_JSON_BODY_BYTES:
            raise ValueError("JSON body exceeds MAX_JSON_BODY_BYTES")
        return json.loads(self.rfile.read(content_length))

    def send_error_json(self, error: str, code: str = "error", status: int = 400,
                        retry_ok: bool = False, details: dict | None = None):
        """Structured error response: {error, code, retry_ok, details?}."""
        payload: dict = {"error": error, "code": code, "retry_ok": retry_ok}
        if details:
            payload["details"] = details
        self.send_json(payload, status)

    def _render_html_with_embed(self, query: dict) -> str:
        """Inject embed config into the HTML response.

        If `embed=1` or any of the pre-population params are present, insert a
        <meta name="dictation-embed"> tag plus a <script> window-global so the
        frontend can pick up chat/persona/character IDs.
        """
        embed = query.get("embed", [""])[0] == "1"
        chat = query.get("chat", [""])[0]
        persona = query.get("persona", [""])[0]
        character = query.get("character", [""])[0]
        mode = query.get("mode", [""])[0]


        if not embed and not (chat or persona or character or mode):
            return WEB_UI

        cfg = {
            "embed": True,
            "chat": chat or None,
            "persona": persona or None,
            "character": character or None,
            "mode": mode or None,
        }
        # Values are user-supplied query params: escape "<" so a crafted
        # ?chat=</script><script>… link can't break out of the script tag.
        cfg_json = json.dumps(cfg, ensure_ascii=True).replace("<", "\\u003c")
        meta = '\n<meta name="dictation-embed" content="1">'
        script = f'\n<script>window.DICTATION_EMBED_CONFIG = {cfg_json};</script>'
        injection = meta + script + "\n</head>"
        # </head> is deterministic and unique in WEB_UI
        return WEB_UI.replace("</head>", injection, 1)

    def _serve_root(self, query: dict) -> None:
        """Serve `/`: full UI for loopback/tokened callers, else pairing page.

        The pairing flow (extension `buildPairedPhoneUrl`) opens `/?token=…`,
        so a valid query token gets the full UI. Tokenless LAN reloads land on
        PAIRING_BOOTSTRAP_HTML, which re-attaches a sessionStorage token and
        redirects — keeping the paired phone working across reloads.
        """
        if self._request_is_privileged():
            self.send_html(self._render_html_with_embed(query))
        else:
            self.send_html(PAIRING_BOOTSTRAP_HTML)

    def _health_payload(self, privileged: bool) -> dict:
        """Full health payload for loopback/tokened callers, bare otherwise."""
        if not privileged:
            # 2026-07 audit: no provider list, mode count, or cert expiry for
            # unauthenticated non-loopback probes.
            return {"status": "ok"}
        days = cert_days_remaining()
        payload = {
            "status": "ok",
            "providers": sorted(_VALID_PROVIDERS),
            "default_provider": DEFAULT_FORMATTER_PROVIDER,
            "mode_count": len(load_modes()),
        }
        if days is not None:
            payload["cert_expires_days"] = days
        return payload

    def do_GET(self):
        if not self.require_auth():
            return
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)
        if path == "/":
            self._serve_root(query)
        elif path == "/manifest.json":
            body = PWA_MANIFEST.encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/manifest+json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif path == "/health":
            self.send_json(self._health_payload(self._request_is_privileged()))
        elif path == "/transcript":
            # Optional ?chat=<id> filter scopes the session log to a single chat.
            # Empty filter returns everything (legacy behavior).
            chat_filter = query.get("chat", [""])[0]
            with transcript_lock:
                if chat_filter:
                    filtered = [
                        e for e in session_transcript
                        if e.get("chat_id", "") == chat_filter
                    ]
                    self.send_json({
                        "transcript": filtered,
                        "total": len(session_transcript),
                        "chat": chat_filter,
                    })
                else:
                    self.send_json({"transcript": list(session_transcript)})
        elif path == "/transcript/export.md":
            self._handle_transcript_export()
        elif path == "/personas":
            self.send_json({"personas": discover_personas()})
        elif path == "/characters":
            # POL-6 — `?group=<groupId>` filters to that group's members.
            group_id = query.get("group", [""])[0].strip()
            if group_id:
                members = discover_group_characters(group_id)
                last_speaker = ChatReader.get_group_last_speaker(group_id)
                self.send_json({
                    "characters": members,
                    "groupId": group_id,
                    "lastSpeaker": last_speaker,
                })
            else:
                self.send_json({"characters": discover_characters()})
        elif path == "/recent-chats":
            chats = ChatReader.get_recent_chats(limit=20)
            # Strip internal 'file' field from response
            safe_chats = [
                {k: v for k, v in c.items() if k != "file"}
                for c in chats
            ]
            self.send_json({"chats": safe_chats})
        elif path == "/active-chat":
            active = ChatReader.get_active_chat()
            if not active:
                self.send_json({"error": "No active chats found"})
            else:
                messages = ChatReader.read_chat_messages(
                    active["name"], active["type"], last_n=CHAT_CONTEXT_WINDOW
                )
                is_group = active["type"] == "group"
                context_text = ContextBuilder.format_messages(messages, is_group=is_group)
                # POL-6 — chatType normalised to solo/group + optional
                # group payload (members + last speaker). `type` is
                # preserved as-is (`individual`/`group`) for legacy
                # consumers; normalised value lives on `chatType`.
                payload: dict = {
                    "name": active["name"],
                    "type": active["type"],
                    "chatType": "group" if is_group else "solo",
                    "messages": messages,
                    "context_text": context_text,
                }
                if is_group:
                    # Resolve group_id from the active chat's name.
                    group_id = ""
                    for g in ChatReader._load_group_defs():
                        if g.get("name", "") == active["name"]:
                            group_id = str(g.get("id", "") or "")
                            break
                    if group_id:
                        payload["groupId"] = group_id
                        payload["groupMembers"] = ChatReader.group_member_objects(group_id)
                        payload["lastSpeaker"] = ChatReader.get_group_last_speaker(group_id)
                self.send_json(payload)
        elif path == "/chat-context":
            qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            chat_name = qs.get("name", [""])[0]
            chat_type = qs.get("type", ["individual"])[0]
            last_n = int(qs.get("last", [str(CHAT_CONTEXT_WINDOW)])[0])
            if not chat_name:
                self.send_error_json("Missing 'name' parameter", code="missing_param", status=400)
            else:
                messages = ChatReader.read_chat_messages(chat_name, chat_type, last_n=last_n)
                is_group = chat_type == "group"
                context_text = ContextBuilder.format_messages(messages, is_group=is_group)
                self.send_json({
                    "name": chat_name,
                    "type": chat_type,
                    "messages": messages,
                    "context_text": context_text,
                })
        elif path == "/modes":
            modes = load_modes()
            self.send_json({"modes": [mode_public_view(m) for m in modes]})
        elif path == "/vocab":
            self.send_json({"vocab": load_vocab()})
        elif path == "/events":
            # Phase 2 — SSE stream. Long-lived; we block on the subscriber queue
            # until the client disconnects. ThreadingHTTPServer gives us a
            # dedicated thread so other requests proceed.
            self._handle_sse_stream()
            return
        elif path == "/state":
            # Phase 3 — current ST state snapshot with freshness.
            self.send_json(snapshot_state())
        elif path == "/state/mode-memory":
            # GET /state/mode-memory            -> full {char_id: mode_id} map
            # GET /state/mode-memory?character= -> { character, mode } for one char
            char = query.get("character", [""])[0]
            if char:
                self.send_json({
                    "character": char,
                    "mode": get_char_mode(char),
                })
            else:
                self.send_json({"modes": load_char_modes()})
        elif path == "/audit/network":
            self._handle_audit_network(query)
        elif path == "/tts/voices":
            self._handle_tts_voices()
        elif path == "/tts/voices/catalog":
            self._handle_tts_voices_catalog()
        elif _is_icon_path(path):
            # POL-5 / Agent 4 §8.3 — manifest references /icon-192.png and
            # /icon-512.png. Asset binaries are deploy-time; until they
            # exist this stub returns 404 with the correct MIME hint so
            # the PWA install flow doesn't error noisily.
            self.send_response(404)
            self.send_header("Content-Type", "image/png")
            self.send_header("Content-Length", "0")
            self.end_headers()
        else:
            self.send_response(404)
            self.end_headers()

    def do_DELETE(self):
        if not self.require_auth():
            return
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)
        if path == "/transcript":
            wipe_all = query.get("all", ["0"])[0] == "1"
            chat_filter = query.get("chat", [""])[0]
            with transcript_lock:
                if chat_filter:
                    # Scoped clear: only entries tagged with this chat_id.
                    # Respects starred unless wipe_all=1.
                    before = len(session_transcript)
                    if wipe_all:
                        keep = [e for e in session_transcript if e.get("chat_id", "") != chat_filter]
                    else:
                        keep = [
                            e for e in session_transcript
                            if e.get("chat_id", "") != chat_filter or e.get("starred")
                        ]
                    cleared = before - len(keep)
                    kept = len([e for e in session_transcript
                                if e.get("chat_id", "") == chat_filter and e.get("starred")])
                    session_transcript[:] = keep
                elif wipe_all:
                    cleared = len(session_transcript)
                    kept = 0
                    session_transcript.clear()
                else:
                    before = len(session_transcript)
                    to_keep = [e for e in session_transcript if e.get("starred")]
                    cleared = before - len(to_keep)
                    kept = len(to_keep)
                    session_transcript[:] = to_keep
            log.info("Session transcript cleared (wipe_all=%s, chat=%s, cleared=%d, kept_starred=%d)",
                     wipe_all, chat_filter or "*", cleared, kept)
            self.send_json({"cleared": cleared, "kept_starred": kept, "chat": chat_filter})
        elif path.startswith("/transcript/"):
            entry_id = urllib.parse.unquote(path[len("/transcript/"):]).strip()
            if not entry_id:
                self.send_error_json("Missing entry id in path",
                                     code="missing_param", status=400)
                return
            with transcript_lock:
                removed = False
                for i, e in enumerate(session_transcript):
                    if e.get("id") == entry_id:
                        session_transcript.pop(i)
                        removed = True
                        break
                transcript_count = len(session_transcript)
            if not removed:
                self.send_error_json(f"No transcript entry with id '{entry_id}'",
                                     code="entry_not_found", status=404,
                                     retry_ok=False)
                return
            self.send_json({"status": "deleted", "transcript_count": transcript_count})
        elif path.startswith("/vocab/"):
            target = urllib.parse.unquote(path[len("/vocab/"):]).strip()
            if not target:
                self.send_error_json("Missing vocab 'correct' value in path",
                                     code="missing_param", status=400)
                return
            entries = load_vocab()
            remaining = [e for e in entries if e.get("correct") != target]
            if len(remaining) == len(entries):
                self.send_error_json(f"No vocab entry found for '{target}'",
                                     code="not_found", status=404)
                return
            try:
                _atomic_write(VOCAB_FILE, _serialize_config(remaining))
            except Exception as e:
                log.exception("Failed to write vocab")
                self.send_error_json(f"Failed to persist vocab: {e}",
                                     code="write_failed", status=500, retry_ok=True)
                return
            _invalidate_vocab_cache()
            self.send_json({"vocab": load_vocab(), "removed": target})
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        if not self.require_auth():
            return
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        # Body-size gate BEFORE any handler reads the body (2026-07 audit).
        # /transcribe carries audio; everything else is JSON.
        body_limit = MAX_AUDIO_BODY_BYTES if path == "/transcribe" else MAX_JSON_BODY_BYTES
        if self._reject_oversized_body(body_limit):
            return

        if path == "/transcribe":
            self._handle_transcribe(params)
        elif path == "/reformat":
            self._handle_reformat(params)
        elif path == "/vocab":
            self._handle_vocab_add()
        elif path == "/word-alternatives":
            # POL-3 — "did you mean?" alternative generator (v1: vocab tier).
            # Body: {word: str, context?: str, character_id?: str}.
            # Subject to require_auth (gated above).
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            if not isinstance(body, dict):
                self.send_error_json("Expected a JSON object",
                                     code="bad_input", status=400)
                return
            word = str(body.get("word", "")).strip()
            if not word:
                self.send_error_json("Missing 'word'",
                                     code="missing_param", status=400)
                return
            ctx = str(body.get("context", "") or "")
            char = str(body.get("character_id", "") or body.get("character", "") or "")
            try:
                alts = word_alternatives(word, context=ctx, character_id=char)
            except Exception as e:
                log.exception("word_alternatives failed for %r", word)
                self.send_error_json(f"Server error: {e}",
                                     code="server_error", status=500)
                return
            self.send_json({
                "word": word,
                "alternatives": alts,
            })
        elif path == "/state":
            # Phase 3 — ST extension (or any client) pushes current state.
            # Expected body: partial or full state payload; missing fields are preserved.
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            if not isinstance(body, dict):
                self.send_error_json("Expected a JSON object", code="bad_input", status=400)
                return
            snap = update_state(body)
            self.send_json(snap)
        elif path == "/send-to-st":
            # Phase 2 — phone (or any client) pushes text to ST via SSE fan-out.
            # Body: {text: str, raw?: str, cleaned?: str, mode?: str,
            #        formatting_skipped?: bool, formatting_reason?: str,
            #        auto_send?: bool}
            # The ST extension subscribed to /events receives a 'dictation-result'
            # event and writes to the chat textarea (and optionally auto-sends).
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            if not isinstance(body, dict):
                self.send_error_json("Expected a JSON object", code="bad_input", status=400)
                return
            text = str(body.get("text", "")).strip()
            if not text:
                self.send_error_json("Missing 'text'", code="missing_param", status=400)
                return
            payload = {
                "text": text,
                "raw": str(body.get("raw", "")),
                "cleaned": str(body.get("cleaned", "")),
                "mode": str(body.get("mode", "")),
                "formatting_skipped": bool(body.get("formatting_skipped", False)),
                "formatting_reason": str(body.get("formatting_reason", "")),
                "model": str(body.get("model", "")),
                "model_fallback": bool(body.get("model_fallback", False)),
                "model_tier": int(body.get("model_tier", 0) or 0),
                "auto_send": bool(body.get("auto_send", False)),
                "ts": time.time(),
            }
            delivered = broadcast_event("dictation-result", payload)
            self.send_json({
                "status": "queued",
                "subscribers": delivered,
            })
        elif path == "/state/mode-memory":
            # Phase 3 — persist per-character mode selection.
            # Body: {character: <id>, mode: <mode_id>}
            try:
                body = self.read_json_body()
            except Exception:
                self.send_error_json("Invalid JSON", code="bad_json", status=400)
                return
            char = str((body or {}).get("character", "")).strip()
            mode_id = str((body or {}).get("mode", "")).strip()
            if not char:
                self.send_error_json("Missing 'character'",
                                     code="missing_param", status=400)
                return
            if mode_id and get_mode(mode_id) is None:
                self.send_error_json(f"Unknown mode '{mode_id}'",
                                     code="unknown_mode", status=400)
                return
            updated = save_char_mode(char, mode_id)
            self.send_json({
                "character": char,
                "mode": mode_id,
                "modes": updated,
            })
        elif path == "/pair":
            # MVP-19 Stage 6 — phone pairing handshake. Phone scans the QR
            # rendered by the wizard, posts back token+fingerprint to confirm
            # both that it could reach the server AND that it pinned the
            # right cert. A `pair-success` SSE event signals the wizard.
            #
            # Auth: require_auth() above already gated bearer token (header
            # or `?token=` query param via the /pair exemption in
            # _AUTH_QUERY_TOKEN_PATHS). Here we additionally verify the
            # `fingerprint` query param matches our live cert — protects
            # against a token-leaked-over-screenshot replay against a
            # different (compromised) box.
            qs_fp = (params.get("fingerprint") or [""])[0].strip()
            server_fp = cert_fingerprint_sha256() or ""
            # Normalize: strip colons + uppercase for compare; the QR
            # encodes whichever form, the server is canonical.
            def _norm_fp(s: str) -> str:
                return re.sub(r"[^0-9A-Fa-f]", "", s).upper()
            if not server_fp:
                self.send_error_json(
                    "Server has no cert to pair against",
                    code="no_cert", status=503, retry_ok=False,
                )
                return
            if _norm_fp(qs_fp) != _norm_fp(server_fp):
                self.send_error_json(
                    "Cert fingerprint mismatch — phone pinned the wrong cert",
                    code="fingerprint_mismatch", status=400, retry_ok=False,
                )
                return
            payload = {
                "ts": time.time(),
                "client": self._client_addr(),
                "ua": str(self.headers.get("User-Agent", ""))[:200],
            }
            broadcast_event("pair-success", payload)
            log.info(f"Phone paired: {payload['client']} ({payload['ua'][:60]})")
            self.send_json({"status": "paired", **payload})
        elif path.startswith("/transcript/") and path.endswith("/star"):
            # POST /transcript/<entry_id>/star — toggle starred on one entry
            mid = path[len("/transcript/"):-len("/star")]
            entry_id = urllib.parse.unquote(mid).strip()
            if not entry_id:
                self.send_error_json("Missing entry id in path",
                                     code="missing_param", status=400)
                return
            with transcript_lock:
                for e in session_transcript:
                    if e.get("id") == entry_id:
                        e["starred"] = not bool(e.get("starred", False))
                        self.send_json({"entry_id": entry_id, "starred": e["starred"]})
                        return
            self.send_error_json(f"No transcript entry with id '{entry_id}'",
                                 code="entry_not_found", status=404, retry_ok=False)
        elif path == "/tts":
            self._handle_tts()
        elif path == "/tts/audiobook":
            self._handle_tts_audiobook()
        elif path == "/tts/voices/suggest":
            self._handle_tts_voices_suggest()
        elif path == "/tts/voices/autocast":
            self._handle_tts_voices_autocast()
        else:
            self.send_response(404)
            self.end_headers()

    # ─── TTS handlers (Kokoro-82M proxy) ──────────────────
    def _handle_tts(self) -> None:
        """POST /tts — synthesize text via kokoro-server, stream WAV back.

        Body: {text: str, voice?: str, speed?: float}. Auth-gated by the
        do_POST `require_auth` check upstream.
        """
        try:
            body = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        text, voice, speed, err = _validate_tts_request(body)
        if err is not None:
            log.warning(
                "/tts validation failed: code=%s status=%s text_len=%s",
                err.get("code"), err.get("status"), len(str(body.get("text", "") or "")) if isinstance(body, dict) else 0,
            )
            self.send_error_json(err["error"], code=err["code"], status=err["status"])
            return
        if not _ensure_kokoro_alive():
            self.send_error_json(
                "kokoro-server unreachable",
                code="tts_unavailable", status=503, retry_ok=True,
            )
            return
        try:
            audio_bytes, ctype = _synthesize_via_kokoro(text, voice, speed=speed)
        except RuntimeError as e:
            log.warning("TTS synthesize failed: %s", e)
            self.send_error_json(
                f"TTS synthesis failed: {e}",
                code="tts_failed", status=502, retry_ok=True,
            )
            return
        _mark_tts_activity()
        # Stream raw audio. Don't go through send_json — Content-Type matters.
        self.send_response(200)
        self.send_header("Content-Type", ctype or "audio/wav")
        self.send_header("Content-Length", str(len(audio_bytes)))
        self._set_cors_origin()
        self.end_headers()
        try:
            self.wfile.write(audio_bytes)
        except Exception:
            # Client disconnected mid-stream — not actionable.
            pass

    def _handle_tts_voices(self) -> None:
        """GET /tts/voices — proxy kokoro-server's voices list with a 60s TTL cache."""
        if not _ensure_kokoro_alive():
            self.send_error_json(
                "kokoro-server unreachable",
                code="tts_unavailable", status=503, retry_ok=True,
            )
            return
        try:
            payload = _fetch_kokoro_voices()
        except RuntimeError as e:
            log.warning("/tts/voices upstream failed: %s", e)
            self.send_error_json(
                f"Voice list unavailable: {e}",
                code="tts_failed", status=502, retry_ok=True,
            )
            return
        self.send_json(payload)

    def _handle_tts_audiobook(self) -> None:
        """POST /tts/audiobook — synthesize a chat transcript into one WAV.

        Body: {title?, narratorVoice?, voiceMap?, messages:[{name?, text, voice?, is_user?}]}.
        Each message is synthesized independently, then PCM-compatible WAV
        segments are joined with short silence between turns.
        """
        try:
            body = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        messages, narrator_voice, voice_map, title, err = _validate_audiobook_request(body)
        if err is not None:
            self.send_error_json(err["error"], code=err["code"], status=err["status"])
            return
        if not _ensure_kokoro_alive():
            self.send_error_json(
                "kokoro-server unreachable",
                code="tts_unavailable", status=503, retry_ok=True,
            )
            return

        segments: list[bytes] = []
        try:
            for message in messages:
                voice = _voice_for_audiobook_message(message, narrator_voice, voice_map)
                audio_bytes, ctype = _synthesize_via_kokoro(message["text"], voice, speed=1.0)
                if "wav" not in (ctype or "audio/wav").lower():
                    raise RuntimeError(f"kokoro-server returned non-WAV audio: {ctype}")
                segments.append(audio_bytes)
            audiobook = _combine_wav_segments(segments)
        except Exception as e:
            log.warning("Audiobook export failed: %s", e)
            self.send_error_json(
                f"Audiobook export failed: {e}",
                code="audiobook_failed", status=502, retry_ok=True,
            )
            return

        _mark_tts_activity()
        filename = f"{_safe_download_stem(title)}.wav"
        self.send_response(200)
        self.send_header("Content-Type", "audio/wav")
        self.send_header("Content-Length", str(len(audiobook)))
        self.send_header("Content-Disposition", f'attachment; filename="{filename}"')
        self._set_cors_origin()
        self.end_headers()
        try:
            self.wfile.write(audiobook)
        except Exception:
            pass

    def _handle_tts_voices_catalog(self) -> None:
        """GET /tts/voices/catalog — serve the local voice metadata catalog."""
        self.send_json({"catalog": _load_voice_catalog()})

    def _handle_tts_voices_suggest(self) -> None:
        """POST /tts/voices/suggest — heuristic voice suggestions for a character.

        Body: {name, description?, personality?, recent_messages?, existing_voices?, narrator?, n?}
        Returns: {suggestions: [{voice, score, reason}]}
        """
        try:
            body = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        if not isinstance(body, dict):
            self.send_error_json("Body must be an object", code="bad_json", status=400)
            return
        name = str(body.get("name") or "")
        description = str(body.get("description") or "")
        personality = str(body.get("personality") or "")
        recent = body.get("recent_messages")
        recent = [str(m) for m in (recent if isinstance(recent, list) else [])]
        existing = body.get("existing_voices")
        existing = existing if isinstance(existing, dict) else {}
        narrator = str(body.get("narrator") or "")
        n = min(max(int(body.get("n") or 3), 1), 10)
        suggestions = _suggest_voices(name, description, personality, recent, existing, narrator, n)
        self.send_json({"suggestions": suggestions})

    def _handle_tts_voices_autocast(self) -> None:
        """POST /tts/voices/autocast — assign distinct voices to a whole cast.

        Body: {members: [{name, description?, personality?, recent_messages?}],
               existing_voices?, narrator?, overwrite?}
        Returns: {assignments: {name: voice}, assigned, skipped, reused}
        The client owns persistence: it merges `assignments` into its stored
        name->voice profile map. This endpoint is stateless.
        """
        try:
            body = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        if not isinstance(body, dict):
            self.send_error_json("Body must be an object", code="bad_json", status=400)
            return
        raw_members = body.get("members")
        if not isinstance(raw_members, list) or not raw_members:
            self.send_error_json("Missing 'members' list", code="missing_param", status=400)
            return
        members: list[dict] = []
        for m in raw_members[:64]:  # bound cast size defensively
            if isinstance(m, dict) and str(m.get("name") or "").strip():
                members.append(m)
        if not members:
            self.send_error_json("No named members provided", code="missing_param", status=400)
            return
        existing = body.get("existing_voices")
        existing = existing if isinstance(existing, dict) else {}
        narrator = str(body.get("narrator") or "")
        overwrite = bool(body.get("overwrite"))
        result = _autocast_voices(members, existing, narrator, overwrite=overwrite)
        self.send_json(result)

    def _handle_vocab_add(self):
        """POST /vocab — append a vocab entry, persist atomically, return full list."""
        try:
            data = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return
        if not isinstance(data, dict):
            self.send_error_json("Expected a JSON object", code="bad_input", status=400)
            return
        norm = _normalize_vocab_entry(data)
        if not norm:
            self.send_error_json("Missing or empty 'correct' field",
                                 code="missing_param", status=400)
            return

        existing = load_vocab()
        # Dedupe by `correct`
        existing = [e for e in existing if e.get("correct") != norm["correct"]]
        existing.append(norm)
        try:
            _atomic_write(VOCAB_FILE, _serialize_config(existing))
        except Exception as e:
            log.exception("Failed to write vocab")
            self.send_error_json(f"Failed to persist vocab: {e}",
                                 code="write_failed", status=500, retry_ok=True)
            return
        _invalidate_vocab_cache()
        self.send_json({"vocab": load_vocab(), "added": norm})

    def _build_chat_context(self, chat_source: str) -> str:
        """Build context string from ST chat history."""
        if chat_source == "auto":
            active = ChatReader.get_active_chat()
            if not active:
                return ""
            messages = ChatReader.read_chat_messages(
                active["name"], active["type"], last_n=CHAT_CONTEXT_WINDOW
            )
            is_group = active["type"] == "group"
        else:
            # Format: "type:name"
            parts = chat_source.split(":", 1)
            if len(parts) != 2:
                return ""
            chat_type, chat_name = parts
            messages = ChatReader.read_chat_messages(
                chat_name, chat_type, last_n=CHAT_CONTEXT_WINDOW
            )
            is_group = chat_type == "group"

        if not messages:
            return ""
        return ContextBuilder.format_messages(messages, is_group=is_group)

    def _handle_reformat(self, params: dict | None = None):
        """Re-run pipeline on previously transcribed text.

        Supports both legacy `rp=0|1|2` and new `mode=<id>`. `mode` wins.
        """
        params = params or {}
        try:
            data = self.read_json_body()
        except Exception:
            self.send_error_json("Invalid JSON", code="bad_json", status=400)
            return

        text = data.get("text", "").strip()
        # Mode resolution: body wins over query; then legacy rp.
        mode_id = (data.get("mode")
                   or params.get("mode", [""])[0]
                   or "").strip()
        rp_raw = data.get("rp")
        if rp_raw is None:
            rp_raw = params.get("rp", [None])[0]
        try:
            rp_int = int(rp_raw) if rp_raw is not None else 2
        except (TypeError, ValueError):
            rp_int = 2
        mode = resolve_mode(rp=rp_int, mode_id=mode_id)
        provider = normalize_formatter_provider(
            data.get("provider") or params.get("provider", [""])[0] or DEFAULT_FORMATTER_PROVIDER
        )

        context = data.get("context", "")
        chat_source = data.get("chat_source", "")
        persona_id = data.get("persona", "")
        character_id = data.get("character", "")
        scene_continuity = str(data.get("sceneContinuity") or "")[:2000]
        use_rules = bool(data.get("rules", False))
        prose_format = bool(data.get("prose", False))

        if not scene_continuity:
            state_snap = snapshot_state()
            if state_snap.get("fresh"):
                scene_continuity = str(state_snap.get("sceneContinuity") or "")[:2000]

        # Build chat context if source is not manual
        chat_context = ""
        if chat_source and chat_source != "manual":
            chat_context = self._build_chat_context(chat_source)

        if not text:
            self.send_error_json("No text to reformat", code="missing_param", status=400)
            return

        # Walk backwards and replace the most recent user entry (leave context entries intact).
        # Phase 3: optional targeted replacement by entry_id.
        entry_id = data.get("entry_id")
        if isinstance(entry_id, str):
            entry_id = entry_id.strip() or None
        else:
            entry_id = None

        target_index: int | None = None
        if entry_id is not None:
            with transcript_lock:
                for i, e in enumerate(session_transcript):
                    if e.get("id") == entry_id:
                        if e.get("role") != "user":
                            self.send_error_json(
                                "Entry not found or not a user entry",
                                code="entry_not_found", status=404, retry_ok=False,
                            )
                            return
                        target_index = i
                        break
                if target_index is None:
                    self.send_error_json(
                        "Entry not found or not a user entry",
                        code="entry_not_found", status=404, retry_ok=False,
                    )
                    return

        # Legacy path: walk backwards and pop the most recent user entry so the
        # new reformatted version appends at the tail.
        if target_index is None:
            with transcript_lock:
                for i in range(len(session_transcript) - 1, -1, -1):
                    if session_transcript[i]["role"] == "user":
                        session_transcript.pop(i)
                        break

        # Run pipeline (I/O; don't hold the lock).
        formatted, formatting_skipped, formatting_reason, cleaned_text = run_pipeline(
            text, mode,
            context=context,
            persona_id=persona_id,
            character_id=character_id,
            chat_context=chat_context,
            scene_continuity=scene_continuity,
            use_rules=use_rules,
            prose_format=prose_format,
            provider=provider,
        )

        # Only append / replace in transcript for enhancement-style modes that succeeded.
        pipeline_steps = mode.get("pipeline", [])
        is_enhancement = any(s in pipeline_steps for s in ("rp_enhance", "persona_pov"))
        result_entry_id: str | None = None
        chat_id_tag = ""
        with transcript_lock:
            if is_enhancement and not formatting_skipped:
                if target_index is not None and target_index < len(session_transcript):
                    # In-place replacement: keep id + starred, update text + timestamp.
                    existing = session_transcript[target_index]
                    existing["text"] = formatted
                    existing["timestamp"] = datetime.now().isoformat()
                    # starred is preserved implicitly (dict mutation)
                    result_entry_id = existing.get("id")
                else:
                    # If the user has a fresh ST state, tag new reformat entries with
                    # that chat id so per-chat filtering works.
                    _st_snap = snapshot_state()
                    chat_id_tag = _st_snap.get("chatId", "") if _st_snap.get("fresh") else ""
                    new_entry = {
                        "id": _new_entry_id(),
                        "role": "user",
                        "text": formatted,
                        "timestamp": datetime.now().isoformat(),
                        "starred": False,
                        "chat_id": chat_id_tag,
                    }
                    session_transcript.append(new_entry)
                    result_entry_id = new_entry["id"]
            transcript_count = len(session_transcript)

        repair_trace = build_repair_trace(text, cleaned_text, formatted)
        attribution = get_model_attribution()
        self.send_json({
            "text": formatted,
            "raw": text,
            "cleaned": cleaned_text,
            "repair_trace": repair_trace,
            "mode": mode.get("id"),
            "provider": provider,
            "transcript_count": transcript_count,
            "formatting_skipped": formatting_skipped,
            "formatting_reason": formatting_reason,
            "model": attribution["model"],
            "model_fallback": attribution["fallback"],
            "model_tier": attribution["tier"],
            "entry_id": result_entry_id,
            "chat_id": chat_id_tag,
        })

    def _handle_transcribe(self, params):
        """Transcribe audio and run the selected pipeline."""
        # POL-16 — per-stage timing trace. Stamps relative to `recv` are
        # rendered into a single JSON log line at the end. Greppable from
        # journalctl with: `journalctl --user -u dictation-server | grep "^timing "`.
        timing: dict[str, float] = {"recv": time.monotonic()}

        # Phase 3: `use_state=1` resolves persona/character/mode/chat_source from
        # the live ST state broadcast. Explicit query params still win if both
        # are provided (manual override on the phone UI).
        use_state = params.get("use_state", ["0"])[0] == "1"
        state_snap = snapshot_state() if use_state else {}
        state_fresh = state_snap.get("fresh", False)

        # Resolve mode: explicit param > state.mode > remembered per-char > legacy rp.
        mode_id = params.get("mode", [""])[0]
        if not mode_id and state_fresh:
            mode_id = state_snap.get("mode", "") or state_snap.get("rememberedMode", "")
        try:
            rp_int = int(params.get("rp", ["0"])[0])
        except ValueError:
            rp_int = 0
        mode = resolve_mode(rp=rp_int, mode_id=mode_id)
        provider = normalize_formatter_provider(
            params.get("provider", [DEFAULT_FORMATTER_PROVIDER])[0]
        )

        # Model: explicit query param overrides mode default.
        model = params.get("model", [mode.get("whisper_model", DEFAULT_MODEL)])[0]

        # MVP-10 / ADR-2 — drop hardcoded language. Default to 'en' for the
        # dominant case but accept any ISO-639-1 code; 'auto' lets whisper
        # detect (useful for full-Swahili utterances). Whitelist defensively:
        # whisper-server treats unknown values as 'auto' which is harmless,
        # but stripping characters keeps the form-field POST tidy.
        language = params.get("language", ["en"])[0].strip().lower() or "en"
        if not re.fullmatch(r"[a-z]{2,4}|auto", language):
            language = "en"

        context = urllib.parse.unquote(params.get("context", [""])[0])
        chat_source = params.get("chat_source", [""])[0]
        persona_id = params.get("persona", [""])[0]
        character_id = params.get("character", [""])[0]
        use_rules = params.get("rules", ["0"])[0] == "1"
        prose_format = params.get("prose", ["0"])[0] == "1"
        scene_continuity = ""

        # Phase 3: fill in blanks from state when `use_state=1` and state is fresh.
        # Explicit params always take precedence over state (manual override wins).
        if use_state and state_fresh:
            if not persona_id:
                persona_id = state_snap.get("personaId", "")
            if not character_id:
                character_id = state_snap.get("characterId", "")
            if not context and state_snap.get("lastAiMessage"):
                context = state_snap["lastAiMessage"]
            if not chat_source and state_snap.get("chatId"):
                ctype = state_snap.get("chatType", "individual") or "individual"
                chat_source = f"{ctype}:{state_snap['chatId']}"
            scene_continuity = str(state_snap.get("sceneContinuity") or "")[:2000]

        # chat_id tag for per-chat transcript filtering (Phase 3)
        chat_id_for_entry = ""
        if state_fresh and state_snap.get("chatId"):
            chat_id_for_entry = state_snap["chatId"]

        # Build chat context if source is not manual
        chat_context = ""
        if chat_source and chat_source != "manual":
            chat_context = self._build_chat_context(chat_source)

        # Read audio body (do_POST has already 400/413'd malformed or
        # oversized Content-Length; re-check defensively).
        try:
            content_length = int(self.headers.get("Content-Length", 0) or 0)
        except (TypeError, ValueError):
            content_length = 0
        if content_length <= 0:
            self.send_error_json("No audio data", code="missing_audio", status=400)
            return
        if content_length > MAX_AUDIO_BODY_BYTES:
            self.send_error_json(
                f"Audio body too large (limit {MAX_AUDIO_BODY_BYTES} bytes)",
                code="payload_too_large", status=413,
            )
            return

        audio_data = self.rfile.read(content_length)
        content_type = self.headers.get("Content-Type", "")

        tmp_input = None
        tmp_wav = None
        try:
            # Save the uploaded audio
            suffix = ".webm" if "webm" in content_type else ".wav"
            tmp_input = tempfile.NamedTemporaryFile(
                prefix="dictation-", suffix=suffix, dir="/tmp", delete=False
            )
            tmp_input.write(audio_data)
            tmp_input.close()

            # Convert to WAV (16kHz mono) if not already WAV
            wav_path = tmp_input.name
            if suffix != ".wav":
                tmp_wav = tempfile.NamedTemporaryFile(
                    prefix="dictation-", suffix=".wav", dir="/tmp", delete=False
                )
                tmp_wav.close()
                wav_path = tmp_wav.name

                ffmpeg_cmd = [
                    "ffmpeg", "-y", "-i", tmp_input.name,
                    "-ar", "16000", "-ac", "1", "-f", "wav",
                    wav_path,
                ]
                result = subprocess.run(
                    ffmpeg_cmd, capture_output=True, text=True, timeout=30
                )
                if result.returncode != 0:
                    self.send_error_json(
                        f"Audio conversion failed: {result.stderr[:200]}",
                        code="ffmpeg_failed", status=500,
                    )
                    return

            timing["ffmpeg"] = time.monotonic()

            # Pre-whisper vocab bias (if mode's pipeline includes vocab_correct)
            whisper_prompt = ""
            if "vocab_correct" in mode.get("pipeline", []):
                whisper_prompt = build_whisper_prompt(character_id)

            # MVP-13: per-request id correlates streamed `dictation-token`
            # events with the final `dictation-result`. Generated server-side
            # and echoed in the JSON response so the ST extension can match
            # streamed deltas to the canonical final text.
            # MVP-16 also keys `dictation-state` events on this id so the
            # extension's state-machine bar can track which request is active.
            request_id = secrets.token_urlsafe(8)

            # MVP-16 — handed off to whisper. Phone-side owns `listening`; we
            # never forge it from the server.
            self._emit_dictation_state(request_id, "transcribing")

            # Transcribe (MVP-9: capture per-word confidences from whisper-server
            # JSON for downstream "did you mean?" UI; empty list on subprocess fallback.
            # MVP-10: language flows from ?language= query param; default 'en'.)
            raw_text, word_confidences = transcribe_with_confidence(
                Path(wav_path), model=model, prompt=whisper_prompt, language=language,
            )

            timing["whisper"] = time.monotonic()

            if not raw_text:
                self.send_error_json("No speech detected", code="no_speech",
                                     status=200, retry_ok=True)
                return

            # POL-1 — backwards-compat ST `OOC:` convention. Detected here,
            # BEFORE the pipeline runs, so it can flip the resolved mode to
            # `grammar_clean` and strip the prefix from the text. No
            # `dictation-command` event is emitted — OOC is a content marker,
            # not a UI action. Agent 3 §3.
            ooc_match = OOC_PREFIX_RE.match(raw_text)
            if ooc_match:
                raw_text = raw_text[ooc_match.end():].strip()
                if not raw_text:
                    self.send_error_json("No speech detected", code="no_speech",
                                         status=200, retry_ok=True)
                    return
                ooc_mode = get_mode("grammar_clean")
                if ooc_mode is not None:
                    mode = ooc_mode
                    log.info("OOC prefix detected — mode override -> grammar_clean")

            self._emit_dictation_transcript(
                request_id,
                "final",
                raw_text,
                mode=mode.get("id", ""),
                language=language,
                latency_ms=round((timing["whisper"] - timing["recv"]) * 1000),
            )

            pipeline_steps = mode.get("pipeline", [])
            is_enhancement = any(s in pipeline_steps for s in ("rp_enhance", "persona_pov"))

            # Add context to transcript if provided (enhancement modes only)
            if is_enhancement and context.strip():
                with transcript_lock:
                    if not session_transcript or session_transcript[-1].get("text") != context.strip():
                        session_transcript.append({
                            "id": _new_entry_id(),
                            "role": "context",
                            "text": context.strip(),
                            "timestamp": datetime.now().isoformat(),
                            "starred": False,
                            "chat_id": chat_id_for_entry,
                        })

            # Run pipeline.
            # POL-16: pass `timing` so each step stamps wall-clock entries.
            # MVP-16: request_id always flows now — it's the SSE state-event
            # correlation key. Streaming gating still happens *inside*
            # `format_rp`, which only forwards request_id to the proxy on
            # streaming-eligible steps (rp_enhance / persona_pov).
            output_text, formatting_skipped, formatting_reason, cleaned_text = run_pipeline(
                raw_text, mode,
                context=context,
                persona_id=persona_id,
                character_id=character_id,
                chat_context=chat_context,
                scene_continuity=scene_continuity,
                use_rules=use_rules,
                prose_format=prose_format,
                provider=provider,
                request_id=request_id,
                timing=timing,
            )

            # Log to session transcript only for enhancement modes with success
            if is_enhancement and not formatting_skipped:
                with transcript_lock:
                    session_transcript.append({
                        "id": _new_entry_id(),
                        "role": "user",
                        "text": output_text,
                        "timestamp": datetime.now().isoformat(),
                        "starred": False,
                        "chat_id": chat_id_for_entry,
                    })

            with transcript_lock:
                transcript_count = len(session_transcript)

            repair_trace = build_repair_trace(raw_text, cleaned_text, output_text)
            attribution = get_model_attribution()

            # MVP-13: emit canonical `dictation-result` after streaming. The
            # ST extension overwrites whatever it accumulated from
            # `dictation-token` deltas with this — guarantees no drift between
            # streamed bytes (which can include filtered thinking-tag fragments
            # or be cut off mid-stream) and the final source-of-truth text.
            if is_enhancement:
                broadcast_event("dictation-result", {
                    "requestId": request_id,
                    "text": output_text,
                    "has_repair_trace": repair_trace.get("has_changes", False),
                    "mode": mode.get("id", ""),
                    "provider": provider,
                    "formatting_skipped": formatting_skipped,
                    "formatting_reason": formatting_reason,
                    "model": attribution["model"],
                    "model_fallback": attribution["fallback"],
                    "model_tier": attribution["tier"],
                    "auto_send": False,
                    "ts": time.time(),
                })

            timing["respond"] = time.monotonic()

            # POL-16 — single-line JSON timing trace; cumulative ms from `recv`.
            try:
                stages_ms = {
                    k: round((v - timing["recv"]) * 1000)
                    for k, v in timing.items() if k != "recv"
                }
                log.info("timing %s", json.dumps({
                    "req": request_id,
                    "mode": mode.get("id", ""),
                    "stages_ms": stages_ms,
                }))
            except Exception as _e:
                log.debug("timing log emit failed: %s", _e)

            # MVP-16 — pipeline finished. Tells the state-machine bar to
            # collapse; ST extension can now overwrite #send_textarea with
            # the canonical text from the JSON response below (or from the
            # `dictation-result` SSE event).
            self._emit_dictation_state(request_id, "done")

            # POL-3 — low-confidence spans for the "did you mean?" overlay.
            # We anchor offsets into the post-pipeline `output_text` when one
            # exists (so the phone chips line up with what the user sees);
            # for pure-pipeline modes that emit empty text (voice command
            # short-circuit), spans are skipped entirely.
            anchor_text = output_text or raw_text
            low_confidence_spans: list[dict] = []
            if anchor_text:
                try:
                    low_confidence_spans = compute_low_confidence_spans(
                        anchor_text, word_confidences,
                        character_id=character_id,
                    )
                except Exception as _e:  # pragma: no cover — best-effort overlay
                    log.debug("compute_low_confidence_spans failed: %s", _e)
                    low_confidence_spans = []

            self.send_json({
                "text": output_text,
                "raw": raw_text,
                "cleaned": cleaned_text,
                "repair_trace": repair_trace,
                "mode": mode.get("id"),
                "provider": provider,
                "transcript_count": transcript_count,
                "formatting_skipped": formatting_skipped,
                "formatting_reason": formatting_reason,
                "model": attribution["model"],
                "model_fallback": attribution["fallback"],
                "model_tier": attribution["tier"],
                "chat_id": chat_id_for_entry or "",
                # MVP-9: per-word confidences from whisper-server JSON output.
                # Empty when subprocess fallback ran or response carried no
                # token-level data. Phase 4 UI consumer not yet wired.
                "word_confidences": word_confidences,
                # POL-3: words flagged as low-confidence + vocab alternatives.
                # Empty list when whisper didn't emit token-level data, when
                # all words clear the threshold, or when the pipeline emitted
                # no canonical text (voice-command short-circuit).
                "low_confidence_spans": low_confidence_spans,
                # MVP-13: client correlates streamed deltas to canonical text.
                "request_id": request_id,
            })

        except FileNotFoundError as e:
            self._emit_dictation_state(locals().get("request_id", ""), "error",
                                       cls=e.__class__.__name__)
            self.send_error_json(str(e), code="model_missing", status=400)
        except RuntimeError as e:
            # transcribe() raises this for timeouts + whisper-cli failures
            self._emit_dictation_state(locals().get("request_id", ""), "error",
                                       cls=e.__class__.__name__)
            self.send_error_json(str(e), code="whisper_failed", status=500, retry_ok=True)
        except Exception as e:
            self._emit_dictation_state(locals().get("request_id", ""), "error",
                                       cls=e.__class__.__name__)
            log.exception("Transcription error")
            self.send_error_json(f"Server error: {e}", code="server_error", status=500)
        finally:
            if tmp_input:
                Path(tmp_input.name).unlink(missing_ok=True)
            if tmp_wav:
                Path(tmp_wav.name).unlink(missing_ok=True)

    def do_OPTIONS(self):
        """Handle CORS preflight."""
        self.send_response(204)
        self._set_cors_origin()
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.end_headers()


