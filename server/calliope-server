from calliope_server.wizard import WizardDeps as _WizardDeps  # noqa: E402
from calliope_server.wizard import run_setup_wizard as _run_setup_wizard  # noqa: E402
from calliope_server.wizard import _wizard_confirm  # noqa: E402 — used by --tailscale-cert


def run_setup_wizard(args) -> int:
    """Back-compat entry — binds this module's (monkeypatchable) helpers."""
    deps = _WizardDeps(
        ensure_token=ensure_token,
        regenerate_token=regenerate_token,
        get_token=get_token,
        discover_local_ips=_discover_local_ips,
