# ─── MVP-24: Tailscale cert subcommand ────────────────────
# Per ADR-7 Tier 3 / Agent 5 §2. Power-user path: tailscale issues a real
# Let's Encrypt cert via MagicDNS, phone reaches us at https://<host>.<tail>.ts.net
# without warning. We do NOT auto-renew here — Tailscale's own cert renewal
# story is separate; user re-runs `dictation-server --tailscale-cert` once
# every ~80 days, or pairs with a systemd timer (documented elsewhere).

def _tailscale_self_dns() -> str | None:
    """Return this node's MagicDNS name, e.g. 'foo.tail-xxxx.ts.net' (no trailing dot)."""
    if not shutil.which("tailscale"):
        return None
    try:
        res = subprocess.run(
            ["tailscale", "status", "--json"],
            capture_output=True, text=True, timeout=5, check=False,
        )
    except Exception as e:
        log.debug(f"tailscale status failed: {e}")
        return None
    if res.returncode != 0:
        return None
    try:
        data = json.loads(res.stdout)
    except Exception:
        return None
    self_block = data.get("Self") or {}
    dns = (self_block.get("DNSName") or "").strip()
    if not dns:
        return None
    # Strip MagicDNS trailing dot.
    return dns.rstrip(".")


def run_tailscale_cert(args) -> int:
    """Issue a Tailscale-managed Let's Encrypt cert for this node.

    Steps:
      1. Verify `tailscale` on PATH + node logged in.
      2. Resolve MagicDNS name from `tailscale status --json`.
      3. `sudo tailscale cert <hostname>` — produces <host>.crt + <host>.key in CWD.
      4. Atomically move into DATA_DIR with the right modes.
      5. Restart dictation-server so it picks up the new cert.
    """
    print("=" * 64)
    print("  Calliope dictation-server — issue Tailscale (Let's Encrypt) cert")
    print("=" * 64)

    if not shutil.which("tailscale"):
        print("! tailscale not found on PATH.")
        print("  Install:  https://tailscale.com/download")
        print("  Then:     sudo tailscale up")
        return 2

    hostname = _tailscale_self_dns()
    if not hostname:
        print("! Could not resolve this node's MagicDNS name.")
        print("  Is tailscaled running? Are you logged in?  `tailscale status`")
        return 2

    print(f"  Tailnet hostname:  {hostname}")
    print(f"  Will run:          sudo tailscale cert {hostname}")
    if not _wizard_confirm("  Proceed?", default_yes=True):
        print("  Aborted.")
        return 0

    workdir = Path(tempfile.mkdtemp(prefix="calliope-tscert-"))
    try:
        try:
            res = subprocess.run(
                ["sudo", "tailscale", "cert", hostname],
                cwd=str(workdir), check=False, text=True,
                capture_output=False,
            )
        except FileNotFoundError:
            print("! sudo not on PATH.")
            return 2
        if res.returncode != 0:
            print("! tailscale cert failed.")
            print("  Common causes:")
            print("    - HTTPS certs disabled in tailnet ACL/admin console")
            print("    - sudo not pre-authorized; re-run interactively")
            print("    - DNS not propagated (give it 60s + retry)")
            return 2

        crt = workdir / f"{hostname}.crt"
        key = workdir / f"{hostname}.key"
        if not (crt.exists() and key.exists()):
            print(f"! Expected {crt.name} + {key.name} in {workdir} — not found.")
            return 2

        DATA_DIR.mkdir(parents=True, exist_ok=True)
        # Backup any existing self-signed cert before clobbering.
        for src, dst in ((crt, CERT_FILE), (key, KEY_FILE)):
            if dst.exists():
                bak = dst.with_suffix(dst.suffix + ".pre-tailscale.bak")
                try:
                    shutil.copy2(dst, bak)
                except Exception as e:
                    log.warning(f"backup of {dst} failed: {e}")
            shutil.move(str(src), str(dst))
        try:
            os.chmod(CERT_FILE, 0o644)
            os.chmod(KEY_FILE, 0o600)
        except OSError as e:
            print(f"! could not enforce file modes: {e}")

        # Refresh the persisted fingerprint to match the new cert.
        fp = cert_fingerprint_sha256() or ""
        if fp:
            try:
                CERT_FINGERPRINT_FILE.write_text(fp + "\n", encoding="utf-8")
                os.chmod(CERT_FINGERPRINT_FILE, 0o644)
            except Exception as e:
                log.warning(f"fingerprint persist failed: {e}")

        print("  ✓ Got Let's Encrypt cert from Tailscale.")
        print(f"    Server reachable at https://{hostname}:{DEFAULT_PORT}")
        print("    from any tailnet device, no cert warnings.")
        if fp:
            print(f"    Fingerprint (SHA-256): {fp}")

        # Restart so the running server picks up the new cert (no hot-reload).
        if shutil.which("systemctl"):
            if _wizard_confirm("  Restart dictation-server now?", default_yes=True):
                try:
                    subprocess.run(
                        ["systemctl", "--user", "restart", "dictation-server"],
                        check=True, capture_output=True, text=True,
                    )
                    print("  ✓ dictation-server restarted")
                except subprocess.CalledProcessError as e:
                    print(f"  ! restart failed: {e.stderr.strip()}")
                    print("    Restart manually: systemctl --user restart dictation-server")
            else:
                print("  Note: server still serving the OLD cert. "
                      "Run `systemctl --user restart dictation-server` when ready.")
        else:
            print("  systemctl not present — restart dictation-server manually.")
    finally:
        try:
            shutil.rmtree(workdir, ignore_errors=True)
        except Exception:
            pass

    return 0


# ─── Main ─────────────────────────────────────────────────
def main():
    parser = argparse.ArgumentParser(description="Remote dictation server")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help=f"Port (default: {DEFAULT_PORT})")
    parser.add_argument("--host", default=DEFAULT_HOST, help=f"Host (default: {DEFAULT_HOST})")
    parser.add_argument("--no-ssl", action="store_true", help="Disable HTTPS (mic won't work on non-localhost)")
    # MVP-19 — first-run wizard flags (mutually exclusive with normal serve).
    parser.add_argument("--setup", action="store_true",
                        help="Run the first-run setup wizard and exit (MVP-19).")
    # MVP-24 — Tailscale-issued Let's Encrypt cert (ADR-7 Tier 3).
    parser.add_argument("--tailscale-cert", action="store_true",
                        help="Issue a Tailscale (Let's Encrypt via MagicDNS) cert for this node and exit (MVP-24).")
    parser.add_argument("--rotate-token", action="store_true",
                        help="Rotate the bearer token and exit; prints the token path, not the secret value.")
    parser.add_argument("--force", action="store_true",
                        help="Re-run wizard stages even when artifacts exist (rotates cert+token, re-downloads model).")
    parser.add_argument("--install-systemd", dest="install_systemd",
                        action=argparse.BooleanOptionalAction, default=True,
                        help="Wizard stage 4: install + start systemd units (default: yes; --no-install-systemd for dry-run).")
    for n in range(1, 8):
        parser.add_argument(f"--skip-stage-{n}", action="store_true",
                            help=f"Wizard: skip stage {n}.")
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(message)s",
        datefmt="%H:%M:%S",
    )

    # MVP-19 / MVP-24 dispatch: short-circuit before any server bring-up.
    if args.setup:
        return run_setup_wizard(args)
    if args.tailscale_cert:
        return run_tailscale_cert(args)
    if args.rotate_token:
        regenerate_token(log_new_token=False)
        print("Bearer token rotated.")
        print(f"Token file: {TOKEN_FILE} (mode 0600)")
        print("Token value was not printed; treat the file contents as a password.")
        print(
            "Live rotation sequence: stop dictation-server; rotate the token; "
            "update the ST bridge token setting; restart dictation-server; "
            "hard-refresh SillyTavern; re-pair the phone."
        )
        return 0

    # Verify dependencies
    if not shutil.which(WHISPER_BIN):
        log.error(f"{WHISPER_BIN} not found in PATH")
        raise SystemExit(1)
    if not shutil.which("ffmpeg"):
        log.error("ffmpeg not found — needed for audio format conversion")
        raise SystemExit(1)

    # Available models
    models = sorted(MODEL_DIR.glob("ggml-*.bin"))
    if not models:
        log.error(f"No whisper models found in {MODEL_DIR}")
        raise SystemExit(1)
    model_names = [m.stem.replace("ggml-", "") for m in models]
    log.info(f"Available models: {', '.join(model_names)}")

    # Phase 2: seed modes.yaml and vocab.yaml on first run
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    _ensure_default_modes()
    _ensure_default_vocab()
    initial_modes = load_modes()
    log.info(
        f"Config format: {'YAML' if _HAVE_YAML else 'JSON (PyYAML unavailable)'} | "
        f"modes: {len(initial_modes)} ({', '.join(m.get('id','') for m in initial_modes)}) | "
        f"vocab entries: {len(load_vocab())} | "
        f"formatters: claude={CLAUDE_PROXY_URL}, openai={OPENAI_PROXY_URL}, default={DEFAULT_FORMATTER_PROVIDER}"
    )

    # Mint or load the bearer token before binding the socket.
    ensure_token()

    # Phase 2 (ADR-1) — start idle-shutdown daemon. It only acts after the
    # first successful transcribe (driven by _mark_transcribe_activity), so
    # boot before any clients connect is safe even when whisper-server isn't
    # running yet.
    _start_idle_shutdown_thread()
    # TTS idle-shutdown daemon — only acts after first /tts call (driven by
    # _mark_tts_activity). Safe to start before kokoro-server is running.
    _start_kokoro_idle_shutdown_thread()

    server = http.server.ThreadingHTTPServer((args.host, args.port), DictationHandler)
    server.daemon_threads = True

    if not args.no_ssl:
        ensure_ssl_cert()
        # Print + persist SHA-256 fingerprint so users can verify the cert
        # they're trusting on the phone matches the one this server is
        # serving. ADR-7. Persisted file mode 0644.
        fp = cert_fingerprint_sha256()
        if fp:
            log.info(f"Cert fingerprint (SHA-256): {fp}")
            try:
                CERT_FINGERPRINT_FILE.write_text(fp + "\n", encoding="utf-8")
                os.chmod(CERT_FINGERPRINT_FILE, 0o644)
            except Exception as e:
                log.warning(f"Could not persist cert fingerprint: {e}")
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(str(CERT_FILE), str(KEY_FILE))
        server.socket = ctx.wrap_socket(server.socket, server_side=True)
        proto = "https"
    else:
        proto = "http"

    # Get local IP for display
    import socket
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        local_ip = s.getsockname()[0]
        s.close()
    except Exception:
        local_ip = "127.0.0.1"

    log.info(f"Dictation server running at {proto}://{local_ip}:{args.port}")
    log.info("Open this URL on your phone to start dictating")
    if not args.no_ssl:
        log.info("First visit: accept the self-signed certificate warning")

    # Loud warning if bound somewhere LAN-reachable.
    if not _is_loopback_address(args.host) and args.host not in ("localhost",):
        log.warning(
            f"⚠ Listening on {args.host}:{args.port} — LAN-reachable. "
            f"Token auth required for non-localhost clients."
        )
    if CORS_ALLOW_WILDCARD:
        log.warning(
            "⚠ DICTATION_CORS_ORIGINS=* — any origin can call the API. "
            "Dev-only; do not use this in shared networks."
        )

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log.info("Shutting down")
        server.shutdown()


if __name__ == "__main__":
    main()
