_ssl_context: "ssl.SSLContext | None" = None
_cert_renew_thread: "threading.Thread | None" = None



def _discover_local_ips() -> list[str]:
    """Best-effort enumeration of interface IPs for cert SAN.

    Always includes 127.0.0.1 and ::1. Adds every address `getaddrinfo`
    returns for the local hostname. Pure stdlib — no `ip` command shellout.
    """
    import socket
    ips: list[str] = ["127.0.0.1", "::1"]
    seen = set(ips)
    try:
        for fam, *_rest, sa in socket.getaddrinfo(socket.gethostname(), None):
            if fam not in (socket.AF_INET, socket.AF_INET6):
                continue
            ip = sa[0]
            # Strip scope id from link-local IPv6 (`fe80::1%eth0`).
            if "%" in ip:
                ip = ip.split("%", 1)[0]
            if ip and ip not in seen:
                ips.append(ip)
                seen.add(ip)
    except Exception as e:
        log.debug(f"_discover_local_ips: getaddrinfo failed: {e}")
    return ips


def _generate_self_signed_cert(sans: list[str] | None = None):
    """Mint a self-signed cert valid for CERT_VALIDITY_DAYS.

    `sans` extends subjectAltName beyond the default loopback set. Each
    entry is auto-classified IP vs DNS. Backward-compatible: caller may
    omit `sans` and the existing default (just CN) ships.
    """
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    log.info("Generating self-signed SSL certificate...")

    cmd = [
        "openssl", "req", "-x509", "-newkey", "rsa:2048",
        "-keyout", str(KEY_FILE), "-out", str(CERT_FILE),
        "-days", str(CERT_VALIDITY_DAYS), "-nodes",
        "-subj", "/CN=dictation-server",
    ]

    if sans:
        san_parts: list[str] = []
        for entry in sans:
            entry = (entry or "").strip()
            if not entry:
                continue
            try:
                ipaddress.ip_address(entry)
                san_parts.append(f"IP:{entry}")
            except ValueError:
                san_parts.append(f"DNS:{entry}")
        if san_parts:
            cmd.extend(["-addext", "subjectAltName=" + ",".join(san_parts)])

    subprocess.run(cmd, check=True, capture_output=True)
    # Enforce file modes per ADR-14 §7: cert 0644, key 0600.
    try:
        os.chmod(CERT_FILE, 0o644)
        os.chmod(KEY_FILE, 0o600)
    except OSError as e:
        log.warning(f"Could not enforce cert/key file modes: {e}")
    log.info(f"Certificate saved to {CERT_FILE} (valid {CERT_VALIDITY_DAYS} days)")


def cert_fingerprint_sha256() -> str | None:
    """Return colon-separated SHA-256 fingerprint of the cert, or None on failure."""
    if not CERT_FILE.exists():
        return None
    try:
        result = subprocess.run(
            ["openssl", "x509", "-fingerprint", "-sha256", "-noout", "-in", str(CERT_FILE)],
            capture_output=True, text=True, timeout=5, check=True,
        )
        # Output: "sha256 Fingerprint=AA:BB:CC:..."
        line = result.stdout.strip()
        if "=" in line:
            return line.split("=", 1)[1].strip()
        return None
    except Exception as e:
        log.warning(f"Failed to compute cert fingerprint: {e}")
        return None


def cert_days_remaining() -> int | None:
    """Return days until cert expires, or None if cert is missing/unreadable."""
    if not CERT_FILE.exists():
        return None
    try:
        result = subprocess.run(
            ["openssl", "x509", "-enddate", "-noout", "-in", str(CERT_FILE)],
            capture_output=True, text=True, timeout=5, check=True,
        )
        # Output: "notAfter=May  1 12:00:00 2035 GMT"
        end_str = result.stdout.strip().split("=", 1)[1]
        from datetime import datetime, timezone
        end_dt = datetime.strptime(end_str, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
        delta = end_dt - datetime.now(timezone.utc)
        return delta.days
    except Exception as e:
        log.warning(f"Failed to read cert expiry: {e}")
        return None


def ensure_ssl_cert():
    """Generate a self-signed cert if missing; auto-renew if near expiry."""
    sans = _discover_local_ips()
    try:
        import socket as _sock
        host = _sock.gethostname()
        if host and host not in sans:
            sans.append(host)
    except Exception:
        pass

    if not (CERT_FILE.exists() and KEY_FILE.exists()):
        _generate_self_signed_cert(sans=sans)
        return

    days = cert_days_remaining()
    if days is None:
        log.warning("Could not determine cert expiry — leaving existing cert in place")
        return

    if days < CERT_RENEW_THRESHOLD_DAYS:
        log.warning(f"SSL cert expires in {days} days — auto-regenerating")
        _generate_self_signed_cert(sans=sans)
        return

    if days < CERT_WARN_THRESHOLD_DAYS:
        log.warning(f"SSL cert expires in {days} days — consider regenerating soon")
    else:
        log.info(f"SSL cert valid for {days} more days")


def _reload_ssl_context_cert() -> bool:
    """Hot-reload the cert chain into the live SSLContext.

    ``SSLContext.load_cert_chain`` can be re-called on a running context; new
    TLS handshakes pick up the fresh cert while existing connections keep the
    old one until they close. Returns True on success. No-op (False) when the
    context was never registered (e.g. --no-ssl) or reload fails.
    """
    ctx = _ssl_context
    if ctx is None:
        return False
    try:
        ctx.load_cert_chain(str(CERT_FILE), str(KEY_FILE))
        log.info("Reloaded regenerated cert into live SSLContext (new handshakes only)")
        return True
    except Exception as e:
        log.warning(f"Could not hot-reload cert into live SSLContext: {e}")
        return False


def _check_and_renew_cert() -> bool:
    """One in-run cert renewal check. Returns True if the cert was renewed.

    Regenerates when fewer than CERT_RENEW_THRESHOLD_DAYS remain and hot-reloads
    the live SSLContext so a long-running server does not cross expiry between
    restarts. Separated from the loop so tests can drive it directly.
    """
    days = cert_days_remaining()
    if days is None:
        log.warning("In-run cert check: could not determine cert expiry — skipping")
        return False
    if days >= CERT_RENEW_THRESHOLD_DAYS:
        if days < CERT_WARN_THRESHOLD_DAYS:
            log.info(f"In-run cert check: {days} days remaining")
        return False
    log.warning(f"In-run cert check: cert expires in {days} days — regenerating")
    ensure_ssl_cert()
    if not _reload_ssl_context_cert():
        log.warning("Regenerated cert on disk but could not hot-reload it — "
                    "restart the dictation-server to serve the new cert")
    return True


def _cert_renew_loop() -> None:
    """Daemon loop: periodically renew the cert in-run. Never raises out."""
    while True:
        time.sleep(CERT_RENEW_CHECK_INTERVAL_SECONDS)
        try:
            _check_and_renew_cert()
        except Exception as e:  # pragma: no cover - defensive
            log.warning(f"In-run cert renewal loop error: {e}")


def _start_cert_renew_thread() -> None:
    """Start the in-run cert renewal daemon thread once. Idempotent."""
    global _cert_renew_thread
    if _cert_renew_thread is not None and _cert_renew_thread.is_alive():
        return
    t = threading.Thread(
        target=_cert_renew_loop,
        name="cert-inrun-renewal",
        daemon=True,
    )
    t.start()
    _cert_renew_thread = t


