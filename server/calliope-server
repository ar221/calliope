# ─── MVP-24: Tailscale cert subcommand ────────────────────
# Per ADR-7 Tier 3 / Agent 5 §2. Power-user path: tailscale issues a real
# Let's Encrypt cert via MagicDNS, phone reaches us at https://<host>.<tail>.ts.net
# without warning. We do NOT auto-renew here — Tailscale's own cert renewal
# story is separate; user re-runs `dictation-server --tailscale-cert` once
# every ~80 days, or pairs with a systemd timer (documented elsewhere).

def _tailscale_self_dns() -> str | None:
    """Return this node's MagicDNS name, e.g. 'foo.tail-xxxx.ts.net' (no trailing dot)."""
    if not shutil.which("tailscale"):
        return None
    try:
        res = subprocess.run(
            ["tailscale", "status", "--json"],
            capture_output=True, text=True, timeout=5, check=False,
        )
    except Exception as e:
        log.debug(f"tailscale status failed: {e}")
        return None
    if res.returncode != 0:
        return None
    try:
        data = json.loads(res.stdout)
    except Exception:
        return None
    self_block = data.get("Self") or {}
    dns = (self_block.get("DNSName") or "").strip()
    if not dns:
        return None
    # Strip MagicDNS trailing dot.
    return dns.rstrip(".")


def _validate_cert_pair_for_hostname(cert: Path, key: Path, hostname: str) -> tuple[bool, str]:
    """Validate certificate syntax, hostname identity, and cert/key pairing."""
    try:
        host_check = subprocess.run(
            ["openssl", "x509", "-checkhost", hostname, "-noout", "-in", str(cert)],
            capture_output=True, text=True, timeout=5, check=False,
        )
        if host_check.returncode != 0:
            detail = (host_check.stderr or host_check.stdout or "hostname mismatch").strip()
            return False, detail

        cert_pub = subprocess.run(
            ["openssl", "x509", "-pubkey", "-noout", "-in", str(cert)],
            capture_output=True, timeout=5, check=True,
        ).stdout
        key_pub = subprocess.run(
            ["openssl", "pkey", "-pubout", "-in", str(key)],
            capture_output=True, timeout=5, check=True,
        ).stdout
        if cert_pub.strip() != key_pub.strip():
            return False, "certificate and private key do not match"
    except Exception as exc:
        return False, str(exc)
    return True, ""


def _install_cert_pair_with_rollback(tmp_crt: Path, tmp_key: Path, *,
                                     backup_tag: str = "pre-tailscale") -> None:
    """Replace the live cert pair, restoring the prior pair on partial failure."""
    destinations = ((tmp_crt, CERT_FILE), (tmp_key, KEY_FILE))
    backups: dict[Path, Path | None] = {}
    for _src, dst in destinations:
        if dst.exists():
            bak = dst.with_suffix(dst.suffix + f".{backup_tag}.bak")
            shutil.copy2(dst, bak)
            backups[dst] = bak
        else:
            backups[dst] = None

    installed: list[Path] = []
    try:
        for src, dst in destinations:
            os.replace(str(src), str(dst))
            installed.append(dst)
    except Exception:
        for dst in reversed(installed):
            bak = backups[dst]
            try:
                if bak is None:
                    dst.unlink(missing_ok=True)
                else:
                    shutil.copy2(bak, dst)
            except Exception as rollback_error:
                log.error(f"failed to roll back {dst}: {rollback_error}")
        raise


def run_tailscale_cert(args) -> int:
    """Issue a Tailscale-managed Let's Encrypt cert for this node.

    Steps:
      1. Verify `tailscale` on PATH + node logged in.
      2. Resolve MagicDNS name from `tailscale status --json`.
      3. `tailscale cert --cert-file/--key-file` straight into DATA_DIR (no
         /tmp cross-device move; no root-owned temp files). sudo only as a
         fallback if the daemon demands elevation, with ownership reclaimed.
      4. Validate, back up the old pair, then os.replace atomically.
      5. Restart dictation-server so it picks up the new cert.
    """
    print("=" * 64)
    print("  Calliope dictation-server — issue Tailscale (Let's Encrypt) cert")
    print("=" * 64)

    if not shutil.which("tailscale"):
        print("! tailscale not found on PATH.")
        print("  Install:  https://tailscale.com/download")
        print("  Then:     sudo tailscale up")
        return 2

    hostname = _tailscale_self_dns()
    if not hostname:
        print("! Could not resolve this node's MagicDNS name.")
        print("  Is tailscaled running? Are you logged in?  `tailscale status`")
        return 2

    print(f"  Tailnet hostname:  {hostname}")
    print("  Will run:          tailscale cert (into the Calliope data dir)")
    if not _wizard_confirm("  Proceed?", default_yes=True):
        print("  Aborted.")
        return 0

    DATA_DIR.mkdir(parents=True, exist_ok=True)
    # Write directly into DATA_DIR (same filesystem as the final cert/key) via
    # --cert-file/--key-file. This avoids the old /tmp -> ~/.local cross-device
    # rename crash, and files are owned by the invoking user (no root-owned temp
    # files from a `sudo tailscale cert` we then cannot read). Unique suffix so
    # a concurrent/aborted run never collides.
    suffix = f".tsnew.{os.getpid()}.{int(time.time())}"
    tmp_crt = CERT_FILE.with_suffix(CERT_FILE.suffix + suffix)
    tmp_key = KEY_FILE.with_suffix(KEY_FILE.suffix + suffix)

    def _cleanup_tmp() -> None:
        for p in (tmp_crt, tmp_key):
            try:
                p.unlink(missing_ok=True)
            except Exception:
                pass

    try:
        cmd = ["tailscale", "cert",
               "--cert-file", str(tmp_crt), "--key-file", str(tmp_key), hostname]
        try:
            res = subprocess.run(cmd, check=False, text=True, capture_output=True)
        except FileNotFoundError:
            print("! tailscale not on PATH.")
            return 2
        if res.returncode != 0:
            # tailscale cert usually does NOT need root; only fall back to sudo
            # if the daemon rejected us for privileges, and chown the results
            # back so we can read the key.
            stderr = (res.stderr or "").strip()
            needs_priv = "access denied" in stderr.lower() or "permission" in stderr.lower()
            if needs_priv and shutil.which("sudo"):
                print("  tailscale cert needs elevation — retrying with sudo…")
                sudo_cmd = ["sudo", "tailscale", "cert",
                            "--cert-file", str(tmp_crt), "--key-file", str(tmp_key), hostname]
                res = subprocess.run(sudo_cmd, check=False, text=True, capture_output=True)
                if res.returncode == 0:
                    # Reclaim ownership so the non-root service can read the key.
                    try:
                        subprocess.run(
                            ["sudo", "chown", f"{os.getuid()}:{os.getgid()}",
                             str(tmp_crt), str(tmp_key)],
                            check=False, capture_output=True, text=True,
                        )
                    except Exception as e:
                        log.warning(f"chown of tailscale cert failed: {e}")
            if res.returncode != 0:
                print("! tailscale cert failed.")
                if stderr:
                    print(f"    {stderr}")
                print("  Common causes:")
                print("    - HTTPS certs disabled in tailnet ACL/admin console")
                print("    - DNS not propagated (give it 60s + retry)")
                _cleanup_tmp()
                return 2

        if not (tmp_crt.exists() and tmp_key.exists()):
            print(f"! Expected {tmp_crt.name} + {tmp_key.name} — not found.")
            _cleanup_tmp()
            return 2

        # Validate syntax, SAN/CN hostname identity, and the key pairing before
        # replacing either live file.
        valid, validation_error = _validate_cert_pair_for_hostname(tmp_crt, tmp_key, hostname)
        if not valid:
            print(f"! new cert failed validation: {validation_error}")
            _cleanup_tmp()
            return 2

        # Each replace is atomic; the helper restores the old pair if the second
        # replace fails so the live certificate and key cannot become mismatched.
        try:
            _install_cert_pair_with_rollback(tmp_crt, tmp_key)
        except Exception as e:
            print(f"! could not install new certificate pair; prior pair restored: {e}")
            return 2
        try:
            os.chmod(CERT_FILE, 0o644)
            os.chmod(KEY_FILE, 0o600)
        except OSError as e:
            print(f"! could not enforce file modes: {e}")

        # Refresh the persisted fingerprint to match the new cert.
        fp = _persist_cert_fingerprint() or ""

        print("  ✓ Got Let's Encrypt cert from Tailscale.")
        print(f"    Server reachable at https://{hostname}:{DEFAULT_PORT}")
        print("    from any tailnet device, no cert warnings.")
        if fp:
            print(f"    Fingerprint (SHA-256): {fp}")

        # Restart so the running server picks up the new cert (no hot-reload).
        if shutil.which("systemctl"):
            if _wizard_confirm("  Restart dictation-server now?", default_yes=True):
                try:
                    subprocess.run(
                        ["systemctl", "--user", "restart", "dictation-server"],
                        check=True, capture_output=True, text=True,
                    )
                    print("  ✓ dictation-server restarted")
                except subprocess.CalledProcessError as e:
                    print(f"  ! restart failed: {e.stderr.strip()}")
                    print("    Restart manually: systemctl --user restart dictation-server")
            else:
                print("  Note: server still serving the OLD cert. "
                      "Run `systemctl --user restart dictation-server` when ready.")
        else:
            print("  systemctl not present — restart dictation-server manually.")
    finally:
        _cleanup_tmp()

    return 0


# ─── Main ─────────────────────────────────────────────────
def main():
    parser = argparse.ArgumentParser(description="Remote dictation server")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help=f"Port (default: {DEFAULT_PORT})")
    parser.add_argument("--host", default=DEFAULT_HOST, help=f"Host (default: {DEFAULT_HOST})")
    parser.add_argument("--no-ssl", action="store_true", help="Disable HTTPS (mic won't work on non-localhost)")
    # MVP-19 — first-run wizard flags (mutually exclusive with normal serve).
    parser.add_argument("--setup", action="store_true",
                        help="Run the first-run setup wizard and exit (MVP-19).")
    # MVP-24 — Tailscale-issued Let's Encrypt cert (ADR-7 Tier 3).
    parser.add_argument("--tailscale-cert", action="store_true",
                        help="Issue a Tailscale (Let's Encrypt via MagicDNS) cert for this node and exit (MVP-24).")
    parser.add_argument("--rotate-token", action="store_true",
                        help="Rotate the bearer token and exit; prints the token path, not the secret value.")
    parser.add_argument("--show-token", action="store_true",
                        help="Print the bearer token from the token file to stdout and exit.")
    parser.add_argument("--force", action="store_true",
                        help="Re-run wizard stages even when artifacts exist (rotates cert+token, re-downloads model).")
    parser.add_argument("--install-systemd", dest="install_systemd",
                        action=argparse.BooleanOptionalAction, default=True,
                        help="Wizard stage 4: install + start systemd units (default: yes; --no-install-systemd for dry-run).")
    for n in range(1, 8):
        parser.add_argument(f"--skip-stage-{n}", action="store_true",
                            help=f"Wizard: skip stage {n}.")
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(message)s",
        datefmt="%H:%M:%S",
    )

    # MVP-19 / MVP-24 dispatch: short-circuit before any server bring-up.
    if args.setup:
        return run_setup_wizard(args)
    if args.tailscale_cert:
        return run_tailscale_cert(args)
    if args.show_token:
        if TOKEN_FILE.exists():
            tok = TOKEN_FILE.read_text(encoding="utf-8").strip()
            if tok:
                print(tok)
                return 0
        print(f"No token minted yet (expected at {TOKEN_FILE}). "
              "Start the server or run --setup first.", file=sys.stderr)
        return 1
    if args.rotate_token:
        try:
            regenerate_token(log_new_token=False, require_persist=True)
        except OSError as e:
            print(f"Token rotation failed: {e}", file=sys.stderr)
            return 1
        print("Bearer token rotated.")
        print(f"Token file: {TOKEN_FILE} (mode 0600)")
        print("Token value was not printed; treat the file contents as a password.")
        print(
            "Live rotation sequence: stop dictation-server; rotate the token; "
            "update the ST bridge token setting; restart dictation-server; "
            "hard-refresh SillyTavern; re-pair the phone."
        )
        return 0

    # Verify dependencies
    if not shutil.which(WHISPER_BIN):
        log.error(f"{WHISPER_BIN} not found in PATH")
        raise SystemExit(1)
    if not shutil.which("ffmpeg"):
        log.error("ffmpeg not found — needed for audio format conversion")
        raise SystemExit(1)

    # Available models
    models = sorted(MODEL_DIR.glob("ggml-*.bin"))
    if not models:
        log.error(f"No whisper models found in {MODEL_DIR}")
        raise SystemExit(1)
    model_names = [m.stem.replace("ggml-", "") for m in models]
    log.info(f"Available models: {', '.join(model_names)}")

    # Phase 2: seed modes.yaml and vocab.yaml on first run
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    _ensure_default_modes()
    _ensure_default_vocab()
    initial_modes = load_modes()
    log.info(
        f"Config format: {'YAML' if _HAVE_YAML else 'JSON (PyYAML unavailable)'} | "
        f"modes: {len(initial_modes)} ({', '.join(m.get('id','') for m in initial_modes)}) | "
        f"vocab entries: {len(load_vocab())} | "
        f"formatter: omniroute={OMNIROUTE_PROXY_URL}, authenticated={bool(OMNIROUTE_API_KEY)} | "
        f"omni-rp-chain=[{', '.join(OMNIROUTE_RP_CHAIN)}]"
    )

    # Mint or load the bearer token before binding the socket.
    ensure_token()

    # Phase 2 (ADR-1) — idle-shutdown daemons for whisper-server and Kokoro.
    # Each arms its timer on activity, and at start when its unit is already
    # active (left running by a previous process or started at login), so a
    # running model is always eventually stopped.
    _start_idle_shutdown_thread()
    _start_kokoro_idle_shutdown_thread()

    server = _TLSThreadingHTTPServer((args.host, args.port), DictationHandler)

    if not args.no_ssl:
        ensure_ssl_cert()
        # Print + persist SHA-256 fingerprint so users can verify the cert
        # they're trusting on the phone matches the one this server is
        # serving. ADR-7. Persisted file mode 0644.
        fp = _persist_cert_fingerprint()
        if fp:
            log.info(f"Cert fingerprint (SHA-256): {fp}")
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(str(CERT_FILE), str(KEY_FILE))
        server.ssl_context = ctx
        # Register the live context so the in-run renewal thread can hot-reload
        # a regenerated cert without a restart, then start that thread.
        global _ssl_context
        _ssl_context = ctx
        _start_cert_renew_thread()
        proto = "https"
    else:
        proto = "http"

    # Get local IP for display
    import socket
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        local_ip = s.getsockname()[0]
        s.close()
    except Exception:
        local_ip = "127.0.0.1"

    log.info(f"Dictation server running at {proto}://{local_ip}:{args.port}")
    log.info("Open this URL on your phone to start dictating")
    if not args.no_ssl:
        log.info("First visit: accept the self-signed certificate warning")

    # Loud warning if bound somewhere LAN-reachable.
    if not _is_loopback_address(args.host) and args.host not in ("localhost",):
        log.warning(
            f"⚠ Listening on {args.host}:{args.port} — LAN-reachable. "
            f"Token auth required for non-localhost clients."
        )
    if CORS_ALLOW_WILDCARD:
        log.warning(
            "⚠ DICTATION_CORS_ORIGINS=* — any origin can call the API. "
            "Dev-only; do not use this in shared networks."
        )

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log.info("Shutting down")
        server.shutdown()


if __name__ == "__main__":
    raise SystemExit(main())
