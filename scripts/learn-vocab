# `wordfreq` is unavailable. Sourced from public-domain English word
# frequency lists (Norvig's count_1w, BNC top-1000). This is the FLOOR
# of stoplist coverage; real builds should `pip install wordfreq` for
# the full 5,000-word list.
_FALLBACK_STOPLIST = """
