#!/usr/bin/env python3
"""learn-vocab — POL-2 adaptive lexicon learner for Calliope.

Mines per-character vocabulary from SillyTavern chat history (JSONL files
under data/default-user/chats/<character>/) and merges high-frequency,
out-of-stoplist tokens into Calliope's vocab.yaml. The whisper prompt
biaser (server build_whisper_prompt) already consumes the
`characters: [...]` scope — no server-side change is needed.

Defaults:
  --chats-dir   /mnt/hdd/AI/SillyTavern/data/default-user/chats
  --vocab-yaml  ~/.local/share/dictation-server/vocab.yaml
  --min-freq    3
  --cap         80   (per character; whisper prompt budget is ~200 tokens)

Behaviour:
  - Dry-run by default. --apply writes vocab.yaml atomically.
  - De-dup against existing vocab.yaml (case-insensitive on `correct`).
  - Existing entry scoped to a DIFFERENT character: skip silently unless
    --apply --merge-characters, in which case current character (lowered)
    is appended to its `characters:` list.
  - Casing: keeps the longest-form representative (Kael'thas > kael).

Optional follow-ups (NOT implemented):
  - --cluster-aliases: edit-distance clustering for ERP-slang variants
    ("cumming"/"coming"/"cumin") with canonical pick + aliases population.
    Defer to v2.
  - Nightly systemd timer (learn-vocab-nightly.timer) — out of scope here;
    a wrapper unit in calliope/systemd/ would call this with --apply.

Deps:
  - stdlib only (mandatory)
  - PyYAML (optional; falls back to JSON if absent — vocab.yaml is YAML
    in practice, so PyYAML is strongly recommended for --apply)
  - wordfreq (optional; falls back to inline ~1000-word stoplist with
    a logged warning that vocab quality is degraded)

Exit codes:
  0  success (dry-run or --apply)
  1  --apply failure (vocab.yaml unwritable, parse error, etc.)
  2  argument / discovery error (e.g. character not found)
"""
from __future__ import annotations

import argparse
import collections
import json
import os
import pathlib
import re
import sys
import tempfile
from typing import Iterable

# ─── Optional deps ───────────────────────────────────────────────────

try:
    import yaml  # PyYAML
    _HAS_YAML = True
except ImportError:
    yaml = None  # type: ignore[assignment]
    _HAS_YAML = False

try:
    from wordfreq import top_n_list  # noqa: F401
    _HAS_WORDFREQ = True
except ImportError:
    _HAS_WORDFREQ = False


# ─── Constants ───────────────────────────────────────────────────────

DEFAULT_CHATS_DIR = pathlib.Path(
    "/mnt/hdd/AI/SillyTavern/data/default-user/chats"
)
DEFAULT_VOCAB_YAML = pathlib.Path(
    "~/.local/share/dictation-server/vocab.yaml"
).expanduser()

# Same shape as server build_whisper_prompt token regex (recon line 107).
TOKEN_RE = re.compile(r"[A-Za-z][A-Za-z'\-]+")

