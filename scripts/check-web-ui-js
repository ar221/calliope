#!/usr/bin/env python3
"""Syntax-check every script the phone PWA serves with `node --check`.

Covers each <script> block of WEB_UI and PAIRING_BOOTSTRAP_HTML plus every
inline `on*="..."` handler attribute (checked as a function body). The module
is loaded from its file, so the gate sees exactly the served strings.

Fail-loud: a missing page constant or a page without scripts exits non-zero
instead of silently checking nothing.
"""
from __future__ import annotations

import argparse
import html
import importlib.util
import re
import subprocess
import sys
import tempfile
from pathlib import Path

PAGES = ("WEB_UI", "PAIRING_BOOTSTRAP_HTML")
SCRIPT_RE = re.compile(r"<script>(.*?)</script>", re.S)
HANDLER_RE = re.compile(r'\son[a-z]+="([^"]*)"')


def load_pages(source: Path) -> dict[str, str]:
    spec = importlib.util.spec_from_file_location("_calliope_web_ui_gate", source)
    if spec is None or spec.loader is None:
        raise ValueError(f"GATE FAIL: cannot load {source}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    pages = {}
    for name in PAGES:
        value = getattr(module, name, None)
        if not isinstance(value, str):
            raise ValueError(f"GATE FAIL: {name} not found in {source} — gate is stale, fix it")
        pages[name] = value
    return pages


def extract_units(pages: dict[str, str]) -> list[tuple[str, str]]:
    """Return (label, javascript) units; each is checked as its own program."""
    units: list[tuple[str, str]] = []
    for name, page in pages.items():
        scripts = SCRIPT_RE.findall(page)
        if not scripts:
            raise ValueError(f"GATE FAIL: no <script> body found inside {name}")
        units.extend((f"{name} <script> #{i + 1}", body) for i, body in enumerate(scripts))
        handlers = [html.unescape(h) for h in HANDLER_RE.findall(page)]
        if handlers:
            body = "\n".join(
                f"function __handler{i}(event) {{\n{h}\n}}" for i, h in enumerate(handlers)
            )
            units.append((f"{name} inline handlers ({len(handlers)})", body))
    return units


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Syntax-check JavaScript served by server/calliope_server/web_ui.py."
    )
    parser.add_argument(
        "--source",
        type=Path,
        default=Path("server/calliope_server/web_ui.py"),
        help="module containing the page strings (default: server/calliope_server/web_ui.py)",
    )
    parser.add_argument(
        "--node",
        default="node",
        help="node executable to use for --check (default: node)",
    )
    parser.add_argument(
        "--keep-temp",
        action="store_true",
        help="keep the extracted temporary JS files for inspection",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        units = extract_units(load_pages(args.source))
    except OSError as exc:
        print(f"GATE FAIL: could not read {args.source}: {exc}", file=sys.stderr)
        return 1
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 1

    failed = 0
    tmp_paths: list[Path] = []
    try:
        for label, body in units:
            with tempfile.NamedTemporaryFile(
                "w", encoding="utf-8", suffix=".js", prefix="calliope-webui-", delete=False
            ) as tmp:
                tmp_paths.append(Path(tmp.name))
                tmp.write(body)
            try:
                result = subprocess.run([args.node, "--check", tmp.name], check=False)
            except FileNotFoundError:
                print(f"GATE FAIL: node executable not found: {args.node!r}", file=sys.stderr)
                return 1
            status = "ok" if result.returncode == 0 else "FAIL"
            print(f"{status}: {label} -> {tmp.name}")
            if result.returncode != 0:
                failed += 1
    finally:
        if not args.keep_temp:
            for path in tmp_paths:
                path.unlink(missing_ok=True)
    if failed:
        print(f"GATE FAIL: node --check failed for {failed} served script unit(s)", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
