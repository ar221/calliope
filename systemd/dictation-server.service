[Unit]
Description=Remote dictation server (whisper.cpp over HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/dictation-server
Restart=on-failure
RestartSec=5
Environment=WHISPER_BIN=whisper-cli
Environment=WHISPER_IDLE_SHUTDOWN_DISABLED=1
# SillyTavern data root — chats/groups/"group chats"/characters dirs derive
# from it (DICTATION_CHARACTERS_DIR etc. still override individually). This
# matches the server's built-in default; if you relocate ST, change this AND
# the ReadOnlyPaths= sandbox line below to match.
Environment=DICTATION_ST_DATA_ROOT=/mnt/hdd/AI/SillyTavern/data/default-user
Environment=DICTATION_OMNIROUTE_URL=http://127.0.0.1:20128/v1
Environment=DICTATION_OMNIROUTE_RP_CHAIN=codex/gpt-5.6-sol-high,cc/claude-sonnet-5,claude/claude-opus-4-8
Environment=DICTATION_OMNIROUTE_CLEAN_CHAIN=codex/gpt-5.6-sol-low,claude/claude-sonnet-4-6

# Sandboxing per ADR-14 (Calliope roadmap, Phase 1).
# PrivateDevices=no + explicit DeviceAllow lines: ROCm needs /dev/kfd + /dev/dri/*.
# MemoryDenyWriteExecute=no: whisper.cpp / ROCm rely on JIT codegen.
# IPAddressAllow/Deny intentionally NOT set here — would conflict with the LAN-bind
# opt-in (DICTATION_BIND_HOST=0.0.0.0). v2 ships a dictation-server.service.d/lan.conf
# drop-in for users who want loopback-only enforcement at the kernel level.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# /tmp is already private (PrivateTmp=yes); whisper models are read-only.
ReadWritePaths=%h/.local/share/dictation-server
ReadOnlyPaths=%h/.local/share/whisper /mnt/hdd/AI/SillyTavern/data %h/STWork/personas %h/STWork/rules
PrivateTmp=yes
PrivateDevices=no
DeviceAllow=/dev/kfd rw
DeviceAllow=/dev/dri rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# LogLevelMax filters journal verbosity per-unit. info keeps the access log and
# the per-request `timing` trace (`journalctl --user -u dictation-server | grep
# timing`); debug lines are still dropped. ADR-14's "LogLevel=warning" was
# relaxed because warning hid both.
LogLevelMax=info

[Install]
WantedBy=default.target
